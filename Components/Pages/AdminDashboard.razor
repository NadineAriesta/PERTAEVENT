@using EventSupportApp.Data

@namespace EventSupportApp.Components.Pages



<style>

    .btn-pill-filter {

        border-radius: 20px !important;

        border: 1px solid #cbd5e1 !important;

        background: #ffffff !important;

        color: #475569 !important;

        font-size: 0.78rem !important;

        font-weight: 600 !important;

        padding: 0.35rem 0.85rem !important;

        transition: all 0.2s;

        margin-right: 4px;

        margin-bottom: 4px;

    }

    .btn-pill-filter:hover {

        background: #f1f5f9 !important;

        border-color: #94a3b8 !important;

        color: #0f172a !important;

    }

    .btn-pill-filter.active {

        background: var(--pertamina-blue) !important;

        border-color: var(--pertamina-blue) !important;

        color: #ffffff !important;

        font-weight: 700 !important;

    }

    .timeline-connector-line {

        transition: width 0.4s ease;

    }

    .stepper-step {

        transition: all 0.3s ease;

    }

    .stepper-step:hover .step-num {

        transform: scale(1.1);

        box-shadow: 0 0 8px rgba(0, 92, 169, 0.3);

    }

</style>



<div class="row g-4">

    <!-- Active Events & Assignments Panel -->

    <div class="col-12">

        <div class="premium-card">

            <div class="card-header-accent"></div>

            <div class="p-4">

                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">

                    <div>
                        <h3 class="m-0" style="color: var(--pertamina-blue);">Monitor Alur Penugasan & Approval</h3>
                        <p class="text-muted m-0">Pantau status penugasan, progres persetujuan (sign), dan laporan dokumentasi dari teknisi.</p>
                    </div>

                </div>



                <!-- Integrated Search & Filter Controls -->

                <div class="row g-3 mb-4 bg-light p-3 rounded" style="border: 1px solid #e2e8f0; margin-left: 0; margin-right: 0;">

                    <div class="col-md-5 col-12 ps-0">

                        <div class="input-group">

                            <span class="input-group-text bg-white border-end-0 text-muted">🔍</span>

                            <input type="text" class="form-control border-start-0 py-2 shadow-none" placeholder="Cari nama acara atau lokasi..." @bind-value="AdminSearchText" @bind-value:event="oninput" style="background-color: #fff; font-size: 0.9rem;" />

                        </div>

                    </div>

                    <div class="col-md-7 col-12 d-flex align-items-center justify-content-md-end gap-1 flex-wrap pe-0">

                        <span class="text-muted small fw-bold me-2">Status:</span>

                        <button class="btn btn-sm btn-pill-filter @(AdminStatusFilter == "Semua" ? "active" : "")" @onclick='() => SetAdminFilter("Semua")'>Semua</button>

                        <button class="btn btn-sm btn-pill-filter @(AdminStatusFilter == "Belum Ditugaskan" ? "active" : "") text-danger" @onclick='() => SetAdminFilter("Belum Ditugaskan")'>Belum Ditugaskan</button>

                        <button class="btn btn-sm btn-pill-filter @(AdminStatusFilter == "Ditugaskan" ? "active" : "") text-warning" @onclick='() => SetAdminFilter("Ditugaskan")'>Ditugaskan</button>

                        <button class="btn btn-sm btn-pill-filter @(AdminStatusFilter == "Dikonfirmasi" ? "active" : "") text-success" @onclick='() => SetAdminFilter("Dikonfirmasi")'>Dikonfirmasi</button>

                        <button class="btn btn-sm btn-pill-filter @(AdminStatusFilter == "Dokumen Diunggah" ? "active" : "") text-primary" @onclick='() => SetAdminFilter("Dokumen Diunggah")'>Dokumen Diunggah</button>

                    </div>
                    
                    <div class="col-12 d-flex align-items-center flex-wrap gap-2 mt-2">
                        <span class="text-muted small fw-bold me-2">Tanggal:</span>
                        <button class="btn btn-sm btn-pill-filter @(AdminDateFilter == "Semua" ? "active" : "")" @onclick='() => SetAdminDateFilter("Semua")'>Semua</button>
                        <button class="btn btn-sm btn-pill-filter @(AdminDateFilter == "Minggu ini" ? "active" : "")" @onclick='() => SetAdminDateFilter("Minggu ini")'>Minggu ini</button>
                        <button class="btn btn-sm btn-pill-filter @(AdminDateFilter == "Bulan ini" ? "active" : "")" @onclick='() => SetAdminDateFilter("Bulan ini")'>Bulan ini</button>
                        <div class="ms-2 d-flex align-items-center">
                            <input type="month" class="form-control form-control-sm" style="border-radius: 20px; font-size: 0.8rem; border-color: #cbd5e1; height: 30px; display: inline-block; width: auto;" value="@AdminCustomMonth" @onchange='(e) => AdminCustomMonth = e.Value?.ToString() ?? ""'  />
                        </div>
                    </div>

                </div>



                @if (!FilteredActiveEvents.Any())

                {

                    <div class="text-center py-5 text-muted bg-light rounded" style="border: 2px dashed #cbd5e1; padding: 2rem;">

                        <span class="fs-1 d-block mb-3">🔍</span>

                        <h5 class="fw-bold">Tidak ada acara yang cocok</h5>

                        <p class="small text-muted mb-0">Coba ganti kata kunci pencarian atau filter status untuk menemukan data.</p>

                    </div>

                }

                else

                {

                    <div class="row g-3">

                        @foreach (var eventItem in FilteredActiveEvents)

                        {

                            var assignment = GetAssignmentForEvent(eventItem.IdAcara);

                            

                            <div class="col-12">

                                <div class="event-card status-@GetStatusColorName(eventItem.StatusAcara) p-3">

                                    <div class="row align-items-center g-3">

                                        <!-- Event Info -->

                                        <div class="col-md-3">

                                            <h5 class="mb-1 text-dark" style="font-family: 'Outfit';">@eventItem.NamaAcara</h5>

                                            <div class="small text-muted">

                                                <span>📍</span> @eventItem.LokasiNavigation?.NamaLokasi <br/>

                                                <span>🕒</span> @eventItem.Tanggal.ToString("dd MMM yyyy") | @eventItem.JamMulai.ToString(@"hh\:mm") - @eventItem.JamSelesai.ToString(@"hh\:mm")

                                            </div>

                                        </div>



                                        <!-- Needs List -->

                                        <div class="col-md-3 border-start">

                                            <strong class="small text-secondary d-block mb-1">🛠️ Kebutuhan Support IT:</strong>

                                            <div class="kebutuhan-badge-wrapper">

                                                @foreach (var need in eventItem.Kebutuhan)

                                                {

                                                    <span class="badge text-dark fw-normal" style="background: #f1f5f9; border: 1px solid #e2e8f0; font-size: 0.75rem;">@need.Barang?.NamaBarang @(string.IsNullOrEmpty(need.Keterangan) ? "" : $"({need.Keterangan})") <strong style="color: var(--pertamina-blue); margin-left: 4px;">&times;@need.Jumlah</strong></span>

                                                }

                                            </div>

                                        </div>



                                        <!-- Assignment Details & Sign Tracker -->

                                        <div class="col-md-3 border-start">

                                            <strong class="small text-secondary d-block mb-1">📋 Detail Penugasan & Tanda Tangan:</strong>

                                            @if (assignment == null)

                                            {

                                                <span class="text-danger small fw-bold">❌ Belum ada Teknisi ditugaskan</span>

                                            }

                                            else

                                            {

                                                <div class="small">

                                                    <div><strong>Teknisi:</strong> @assignment.Teknisi?.User?.Username (@assignment.Teknisi?.Spesialisasi)</div>

                                                    <div class="mt-1 d-flex flex-column gap-1">

                                                        <!-- Admin Sign Tracker -->

                                                        <span class="text-success fw-bold">

                                                            ✍️ Disetujui Admin (@(assignment.PenugasTeknisi?.Username ?? "Admin"))

                                                        </span>

                                                        <!-- Technician Sign Tracker -->

                                                        @if (assignment.WaktuKonfirmasi != null)

                                                        {

                                                            <span class="text-success fw-bold">

                                                                🤝 Dikonfirmasi Teknisi: @assignment.WaktuKonfirmasi?.ToString("dd/MM HH:mm")

                                                            </span>

                                                        }

                                                        else

                                                        {

                                                            <span class="text-danger">

                                                                ⏳ Menunggu Sign Teknisi

                                                            </span>

                                                        }

                                                    </div>

                                                    @if (!string.IsNullOrEmpty(assignment.CatatanTeknisi))
                                                    {
                                                        <div class="alert alert-warning p-2 mt-2 mb-0 small" style="border-left: 4px solid #f59e0b; background-color: #fffbeb;">
                                                            <strong>💬 Catatan / Pengaduan:</strong><br/>
                                                            <span class="text-dark">@assignment.CatatanTeknisi</span>
                                                        </div>
                                                    }

                                                </div>

                                            }

                                        </div>



                                        <!-- Action Buttons / Status Timeline -->

                                        <div class="col-md-3 text-md-end border-start">

                                            <div class="mb-2">

                                                <span class="status-badge @GetStatusClass(eventItem.StatusAcara)">

                                                    @GetStatusIndicator(eventItem.StatusAcara) @eventItem.StatusAcara

                                                </span>

                                            </div>



                                            @if (eventItem.StatusAcara == "Belum Ditugaskan")

                                            {

                                                <button class="btn btn-danger btn-sm px-3 rounded-pill fw-bold" @onclick="() => OnOpenAssignModal.InvokeAsync(eventItem)">

                                                    ➕ Tugaskan Teknisi

                                                </button>

                                            }

                                            

                                            else if (eventItem.StatusAcara == "Dokumen Diunggah" && assignment != null)

                                            {

                                                <div class="d-flex flex-column gap-1 align-items-md-end">

                                                    <button class="btn btn-sm btn-outline-info mb-1 rounded-pill" @onclick="() => OnPreviewDocumentation.InvokeAsync(assignment)">

                                                        🔍 Lihat Bukti Foto

                                                    </button>

                                                                                                        <button class="btn btn-success btn-sm px-3 rounded-pill fw-bold" @onclick="() => OnCompleteEvent.InvokeAsync(eventItem)">

                                                        ✅ Tuntaskan Acara

                                                    </button>

                                                </div>

                                            }

                                        </div>

                                    </div>

                                    

                                    <!-- Visual Flowchart Timeline Tracker -->

                                    <div class="mt-3 pt-3 border-top w-100">

                                        <div class="d-flex align-items-center justify-content-between position-relative stepper-wrapper" style="padding: 0 10px;">

                                            <!-- Line background linking nodes -->

                                            <div class="position-absolute start-0 end-0 timeline-connector-line" style="height: 4px; background: #e2e8f0; top: 15px; z-index: 1;">

                                                <div class="timeline-progress-line" style="height: 100%; background: var(--pertamina-blue); transition: width 0.4s; width: @(GetStepperProgressPercent(eventItem.StatusAcara))%;"></div>

                                            </div>

                                            

                                            <!-- Step 1: Input -->

                                            <div class="stepper-step text-center position-relative" style="z-index: 2; width: 80px;">

                                                <div class="step-num rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 32px; height: 32px; font-size: 0.8rem; font-weight: 700; background: var(--pertamina-blue); color: white; border: 2px solid var(--pertamina-blue);">

                                                    ✓

                                                </div>

                                                <span class="d-block mt-1 fw-bold text-dark" style="font-size: 0.68rem; line-height: 1.2;">1. Input Acara</span>

                                            </div>



                                            <!-- Step 2: Penugasan -->

                                            @{

                                                bool step2Active = eventItem.StatusAcara != "Belum Ditugaskan";

                                                string step2Bg = step2Active ? "var(--pertamina-blue)" : "#ffffff";

                                                string step2Color = step2Active ? "white" : "#cbd5e1";

                                                string step2Border = step2Active ? "var(--pertamina-blue)" : "#cbd5e1";

                                                string step2Text = step2Active ? "✓" : "2";

                                                string step2TextColorClass = step2Active ? "text-dark fw-bold" : "text-muted";

                                            }

                                            <div class="stepper-step text-center position-relative" style="z-index: 2; width: 80px;">

                                                <div class="step-num rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 32px; height: 32px; font-size: 0.8rem; font-weight: 700; background: @step2Bg; color: @step2Color; border: 2px solid @step2Border; transition: all 0.3s;">

                                                    @step2Text

                                                </div>

                                                <span class="d-block mt-1 @step2TextColorClass" style="font-size: 0.68rem; line-height: 1.2;">2. Ditugaskan</span>

                                            </div>



                                            <!-- Step 3: Konfirmasi / Sign -->

                                            @{

                                                bool step3Active = eventItem.StatusAcara == "Dikonfirmasi" || eventItem.StatusAcara == "Dokumen Diunggah" || eventItem.StatusAcara == "Selesai";

                                                string step3Bg = step3Active ? "var(--pertamina-blue)" : "#ffffff";

                                                string step3Color = step3Active ? "white" : "#cbd5e1";

                                                string step3Border = step3Active ? "var(--pertamina-blue)" : "#cbd5e1";

                                                string step3Text = step3Active ? "✓" : "3";

                                                string step3TextColorClass = step3Active ? "text-dark fw-bold" : "text-muted";

                                            }

                                            <div class="stepper-step text-center position-relative" style="z-index: 2; width: 80px;">

                                                <div class="step-num rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 32px; height: 32px; font-size: 0.8rem; font-weight: 700; background: @step3Bg; color: @step3Color; border: 2px solid @step3Border; transition: all 0.3s;">

                                                    @step3Text

                                                </div>

                                                <span class="d-block mt-1 @step3TextColorClass" style="font-size: 0.68rem; line-height: 1.2;">3. Sign log</span>

                                            </div>



                                            <!-- Step 4: Dokumentasi / Upload -->

                                            @{

                                                bool step4Active = eventItem.StatusAcara == "Dokumen Diunggah" || eventItem.StatusAcara == "Selesai";

                                                string step4Bg = step4Active ? "var(--pertamina-blue)" : "#ffffff";

                                                string step4Color = step4Active ? "white" : "#cbd5e1";

                                                string step4Border = step4Active ? "var(--pertamina-blue)" : "#cbd5e1";

                                                string step4Text = step4Active ? "✓" : "4";

                                                string step4TextColorClass = step4Active ? "text-dark fw-bold" : "text-muted";

                                            }

                                            <div class="stepper-step text-center position-relative" style="z-index: 2; width: 80px;">

                                                <div class="step-num rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 32px; height: 32px; font-size: 0.8rem; font-weight: 700; background: @step4Bg; color: @step4Color; border: 2px solid @step4Border; transition: all 0.3s;">

                                                    @step4Text

                                                </div>

                                                <span class="d-block mt-1 @step4TextColorClass" style="font-size: 0.68rem; line-height: 1.2;">4. Bukti Setup</span>

                                            </div>



                                            <!-- Step 5: Tuntas (Selesai) -->

                                            @{

                                                bool step5Active = eventItem.StatusAcara == "Selesai";

                                                string step5Bg = step5Active ? "var(--pertamina-blue)" : "#ffffff";

                                                string step5Color = step5Active ? "white" : "#cbd5e1";

                                                string step5Border = step5Active ? "var(--pertamina-blue)" : "#cbd5e1";

                                                string step5Text = step5Active ? "✓" : "5";

                                                string step5TextColorClass = step5Active ? "text-dark fw-bold" : "text-muted";

                                            }

                                            <div class="stepper-step text-center position-relative" style="z-index: 2; width: 80px;">

                                                <div class="step-num rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 32px; height: 32px; font-size: 0.8rem; font-weight: 700; background: @step5Bg; color: @step5Color; border: 2px solid @step5Border; transition: all 0.3s;">

                                                    @step5Text

                                                </div>

                                                <span class="d-block mt-1 @step5TextColorClass" style="font-size: 0.68rem; line-height: 1.2;">5. Selesai</span>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        }

                    </div>

                }

            </div>

        </div>

    </div>



    <!-- Big Database Tables: Manajemen Pengguna & Riwayat -->

    <div class="col-12">

        <div class="premium-card">

            <div class="card-header-accent"></div>

            <div class="p-4">

                <ul class="nav nav-tabs mb-3" id="dbTabs" role="tablist">

                    <li class="nav-item" role="presentation">

                        <button class="nav-link @(ActiveTab == "teknisi" ? "active fw-bold" : "")" @onclick='() => ActiveTab = "teknisi"'>

                            👥 Mapping & Ketersediaan Teknisi (Database Besar)

                        </button>

                    </li>

                    <li class="nav-item" role="presentation">

                        <button class="nav-link @(ActiveTab == "riwayat" ? "active fw-bold" : "")" @onclick='() => ActiveTab = "riwayat"'>

                            📁 Riwayat Acara Selesai (Archive)

                        </button>

                    </li>

                </ul>



                <div class="tab-content">

                    <!-- Manajemen Pengguna Tab -->

                    @if (ActiveTab == "teknisi")

                    {

                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead>

                                    <tr>

                                        <th>Nama Teknisi</th>

                                        <th>Spesialisasi</th>

                                        <th>Status Ketersediaan</th>

                                        <th>Tugas Aktif</th>

                                        <th class="text-center">Aksi</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var tek in Technicians)

                                    {

                                        var activeTaskCount = ActiveEvents.Count(e => e.PenugasanList.Any(p => p.IdTeknisi == tek.IdTeknisi));

                                        <tr>

                                            <td>

                                                <div class="fw-bold text-dark">@tek.User?.Username</div>

                                                <div class="text-muted small">User ID: @tek.IdUser</div>

                                            </td>

                                            <td>

                                                <span class="badge bg-secondary">@tek.Spesialisasi</span>

                                            </td>

                                            <td>

                                                @if (tek.StatusKetersediaan == "Tersedia")

                                                {

                                                    <span class="premium-pill-badge badge-green">Tersedia</span>

                                                }

                                                else if (tek.StatusKetersediaan == "Sibuk")

                                                {

                                                    <span class="premium-pill-badge badge-blue">Sedang Bertugas</span>

                                                }

                                                else

                                                {

                                                    <span class="premium-pill-badge badge-red">Tidak Aktif</span>

                                                }

                                            </td>

                                            <td>

                                                <span class="badge bg-dark">@activeTaskCount Acara</span>

                                            </td>

                                            <td class="text-center">

                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" style="font-size: 0.78rem;" @onclick="() => OnOpenEditTeknisi.InvokeAsync(tek)">⚙️ Edit Profil</button>

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                    }



                    <!-- Riwayat Tab -->

                    @if (ActiveTab == "riwayat")

                    {

                        @if (HistoryEvents.Count == 0)

                        {

                            <div class="text-center py-2 text-muted">

                                Belum ada riwayat acara yang dituntaskan.

                            </div>

                        }

                        else

                        {

                            <div class="table-responsive">

                                <table class="table table-hover align-middle">

                                    <thead>

                                        <tr>

                                            <th>Nama Acara</th>

                                            <th>Teknisi</th>

                                            <th>Tanggal Acara</th>

                                            <th>Waktu Selesai</th>

                                            <th>Bukti Dokumentasi</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var riwayat in HistoryEvents)

                                        {

                                            var assignment = riwayat.PenugasanList?.FirstOrDefault();

                                            <tr>

                                                <td class="fw-bold" style="color: #072C4C;">@riwayat.NamaAcara</td>

                                                <td>

                                                    <span class="badge bg-dark">@(assignment?.Teknisi?.User?.Username ?? "N/A")</span>

                                                </td>

                                                <td>📅 @riwayat.Tanggal.ToString("dd MMM yyyy")</td>

                                                <td>🕒 @(assignment?.WaktuUpload?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</td>

                                                <td>

                                                    @if (!string.IsNullOrEmpty(assignment?.DokumentasiKegiatanFile))

                                                    {

                                                        <img src="@assignment.DokumentasiKegiatanFile" class="img-thumbnail" style="max-height: 60px; cursor: pointer; border: 2px solid var(--pertamina-blue);" @onclick="() => OnPreviewImage.InvokeAsync(assignment.DokumentasiKegiatanFile)" title="Klik untuk memperbesar" />

                                                    }

                                                    else

                                                    {

                                                        <span class="text-muted small">Tidak ada foto</span>

                                                    }

                                                </td>

                                            </tr>

                                        }

                                    </tbody>

                                </table>

                            </div>

                        }

                    }

                </div>

            </div>

        </div>

    </div>

</div>



@code {

    [Parameter]

    public List<SupportAcara> ActiveEvents { get; set; } = new();



    [Parameter]

    public List<MappingTeknisi> Technicians { get; set; } = new();



    [Parameter]

    public List<Penugasan> Assignments { get; set; } = new();



    [Parameter]

    public List<SupportAcara> HistoryEvents { get; set; } = new();



    [Parameter]

    public EventCallback<SupportAcara> OnOpenAssignModal { get; set; }



    [Parameter]

    public EventCallback<Penugasan> OnPreviewDocumentation { get; set; }



    [Parameter]

    public EventCallback<SupportAcara> OnCompleteEvent { get; set; }



    [Parameter]

    public EventCallback<string> OnPreviewImage { get; set; }



    [Parameter]

    public EventCallback<MappingTeknisi> OnOpenEditTeknisi { get; set; }



    private string ActiveTab { get; set; } = "teknisi";



    private string AdminSearchText { get; set; } = string.Empty;
    private string AdminStatusFilter { get; set; } = "Semua";
    private string AdminDateFilter { get; set; } = "Semua";
    private string _adminCustomMonth = "";
    private string AdminCustomMonth
    {
        get => _adminCustomMonth;
        set
        {
            _adminCustomMonth = value;
            if (!string.IsNullOrEmpty(value))
            {
                AdminDateFilter = "Custom";
            }
        }
    }

    private void SetAdminDateFilter(string filter)
    {
        AdminDateFilter = filter;
        if (filter != "Custom") _adminCustomMonth = "";
    }

    private void SetAdminFilter(string filter)
    {
        AdminStatusFilter = filter;
    }



    private int GetStepperProgressPercent(string status)

    {

        return status switch

        {

            "Belum Ditugaskan" => 0,

            "Ditugaskan" => 25,

            "Dikonfirmasi" => 50,

            "Dokumen Diunggah" => 75,

            "Selesai" => 100,

            _ => 0

        };

    }



    private IEnumerable<SupportAcara> FilteredActiveEvents

    {

        get

        {

            var list = ActiveEvents.AsEnumerable();

            

            // Apply search

            if (!string.IsNullOrWhiteSpace(AdminSearchText))

            {

                var txt = AdminSearchText.ToLower().Trim();

                list = list.Where(e => (e.NamaAcara?.ToLower().Contains(txt) ?? false) || 

                                       (e.LokasiNavigation?.NamaLokasi?.ToLower().Contains(txt) ?? false));

            }

            

            // Apply date filter
            if (AdminDateFilter == "Minggu ini")
            {
                var diff = (7 + (DateTime.Today.DayOfWeek - DayOfWeek.Monday)) % 7;
                var startOfWeek = DateTime.Today.AddDays(-1 * diff).Date;
                var endOfWeek = startOfWeek.AddDays(7);
                list = list.Where(e => e.Tanggal.Date >= startOfWeek && e.Tanggal.Date < endOfWeek);
            }
            else if (AdminDateFilter == "Bulan ini")
            {
                list = list.Where(e => e.Tanggal.Month == DateTime.Today.Month && e.Tanggal.Year == DateTime.Today.Year);
            }
            else if (AdminDateFilter == "Custom" && !string.IsNullOrEmpty(AdminCustomMonth))
            {
                if (DateTime.TryParse(AdminCustomMonth + "-01", out DateTime parsed))
                {
                    list = list.Where(e => e.Tanggal.Month == parsed.Month && e.Tanggal.Year == parsed.Year);
                }
            }

            // Apply status filter

            if (AdminStatusFilter != "Semua")

            {

                list = list.Where(e => e.StatusAcara == AdminStatusFilter);

            }

            

            return list;

        }

    }



    private Penugasan? GetAssignmentForEvent(int eventId)

    {

        return Assignments.FirstOrDefault(a => a.IdAcara == eventId);

    }



    private string GetStatusClass(string status)

    {

        return status switch

        {

            "Belum Ditugaskan" => "red",

            "Ditugaskan" => "yellow",

            "Dikonfirmasi" => "green",

            "Dokumen Diunggah" => "blue",

            "Selesai" => "gray",

            _ => "gray"

        };

    }



    private string GetStatusColorName(string status)

    {

        return status switch

        {

            "Belum Ditugaskan" => "red",

            "Ditugaskan" => "yellow",

            "Dikonfirmasi" => "green",

            "Dokumen Diunggah" => "blue",

            "Selesai" => "gray",

            _ => "gray"

        };

    }



    private string GetStatusIndicator(string status)

    {

        return status switch

        {

            "Belum Ditugaskan" => "🔴",

            "Ditugaskan" => "🟡",

            "Dikonfirmasi" => "🟢",

            "Dokumen Diunggah" => "🔵",

            "Selesai" => "⚫",

            _ => "⚪"

        };

    }

