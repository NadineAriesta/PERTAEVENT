@namespace EventSupportApp.Components.Pages

@if (Show)
{
    <div class="ent-login-modal-bg" @onclick="CloseModal">
        <div class="ent-login-box" @onclick:stopPropagation>
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 shadow-none" @onclick="CloseModal" aria-label="Close"></button>

            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="fs-4">🔑</span>
                <h5 class="m-0 fw-bold text-white" style="font-family:'Outfit'">IT Support Portal</h5>
            </div>
            <p class="text-white-50 small mb-4">Masuk untuk mengelola support acara PT Pertamina.</p>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert border-0 p-2 mb-3 text-center" style="background:rgba(220,53,69,0.25);color:#F8D7DA;border-left:4px solid #E31E24!important;font-size:0.85rem;border-radius:8px;">
                    ⚠️ @ErrorMessage
                </div>
            }

            <form @onsubmit.preventDefault @onsubmit="SubmitLogin">
                <div class="mb-3">
                    <label class="form-label text-white-50 small fw-semibold">Username</label>
                    <input type="text" class="form-control premium-input text-dark" value="@Username" @oninput="UpdateUsername" placeholder="Username Anda" style="background:rgba(255,255,255,0.95);border:none;" />
                </div>
                <div class="mb-4">
                    <label class="form-label text-white-50 small fw-semibold">Password</label>
                    <input type="password" class="form-control premium-input text-dark" value="@Password" @oninput="UpdatePassword" placeholder="••••••••" style="background:rgba(255,255,255,0.95);border:none;" />
                </div>
                <button type="submit" class="btn w-100 py-2 fw-bold rounded-3 text-uppercase" style="background:#E21F26;color:#fff;border:none;font-family:'Outfit';transition:all 0.2s;">
                    Masuk Portal
                </button>
            </form>

            <div class="border-top pt-3 mt-4" style="border-color:rgba(255,255,255,0.12)!important;">
                <span class="d-block text-uppercase fw-bold text-white-50 mb-2" style="font-size:0.7rem;letter-spacing:0.05rem;">💡 Demo Login Cepat</span>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill text-white px-3" style="font-size:0.72rem;border-color:rgba(255,255,255,0.2);background:rgba(255,255,255,0.05);" @onclick='() => QuickLogin("admin")'>👑 Admin</button>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill text-white px-3" style="font-size:0.72rem;border-color:rgba(255,255,255,0.2);background:rgba(255,255,255,0.05);" @onclick='() => QuickLogin("helpdesk")'>📋 Helpdesk</button>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill text-white px-3" style="font-size:0.72rem;border-color:rgba(255,255,255,0.2);background:rgba(255,255,255,0.05);" @onclick='() => QuickLogin("pak_joko")'>🔧 Teknisi</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Show { get; set; }

    [Parameter]
    public string ErrorMessage { get; set; } = string.Empty;

    [Parameter]
    public string Username { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> UsernameChanged { get; set; }

    [Parameter]
    public string Password { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> PasswordChanged { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnLogin { get; set; }

    [Parameter]
    public EventCallback<string> OnQuickLogin { get; set; }

    private async Task UpdateUsername(ChangeEventArgs e)
    {
        Username = e.Value?.ToString() ?? string.Empty;
        await UsernameChanged.InvokeAsync(Username);
    }

    private async Task UpdatePassword(ChangeEventArgs e)
    {
        Password = e.Value?.ToString() ?? string.Empty;
        await PasswordChanged.InvokeAsync(Password);
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task SubmitLogin()
    {
        await OnLogin.InvokeAsync();
    }

    private async Task QuickLogin(string role)
    {
        await OnQuickLogin.InvokeAsync(role);
    }
}
