@code {
    [Parameter] public string ActiveMenu { get; set; } = "dashboard";
    [Parameter] public EventCallback<string> OnMenuChange { get; set; }
    [Parameter] public int CurrentTeknisiId { get; set; }
    [Parameter] public List<Penugasan> Assignments { get; set; } = new();
    [Parameter] public List<SupportAcara> ActiveEvents { get; set; } = new();
    [Parameter] public List<MappingTeknisi> Technicians { get; set; } = new();
    [Parameter] public EventCallback<Penugasan> OnOpenSignature { get; set; }
    [Parameter] public EventCallback<Penugasan> OnOpenUpload { get; set; }
    [Parameter] public EventCallback<Penugasan> OnUpdateProgress { get; set; }
    [Parameter] public EventCallback<Penugasan> OnRejectAssignment { get; set; }

    private List<Penugasan> MyAssignments = new();

    protected override async Task OnParametersSetAsync()
    {
        if (CurrentTeknisiId > 0)
        {
            using var context = DbFactory.CreateDbContext();
            var all = await context.Penugasan
                .Include(p => p.Acara).ThenInclude(a => a!.Kebutuhan).ThenInclude(k => k.Barang)
                .Include(p => p.Acara).ThenInclude(a => a!.LokasiNavigation)
                .Include(p => p.Acara).ThenInclude(a => a!.PembuatAcara)
                .Include(p => p.Teknisi).ThenInclude(t => t!.User)
                .ToListAsync();

            MyAssignments = all.ToList();

            CheckedKebutuhan.Clear();
            foreach (var p in MyAssignments)
            {
                var kebutuhan = p.Acara?.Kebutuhan ?? new List<KebutuhanAcara>();
                foreach (var k in kebutuhan)
                {
                    if (k.IsAmbil)
                    {
                        CheckedKebutuhan.Add($"{p.IdPenugasan}_{k.IdKebutuhan}");
                    }
                }
            }
        }
    }

    // Stats
    private int TotalPenugasan => MyAssignments.Count;
    private List<Penugasan> HariIni => MyAssignments.Where(a => a.Acara?.Tanggal.Date == DateTime.Today).ToList();
    private int PenugasanHariIni => MyAssignments.Count(a => a.Acara?.Tanggal.Date == DateTime.Today);
    private int EventAktif => MyAssignments.Count(a => GetStatusPenugasan(a) == "Berlangsung");
    private int MenungguKonfirmasi => MyAssignments.Count(a => GetStatusPenugasan(a) == "Menunggu Konfirmasi");
    private int Selesai => MyAssignments.Count(a => GetStatusPenugasan(a) == "Selesai");

    // Dashboard filter state
    private string DashSearch = "";
    private string DashFilterStatus = "Semua";
    private string DashFilterWaktu = "Semua";

    // Kebutuhan Acara filter
    private string MasterSearch = "";

    // Histori filter
    private string HistoriSearch = "";
    private string HistoriFilterStatus = "Semua";
    private string HistoriFilterWaktu = "Semua";

    private async Task ExportExcel(IEnumerable<Penugasan> data)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Nama Acara,Tanggal,Lokasi,Kebutuhan IT,Status,Catatan Teknisi");
        foreach (var assign in data)
        {
            var needs = assign.Acara?.Kebutuhan != null 
                ? string.Join(" | ", assign.Acara.Kebutuhan.Select(k => k.Barang?.NamaBarang)) 
                : "";
            var isClose = (assign.StatusPenugasan == "Selesai" || assign.StatusPenugasan == "Ditolak");
            var status = isClose ? "Close" : "Open";
            var catatan = assign.CatatanTeknisi?.Replace(",", " ")?.Replace("\n", " ") ?? "";
            var namaAcara = assign.Acara?.NamaAcara?.Replace(",", " ") ?? "";
            var lokasi = assign.Acara?.LokasiNavigation?.NamaLokasi?.Replace(",", " ") ?? "";
            var tanggal = assign.Acara?.Tanggal.ToString("dd MMM yyyy");
            sb.AppendLine($"{namaAcara},{tanggal},{lokasi},{needs},{status},{catatan}");
        }
        var fileContent = sb.ToString();
        var bytes = System.Text.Encoding.UTF8.GetBytes(fileContent);
        var base64 = Convert.ToBase64String(bytes);
        
        await JS.InvokeVoidAsync("eval", "let a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8;base64," + base64 + "'; a.download = 'Histori_Pekerjaan.csv'; document.body.appendChild(a); a.click(); document.body.removeChild(a);");
    }

    private IEnumerable<Penugasan> FilteredDashboard()
    {
        var q = MyAssignments.AsEnumerable();

        if (!string.IsNullOrEmpty(DashSearch))
            q = q.Where(a => a.Acara?.NamaAcara.Contains(DashSearch, StringComparison.OrdinalIgnoreCase) == true
                          || a.Acara?.LokasiNavigation?.NamaLokasi?.Contains(DashSearch, StringComparison.OrdinalIgnoreCase) == true);

        if (DashFilterStatus != "Semua")
            q = q.Where(a => GetStatusPenugasan(a) == DashFilterStatus);

        if (DashFilterWaktu == "Hari Ini")
            q = q.Where(a => a.Acara?.Tanggal.Date == DateTime.Today);
        else if (DashFilterWaktu == "Minggu Ini")
            q = q.Where(a => a.Acara?.Tanggal.Date >= DateTime.Today && a.Acara?.Tanggal.Date <= DateTime.Today.AddDays(7));
        else if (DashFilterWaktu == "Akan Datang")
            q = q.Where(a => a.Acara?.Tanggal.Date > DateTime.Today);

        return q.OrderByDescending(a => a.IdPenugasan);
    }

    private string GetStatusPenugasan(Penugasan p)
    {
        if (p.StatusPenugasan == "Ditolak") return "Ditolak";
        if (p.StatusPenugasan == "Ditugaskan" || string.IsNullOrEmpty(p.StatusPenugasan) || p.StatusPenugasan == "Menunggu Konfirmasi") 
            return "Menunggu Konfirmasi";

        bool isAllReturned = p.Acara?.Kebutuhan != null && p.Acara.Kebutuhan.Any() && p.Acara.Kebutuhan.All(k => k.IsKembali);
        if (p.StatusPenugasan == "Selesai" || CalculateProgress(p) == 100 || isAllReturned) 
            return "Selesai";

        return "Berlangsung";
    }

    private int CalculateProgress(Penugasan p)
    {
        if (p.StatusPenugasan == "Ditolak") return 0;
        if (p.StatusPenugasan == "Ditugaskan" || string.IsNullOrEmpty(p.StatusPenugasan) || p.StatusPenugasan == "Menunggu Konfirmasi") return 0;
        
        var kebutuhan = (p.Acara?.Kebutuhan ?? new List<KebutuhanAcara>()).ToList();

        if (kebutuhan.Count == 0)
        {
            if (p.StatusPenugasan == "Selesai") return 100;
            return 50;
        }

        double stepWeight = 100.0 / (kebutuhan.Count + 1);
        double progress = stepWeight; // base progress for accepting the assignment

        foreach (var k in kebutuhan)
        {
            bool isChecked = CheckedKebutuhan.Contains($"{p.IdPenugasan}_{k.IdKebutuhan}");
            if (isChecked)
            {
                progress += stepWeight * 0.5;
            }
            if (k.IsKembali)
            {
                progress += stepWeight * 0.5;
            }
        }

        int finalProgress = (int)Math.Round(progress);
        if (finalProgress > 99 && kebutuhan.Any(k => !k.IsKembali))
        {
            return 99;
        }
        return finalProgress > 100 ? 100 : finalProgress;
    }

    private async Task TerimaPenugasan(Penugasan p)
    {
        p.StatusPenugasan = "Siap Bertugas";
        p.WaktuKonfirmasi = DateTime.Now;
        p.Progress = CalculateProgress(p);
        using var context = DbFactory.CreateDbContext();
        context.Update(p);
        await context.SaveChangesAsync();
        if (OnUpdateProgress.HasDelegate)
        {
            await OnUpdateProgress.InvokeAsync(p);
        }
        await OnParametersSetAsync();
    }

    // Local state
    private HashSet<int> SavedProgressIds = new();
    private HashSet<string> CheckedKebutuhan = new();

    private async Task ToggleKebutuhan(string key, Penugasan p, KebutuhanAcara keb)
    {
        bool wasAmbil = keb.IsAmbil;
        if (CheckedKebutuhan.Contains(key))
        {
            CheckedKebutuhan.Remove(key);
            keb.IsAmbil = false;
            keb.IsKembali = false;
        }
        else
        {
            CheckedKebutuhan.Add(key);
            keb.IsAmbil = true;
        }

        p.Progress = CalculateProgress(p);
        p.StatusPenugasan = (p.Progress == 100) ? "Selesai" : GetStatusPenugasan(p);
        if (p.Progress == 100 && p.Acara != null)
        {
            p.Acara.StatusAcara = "Selesai";
        }
        StateHasChanged();

        using var ctx = DbFactory.CreateDbContext();
        var barang = await ctx.MasterBarang.FindAsync(keb.IdBarang);
        if (barang != null)
        {
            if (wasAmbil && !keb.IsAmbil)
            {
                barang.SisaBarang += keb.Jumlah;
            }
            else if (!wasAmbil && keb.IsAmbil)
            {
                barang.SisaBarang = Math.Max(0, barang.SisaBarang - keb.Jumlah);
            }
        }

        ctx.Entry(keb).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        ctx.Entry(p).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        if (p.Acara != null)
        {
            ctx.Entry(p.Acara).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        }
        await ctx.SaveChangesAsync();

        if (keb.Barang != null && barang != null)
        {
            keb.Barang.SisaBarang = barang.SisaBarang;
        }
    }

    private async Task TogglePengembalianBarang(KebutuhanAcara keb, Penugasan p)
    {
        bool sebelumnya = keb.IsKembali;
        keb.IsKembali = !keb.IsKembali;

        p.Progress = CalculateProgress(p);
        p.StatusPenugasan = (p.Progress == 100) ? "Selesai" : GetStatusPenugasan(p);
        if (p.Progress == 100 && p.Acara != null)
        {
            p.Acara.StatusAcara = "Selesai";
        }
        StateHasChanged();

        using var ctx = DbFactory.CreateDbContext();
        var barang = await ctx.MasterBarang.FindAsync(keb.IdBarang);
        if (barang != null)
        {
            if (keb.IsKembali && !sebelumnya)
            {
                barang.SisaBarang = Math.Min(barang.Stok, barang.SisaBarang + keb.Jumlah);
            }
            else if (!keb.IsKembali && sebelumnya)
            {
                barang.SisaBarang = Math.Max(0, barang.SisaBarang - keb.Jumlah);
            }
        }

        ctx.Entry(keb).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        ctx.Entry(p).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        if (p.Acara != null)
        {
            ctx.Entry(p.Acara).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        }
        await ctx.SaveChangesAsync();

        if (keb.Barang != null && barang != null)
        {
            keb.Barang.SisaBarang = barang.SisaBarang;
        }
    }

    private async Task UpdatePenugasanAndKebutuhan(Penugasan p, KebutuhanAcara keb)
    {
        int newProgress = CalculateProgress(p);
        p.Progress = newProgress;

        if (newProgress == 100)
        {
            p.StatusPenugasan = "Selesai";
            if (p.Acara != null)
            {
                p.Acara.StatusAcara = "Selesai";
            }
        }
        else
        {
            p.StatusPenugasan = GetStatusPenugasan(p);
        }

        using var context = DbFactory.CreateDbContext();
        context.Update(keb);
        context.Update(p);
        if (p.Acara != null)
        {
            context.Update(p.Acara);
        }
        await context.SaveChangesAsync();
        StateHasChanged();
    }

    private void HideNotification(int idPenugasan)
    {
        SavedProgressIds.Remove(idPenugasan);
        StateHasChanged();
    }

    private async Task SimpanProgress(Penugasan p)
    {
        if (OnUpdateProgress.HasDelegate)
        {
            await OnUpdateProgress.InvokeAsync(p);
        }
        else
        {
            using var context = DbFactory.CreateDbContext();
            var entity = await context.Penugasan.FindAsync(p.IdPenugasan);
            if (entity != null)
            {
                entity.CatatanTeknisi = p.CatatanTeknisi;
                entity.Progress = p.Progress;
                await context.SaveChangesAsync();
            }
        }
        
        SavedProgressIds.Add(p.IdPenugasan);
        _ = Task.Delay(5000).ContinueWith(_ => { SavedProgressIds.Remove(p.IdPenugasan); InvokeAsync(StateHasChanged); });
    }

    private string GetIconForKebutuhan(string jenis)
    {
        if (string.IsNullOrEmpty(jenis)) return "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='3' width='20' height='14' rx='2' ry='2'></rect><line x1='8' y1='21' x2='16' y2='21'></line><line x1='12' y1='17' x2='12' y2='21'></line></svg>";
        
        jenis = jenis.ToLower();
        if (jenis.Contains("sound") || jenis.Contains("mic") || jenis.Contains("audio"))
            return "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='11 5 6 9 2 9 2 15 6 15 11 19 11 5'></polygon><path d='M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07'></path></svg>";
        
        if (jenis.Contains("proyektor") || jenis.Contains("screen") || jenis.Contains("layar"))
