                                        @(string.IsNullOrEmpty(assign.DokumentasiKegiatanFile) ? "Upload Foto (Opsional)" : "Lihat / Edit Foto")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!MyAssignments.Any())
    {
        <div class="tek-card p-4 text-center text-muted">Belum ada penugasan.</div>
