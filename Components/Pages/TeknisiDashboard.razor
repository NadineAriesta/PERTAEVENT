@using EventSupportApp.Data
@namespace EventSupportApp.Components.Pages

<style>
    .status-dot {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .status-dot::before {
        content: '';
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }
    .status-dot.st-red    { color: #b91c1c; }
    .status-dot.st-red::before    { background: #ef4444; }
    .status-dot.st-yellow { color: #b45309; }
    .status-dot.st-yellow::before { background: #f59e0b; }
    .status-dot.st-green  { color: #15803d; }
    .status-dot.st-green::before  { background: #22c55e; }
    .status-dot.st-blue   { color: #1d4ed8; }
    .status-dot.st-blue::before   { background: #3b82f6; }
    .status-dot.st-gray   { color: #64748b; }
    .status-dot.st-gray::before   { background: #94a3b8; }
</style>

@if (ActiveMenu == "dashboard")
{
    <!-- Stats Row -->
    <div class="dash-stats-row mb-4">
        <div class="dash-stat-card">
            <div class="dash-stat-icon bg-gray"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></div>
            <div>
                <div class="dash-stat-value" style="color: #0f172a;">@TotalPenugasan</div>
                <div class="dash-stat-label">Total Penugasan</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-icon bg-gray"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
            <div>
                <div class="dash-stat-value" style="color: #0f172a;">@PenugasanHariIni</div>
                <div class="dash-stat-label">Penugasan Hari Ini</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-icon bg-yellow"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
            <div>
                <div class="dash-stat-value">@MenungguKonfirmasi</div>
                <div class="dash-stat-label">Menunggu Konfirmasi</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-icon bg-blue"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
            <div>
                <div class="dash-stat-value">@SedangBerlangsung</div>
                <div class="dash-stat-label">Sedang Berlangsung</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-icon bg-green"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
            <div>
                <div class="dash-stat-value">@Selesai</div>
                <div class="dash-stat-label">Selesai</div>
            </div>
        </div>
    </div>

    <!-- Jadwal Hari Ini -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <h5 class="fw-bold text-dark mb-4">Jadwal Hari Ini</h5>
        <div class="table-responsive">
            <table class="table align-middle m-0" style="table-layout: fixed; width: 100%;">
                <thead>
                    <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; border-bottom: 2px solid #e2e8f0; background: #f8fafc;">
                        <th class="border-0 py-3 ps-4" style="width: 30%;">NAMA EVENT</th>
                        <th class="border-0 py-3" style="width: 25%;">LOKASI</th>
                        <th class="border-0 py-3" style="width: 25%;">WAKTU</th>
                        <th class="border-0 py-3 pe-4" style="width: 20%;">STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assign in HariIni)
                    {
                        <tr>
                            <td class="fw-bold py-3 ps-4 text-dark">@assign.Acara?.NamaAcara</td>
                            <td class="text-muted py-3">@assign.Acara?.Lokasi</td>
                            <td class="text-muted py-3">@assign.Acara?.JamMulai.ToString(@"hh\:mm") - @assign.Acara?.JamSelesai.ToString(@"hh\:mm")</td>
                            <td class="py-3 pe-4">
                                @if (string.IsNullOrEmpty(assign.DokumentasiKegiatanFile) && assign.WaktuKonfirmasi == null)
                                {
                                    <span class="status-dot st-yellow">Menunggu Konfirmasi</span>
                                }
                                else if (assign.WaktuKonfirmasi != null && string.IsNullOrEmpty(assign.DokumentasiKegiatanFile))
                                {
                                    <span class="status-dot st-blue">Berlangsung</span>
                                }
                                else
                                {
                                    <span class="status-dot st-green">Selesai</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (HariIni.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Tidak ada jadwal hari ini.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (ActiveMenu == "semua_acara")
{
    <div class="d-flex align-items-center gap-2 mb-4">
        <div style="width: 6px; height: 24px; background: var(--pertamina-red); border-radius: 4px;"></div>
        <h4 class="m-0 fw-bold text-dark">Support Acara</h4>
    </div>
    
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="table-responsive">
            <table class="table align-middle m-0" style="table-layout: fixed; width: 100%;">
                <thead>
                    <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; border-bottom: 2px solid #e2e8f0; background: #f8fafc;">
                        <th class="border-0 py-3 ps-4" style="width: 30%;">NAMA EVENT</th>
                        <th class="border-0 py-3" style="width: 15%;">TANGGAL</th>
                        <th class="border-0 py-3" style="width: 20%;">LOKASI</th>
                        <th class="border-0 py-3" style="width: 20%;">STATUS PROGRESS</th>
                        <th class="border-0 py-3 pe-4" style="width: 15%;">AKSI</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assign in MyAssignments)
                    {
                        <tr>
                            <td class="fw-bold py-3 ps-4 text-dark">@assign.Acara?.NamaAcara</td>
                            <td class="text-muted py-3">@assign.Acara?.Tanggal.ToString("dd MMM yyyy")</td>
                            <td class="text-muted py-3">@assign.Acara?.Lokasi</td>
                            <td class="py-3">
                                @if (!string.IsNullOrEmpty(assign.DokumentasiKegiatanFile))
                                {
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-muted mt-1 d-block">100% - Selesai</small>
                                }
                                else if (assign.WaktuKonfirmasi != null && string.IsNullOrEmpty(assign.DokumentasiKegiatanFile))
                                {
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @assign.Progress%" aria-valuenow="@assign.Progress" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-muted mt-1 d-block">@assign.Progress% - Berlangsung</small>
                                }
                                else
                                {
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: 25%" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-muted mt-1 d-block">25% - Persiapan</small>
                                }
                            </td>
                            <td class="py-3 pe-4">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" @onclick="() => OnOpenSignature.InvokeAsync(assign)">Detail</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (ActiveMenu == "master")
{
    <div class="d-flex align-items-center gap-2 mb-4">
        <div style="width: 6px; height: 24px; background: var(--pertamina-red); border-radius: 4px;"></div>
        <h4 class="m-0 fw-bold text-dark">Kebutuhan Acara</h4>
    </div>
    
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="table-responsive">
            <table class="table align-middle m-0">
                <thead>
                    <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; border-bottom: 2px solid #e2e8f0; background: #f8fafc;">
                        <th class="border-0 py-3 ps-4">NAMA EVENT</th>
                        <th class="border-0 py-3">PERALATAN</th>
                        <th class="border-0 py-3">JUMLAH</th>
                        <th class="border-0 py-3 pe-4">CATATAN</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assign in MyAssignments)
                    {
                        @foreach (var keb in assign.Acara?.Kebutuhan ?? new List<KebutuhanAcara>())
                        {
                            <tr>
                                <td class="fw-bold py-3 ps-4 text-dark">@assign.Acara?.NamaAcara</td>
                                <td class="text-dark py-3">@(keb.JenisKebutuhan?.Replace("🔹", "").TrimStart('•', '▪', '●', '*', ' ', '-'))</td>
                                <td class="text-muted py-3">@keb.Jumlah unit</td>
                                <td class="text-muted py-3 pe-4">@(string.IsNullOrEmpty(keb.Keterangan) ? "-" : keb.Keterangan)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (ActiveMenu == "mapping")
{
    <div class="d-flex align-items-center gap-2 mb-4">
        <div style="width: 6px; height: 24px; background: var(--pertamina-red); border-radius: 4px;"></div>
        <h4 class="m-0 fw-bold text-dark">Mapping Teknisi (Read-Only)</h4>
    </div>
    
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="table-responsive">
            <table class="table align-middle m-0">
                <thead>
                    <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; border-bottom: 2px solid #e2e8f0; background: #f8fafc;">
                        <th class="border-0 py-3 ps-4">NAMA TEKNISI</th>
                        <th class="border-0 py-3">SPESIALISASI</th>
                        <th class="border-0 py-3 pe-4">STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tek in Technicians)
                    {
                        <tr>
                            <td class="fw-bold py-3 ps-4 text-dark">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm" style="width: 38px; height: 38px; background: linear-gradient(135deg, #005CA9, #063d6b); font-size: 0.9rem;">
                                        @((tek.User?.Username ?? "T")[0].ToString().ToUpper())
                                    </div>
                                    <span>@tek.User?.Username</span>
                                </div>
                            </td>
                            <td class="text-muted py-3">@tek.Spesialisasi</td>
                            <td class="py-3 pe-4">
                                @if (tek.StatusKetersediaan == "Tersedia")
                                {
                                    <span class="status-dot st-green">Tersedia</span>
                                }
                                else
                                {
                                    <span class="status-dot st-yellow">Sedang Bertugas</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (ActiveMenu == "penugasan")
{
    <div class="d-flex align-items-center gap-2 mb-4">
        <div style="width: 6px; height: 24px; background: var(--pertamina-red); border-radius: 4px;"></div>
        <h4 class="m-0 fw-bold text-dark">Penugasan Teknisi</h4>
    </div>
    
    @foreach (var assign in MyAssignments)
    {
        var isSigned = assign.WaktuKonfirmasi != null;
        var isUploaded = !string.IsNullOrEmpty(assign.DokumentasiKegiatanFile);

        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" style="border-left: 4px solid @(isSigned ? (isUploaded ? "#10b981" : "#3b82f6") : "#f59e0b") !important;">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-1">@assign.Acara?.NamaAcara</h5>
                    <div class="text-muted small">📅 @assign.Acara?.Tanggal.ToString("dd MMM yyyy") | 🕒 @assign.Acara?.JamMulai.ToString(@"hh\:mm") - @assign.Acara?.JamSelesai.ToString(@"hh\:mm") | 📍 @assign.Acara?.Lokasi</div>
                </div>
                <span class="badge @(isSigned ? (isUploaded ? "bg-success" : "bg-primary") : "bg-warning text-dark") px-3 py-2 rounded-pill fw-bold">
                    @if (!isSigned) { <span>Menunggu Konfirmasi</span> }
                    else if (!isUploaded) { <span>Berlangsung</span> }
                    else { <span>Selesai (Verifikasi)</span> }
                </span>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold text-dark mb-2">Daftar Kebutuhan Support:</h6>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var keb in assign.Acara?.Kebutuhan ?? new List<KebutuhanAcara>())
                    {
                        <span class="badge bg-light text-dark border px-3 py-2 fw-normal" style="border-radius: 6px;">@(keb.JenisKebutuhan?.Replace("🔹", "").TrimStart('•', '▪', '●', '*', ' ', '-')) <strong style="color: var(--pertamina-blue); margin-left: 4px;">&times;@keb.Jumlah</strong></span>
                    }
                </div>
            </div>

            <div class="d-flex gap-3">
                @if (!isSigned)
                {
                    <button class="btn btn-warning fw-bold px-4 py-2 rounded-3 text-dark" @onclick="() => OnOpenSignature.InvokeAsync(assign)">
                        ✍️ Terima Penugasan (Sign)
                    </button>
                    <button class="btn btn-outline-danger fw-bold px-4 py-2 rounded-3">
                        Tolak Penugasan
                    </button>
                }
                else if (!isUploaded)
                {
                    <div class="w-100 p-3 bg-light rounded-3 mb-3 border">
                        <label class="form-label fw-bold small text-dark">Update Progress: @assign.Progress%</label>
                        <input type="range" class="form-range mb-3" min="0" max="100" step="5" @bind="assign.Progress" />
                        
                        <label class="form-label fw-bold small text-dark">Catatan Teknisi:</label>
                        <textarea class="form-control mb-3 premium-input" rows="2" @bind="assign.CatatanTeknisi" placeholder="Tambahkan catatan jika ada..."></textarea>
                        
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary fw-bold px-3 py-2 rounded-3" @onclick="() => OnUpdateProgress.InvokeAsync(assign)">
                                💾 Simpan Progress
                            </button>
                            <button class="btn btn-primary fw-bold px-3 py-2 rounded-3" @onclick="() => OnOpenUpload.InvokeAsync(assign)">
                                📷 Upload Dokumentasi & Selesaikan
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success border-0 mb-0 w-100 d-flex align-items-center gap-3">
                        <img src="@assign.DokumentasiKegiatanFile" style="height: 50px; width: 50px; object-fit: cover; border-radius: 8px;" />
                        <div>
                            <div class="fw-bold">Dokumentasi Berhasil Diunggah</div>
                            <div class="small">Menunggu verifikasi dari Admin.</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    @if (MyAssignments.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <span class="fs-1 d-block mb-3">✅</span>
            <h5>Belum ada penugasan baru.</h5>
        </div>
    }
}

@code {
    [Parameter]
    public string ActiveMenu { get; set; } = "dashboard";

    [Parameter]
    public int CurrentTeknisiId { get; set; }

    [Parameter]
    public List<Penugasan> Assignments { get; set; } = new();

    [Parameter]
    public List<SupportAcara> ActiveEvents { get; set; } = new();

    [Parameter]
    public List<RiwayatAcara> HistoryEvents { get; set; } = new();

    [Parameter]
    public List<MappingTeknisi> Technicians { get; set; } = new();

    [Parameter]
    public EventCallback<Penugasan> OnOpenSignature { get; set; }

    [Parameter]
    public EventCallback<Penugasan> OnOpenUpload { get; set; }

    [Parameter]
    public EventCallback<Penugasan> OnUpdateProgress { get; set; }

    private List<Penugasan> MyAssignments => 
        Assignments.Where(a => a.IdTeknisi == CurrentTeknisiId && a.Acara?.StatusAcara != "Selesai").ToList();

    private int TotalPenugasan => Assignments.Count(a => a.IdTeknisi == CurrentTeknisiId);
    
    private int PenugasanHariIni => MyAssignments.Count(a => a.Acara?.Tanggal.Date == DateTime.Today);
    
    private int MenungguKonfirmasi => MyAssignments.Count(a => a.WaktuKonfirmasi == null);
    
    private int SedangBerlangsung => MyAssignments.Count(a => a.WaktuKonfirmasi != null && string.IsNullOrEmpty(a.DokumentasiKegiatanFile));
    
    private int Selesai => Assignments.Count(a => a.IdTeknisi == CurrentTeknisiId && a.Acara?.StatusAcara == "Selesai") 
                            + MyAssignments.Count(a => !string.IsNullOrEmpty(a.DokumentasiKegiatanFile));

    private List<Penugasan> HariIni => MyAssignments.Where(a => a.Acara?.Tanggal.Date == DateTime.Today).ToList();
}
