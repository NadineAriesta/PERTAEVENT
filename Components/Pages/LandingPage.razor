@namespace EventSupportApp.Components.Pages

<div class="ent-portal">

    <!-- ══════════════════════════════════════════
         NAVIGATION BAR
    ══════════════════════════════════════════ -->
    <nav class="ent-nav">
        <div class="ent-nav-inner">
            <!-- Brand -->
            <div class="d-flex align-items-center gap-2" style="margin-left: 1.5rem;">
                <img src="images/pertamina-logo.png" alt="Pertamina Logo" style="height: 68px; width: auto; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));" />
            </div>

            <!-- Links & Actions (Right Aligned) -->
            <div class="d-flex align-items-center gap-4 ms-auto">
                <div class="ent-nav-links d-none d-lg-flex">
                    <button class="ent-nav-link" style="font-size: 1.05rem;" @onclick='() => OnScrollToElement.InvokeAsync("ent-workflow")'>Alur Kerja</button>
                    <button class="ent-nav-link" style="font-size: 1.05rem;" @onclick='() => OnScrollToElement.InvokeAsync("ent-roles")'>Pengguna</button>
                </div>
                
                <div class="ent-quick-wrap d-none d-sm-inline-block">
                    <button class="ent-btn-primary" style="border-radius: 8px; font-size: 1.05rem; padding: 0.6rem 1.5rem;">Login</button>
                    <div class="ent-quick-menu">
                        <button class="ent-quick-item" @onclick='() => OnQuickLogin.InvokeAsync("admin")'>Admin</button>
                        <button class="ent-quick-item" @onclick='() => OnQuickLogin.InvokeAsync("helpdesk")'>Helpdesk</button>
                        <button class="ent-quick-item" @onclick='() => OnQuickLogin.InvokeAsync("pak_joko")'>Teknisi</button>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- ══════════════════════════════════════════
         HERO SECTION
    ══════════════════════════════════════════ -->
    <section class="ent-hero">
        <div class="ent-hero-inner">
            <div style="max-width:800px; outline: none !important; border: none !important; box-shadow: none !important;" class="text-center mx-auto" tabindex="-1">
                <h1 class="ent-hero-title mx-auto text-center" style="outline: none !important; border: none !important;">
                    Manajemen IT Support<br />Acara Korporat
                </h1>
                <p class="ent-hero-desc mx-auto text-center" style="outline: none !important; border: none !important;">
                    Platform terintegrasi untuk koordinasi penugasan teknisi IT, konfirmasi digital,
                    dan dokumentasi kegiatan corporate event Pertamina secara transparan dan real-time.
                </p>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════
         WORKFLOW SECTION (Corp About Style)
    ══════════════════════════════════════════ -->
    <section class="corp-about" id="ent-workflow">
        <div class="container py-3">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-5 mb-lg-0 text-center text-lg-start">
                    <h2 class="corp-about-title">Alur Kerja Sistem</h2>
                    <p class="corp-about-text mb-4">
                        Setiap acara melewati 5 tahap proses yang terstruktur untuk memastikan koordinasi sempurna antara Helpdesk, Admin, dan Teknisi Lapangan secara transparan.
                    </p>
                    <div class="d-flex flex-column gap-3 text-start" style="max-width: 500px; margin: 0 auto 0 0;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-white text-danger fs-6 p-2 rounded-circle" style="width:35px;height:35px;display:flex;align-items:center;justify-content:center;">1</span>
                            <span style="font-size:1.1rem; font-weight:600;">Helpdesk mencatat kebutuhan IT acara</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-white text-danger fs-6 p-2 rounded-circle" style="width:35px;height:35px;display:flex;align-items:center;justify-content:center;">2</span>
                            <span style="font-size:1.1rem; font-weight:600;">Admin menugaskan teknisi lapangan</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-white text-danger fs-6 p-2 rounded-circle" style="width:35px;height:35px;display:flex;align-items:center;justify-content:center;">3</span>
                            <span style="font-size:1.1rem; font-weight:600;">Teknisi melakukan konfirmasi digital</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-white text-danger fs-6 p-2 rounded-circle" style="width:35px;height:35px;display:flex;align-items:center;justify-content:center;">4</span>
                            <span style="font-size:1.1rem; font-weight:600;">Teknisi mengunggah foto dokumentasi</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-white text-danger fs-6 p-2 rounded-circle" style="width:35px;height:35px;display:flex;align-items:center;justify-content:center;">5</span>
                            <span style="font-size:1.1rem; font-weight:600;">Admin memverifikasi dan menuntaskan laporan</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 corp-about-truck-container">
                    <img src="images/fuel_truck.png" alt="Pertamina Workflow" class="corp-about-truck" />
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════
         ROLES SECTION (Corp Highlights Style)
    ══════════════════════════════════════════ -->
    <section class="py-5" style="background:#F5F7FA" id="ent-roles">
        <div class="container py-4">
            <h2 class="mb-5 text-center" style="font-family:'Outfit', sans-serif; font-weight:900; font-size:2.5rem; color:#005CA9; text-transform:uppercase;">Pengguna Sistem</h2>
            <div class="tile-container">
                <div class="tile-col-left">
                    <div class="highlight-card shadow-sm border-0">
                        <div class="highlight-img-container" style="background-image: url('images/engineers_highlight.png'); min-height: 350px;"></div>
                        <div class="highlight-footer-bar" style="cursor:pointer;" @onclick='() => OnQuickLogin.InvokeAsync("admin")'>
                            LOGIN SEBAGAI ADMIN / MANAGER
                        </div>
                    </div>
                </div>
                <div class="tile-col-right">
                    <button class="business-tile-blue shadow-sm border-0 w-100" @onclick='() => OnQuickLogin.InvokeAsync("helpdesk")'>
                        HELPDESK / STAFF IT
                    </button>
                    <button class="business-tile-green shadow-sm border-0 w-100" @onclick='() => OnQuickLogin.InvokeAsync("pak_joko")'>
                        TEKNISI LAPANGAN
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════
         ENTERPRISE FOOTER
    ══════════════════════════════════════════ -->
    <footer class="ent-footer" id="ent-footer">
        <div class="ent-footer-inner">
            <div class="row g-4">
                <div class="col-lg-4 col-md-12 mb-2">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="images/pertamina-logo.png" alt="Pertamina Logo" style="height: 28px; width: auto; object-fit: contain; filter: brightness(0) invert(1);" />
                        <span style="border-left: 1px solid rgba(255,255,255,0.3); height: 18px; margin: 0 4px;"></span>
                        <span class="ent-footer-brand">PertaEvent</span>
                    </div>
                    <p class="ent-footer-desc">Sistem IT Event Support Management untuk mendukung kelancaran kegiatan korporat PT Pertamina (Persero) secara efisien dan transparan.</p>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <h6 class="ent-footer-head">Navigasi</h6>
                    <ul class="ent-footer-list">
                        <li><button @onclick='() => OnScrollToElement.InvokeAsync("ent-workflow")'>Alur Kerja</button></li>
                        <li><button @onclick='() => OnScrollToElement.InvokeAsync("ent-roles")'>Pengguna</button></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4 col-6">
                    <h6 class="ent-footer-head">Demo Akses</h6>
                    <ul class="ent-footer-list">
                        <li><button @onclick='() => OnQuickLogin.InvokeAsync("admin")'>Masuk sebagai Admin</button></li>
                        <li><button @onclick='() => OnQuickLogin.InvokeAsync("helpdesk")'>Masuk sebagai Helpdesk</button></li>
                        <li><button @onclick='() => OnQuickLogin.InvokeAsync("pak_joko")'>Masuk sebagai Teknisi</button></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <h6 class="ent-footer-head">Kontak IT Support</h6>
                    <p class="ent-footer-contact">
                        IT Helpdesk Pertamina<br />
                        Ext. 1500-000<br />
                        itsupport@pertamina.com
                    </p>
                </div>
            </div>
            <hr class="ent-footer-divider" />
            <div class="ent-footer-bottom">
                <span class="ent-footer-copy">© 2026 PT Pertamina (Persero). All rights reserved.</span>
                <span class="ent-footer-sys">PertaEvent v1.0 — IT Event Support System</span>
            </div>
        </div>
    </footer>

</div>

@code {
    [Parameter]
    public EventCallback<string> OnQuickLogin { get; set; }

    [Parameter]
    public EventCallback OnOpenLoginModal { get; set; }

    [Parameter]
    public EventCallback<string> OnScrollToElement { get; set; }
}
