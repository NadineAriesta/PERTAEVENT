                    </div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon bg-green"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
                    <div>
                        <div class="dash-stat-value">@HistoryEvents.Count(h => h.WaktuSelesai.Month == DateTime.Now.Month && h.WaktuSelesai.Year == DateTime.Now.Year)</div>
                        <div class="dash-stat-label">Selesai (Bulan ini)</div>
                    </div>
                </div>
            </div>
            <!-- Table with Integrated Filter Bar -->
            <div class="card border-0 bg-white mb-4" style="border-radius: 16px; border: 1px solid rgba(226, 232, 240, 0.8) !important; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); overflow: hidden;">
                @{
                    var filteredEvents = ActiveEvents.Where(e => {
                        if (!IsDateMatch(e.Tanggal)) return false;
                        var matchFilter = string.IsNullOrEmpty(SearchFilter) || 
                            e.NamaAcara.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                            e.Lokasi.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase);
                        return matchFilter;
                    }).ToList();
                }
                <div class="d-flex flex-wrap justify-content-between align-items-center p-4 gap-3" style="border-bottom: 1px solid #f1f5f9; background: #fafafa;">
