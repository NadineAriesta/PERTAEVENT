                                    <td class="text-muted py-2" style="font-size: 0.9rem;">@ev.Tanggal.ToString("dd MMM yyyy") · @ev.JamMulai.ToString(@"hh\:mm")-@ev.JamSelesai.ToString(@"hh\:mm")</td>
