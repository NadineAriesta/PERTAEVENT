                                        {
                                            @if (!string.IsNullOrEmpty(assignment.DokumentasiKegiatanFile))
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" style="font-size: 0.75rem; border-radius: 16px; padding: 0.25rem 0.75rem;" @onclick="() => HandleOpenUpload(assignment)">Lihat Foto</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" style="font-size: 0.75rem; border-radius: 16px; padding: 0.25rem 0.75rem;" @onclick="() => HandleOpenUpload(assignment)">+ Upload Foto</button>
                                            }
