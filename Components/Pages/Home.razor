                                <th class="border-0 py-3" style="width: 12%;">LOKASI</th>
                                <th class="border-0 py-3" style="width: 16%;">KEBUTUHAN IT</th>
                                <th class="border-0 py-3" style="width: 8%;">STATUS</th>
                                <th class="border-0 py-3" style="width: 13%;">CATATAN TEKNISI</th>
