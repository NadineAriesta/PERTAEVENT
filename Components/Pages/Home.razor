                    <div class="stats-label">Menunggu Sign</div>
                    <div class="stats-value">@ActiveEvents.Count(e => e.StatusAcara == "Ditugaskan")</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="stats-card border-green">
                    <div class="stats-label">Dikonfirmasi (Signed)</div>
