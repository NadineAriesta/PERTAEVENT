                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="stats-card border-blue">
                    <div class="stats-label">Dokumen Terupload</div>
                    <div class="stats-value">@ActiveEvents.Count(e => e.StatusAcara == "Dokumen Diunggah")</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="stats-card border-secondary">
                    <div class="stats-label">Total Aktif</div>
                    <div class="stats-value">@ActiveEvents.Count</div>
