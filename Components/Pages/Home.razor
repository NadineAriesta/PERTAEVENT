@page "/"
@using EventSupportApp.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject IJSRuntime JSRuntime

<PageTitle>PertaEvent - IT Event Support Portal</PageTitle>

@if (!IsLoggedIn)
{
    <LandingPage OnQuickLogin="QuickLogin" OnOpenLoginModal="OpenEmptyLoginModal" OnScrollToElement="ScrollToElement" />
    
    <LoginModal Show="ShowLoginModal" 
                ErrorMessage="@LoginErrorMessage" 
                OnClose="() => ShowLoginModal = false" 
                OnLogin="HandleLogin"
                OnQuickLogin="QuickLogin"
                @bind-Username="InputUsername"
                @bind-Password="InputPassword" />
}
else
{
    <header class="app-header d-flex align-items-center justify-content-between">
        <div class="brand-title">
            <!-- SVG Pertamina Logo -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 80" width="36" height="30" class="me-1">
                <g transform="skewX(-25) translate(15, 2)">
                    <rect x="42" y="10" width="40" height="20" rx="4" fill="#E31E24" />
                    <rect x="42" y="40" width="40" height="20" rx="4" fill="#92C83E" />
                    <rect x="10" y="32" width="20" height="48" rx="4" fill="#005CA9" />
                </g>
            </svg>
            <div class="brand-text">
                <div><span class="text-blue">Perta</span><span class="text-red">Event</span></div>
                <span class="brand-subtitle">IT Support Portal</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="text-end d-none d-md-block">
                <span class="d-block fw-bold text-dark" style="font-family: 'Outfit';">@GetUserDisplayName()</span>
                <span class="badge bg-secondary" style="font-size: 0.7rem; font-weight: 700;">Peran: @CurrentRole</span>
            </div>
            <button class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" @onclick="ResetDatabase" title="Reset semua data ke kondisi awal demo">
                🔄 Reset Demo Data
            </button>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold" @onclick="HandleLogout">
                🚪 Keluar
            </button>
        </div>
    </header>

    <div class="container-fluid py-4" style="max-width: 1400px;">
        
        @if (!string.IsNullOrEmpty(SystemNotification))
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm border-0" role="alert" style="border-left: 5px solid var(--pertamina-green) !important; background-color: var(--pertamina-green-light); color: var(--pertamina-green-hover);">
                <strong>✨ Info Sistem:</strong> @SystemNotification
                <button type="button" class="btn-close" @onclick="ClearNotification"></button>
            </div>
        }

        <!-- Hero Banner -->
        <div class="hero-banner p-4 p-md-5 rounded-4 mb-4 shadow-sm">
            <div class="hero-overlay"></div>
            <div class="position-relative z-index-1">
                <div class="badge bg-danger mb-2 px-3 py-1.5 text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05rem;">PT Pertamina (Persero)</div>
                <h1 class="hero-title">IT Event Support Management Portal</h1>
                <p class="hero-lead mb-4">
                    Sistem monitoring penugasan dan persetujuan IT Support untuk memastikan kelancaran setiap agenda corporate event Pertamina secara profesional, transparan, dan realtime.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <div class="hero-stat-pill">
                        <span class="stat-icon">📅</span>
                        <div>
                            <span class="stat-number">@ActiveEvents.Count</span>
                            <span class="stat-label">Acara Aktif</span>
                        </div>
                    </div>
                    <div class="hero-stat-pill">
                        <span class="stat-icon">👥</span>
                        <div>
                            <span class="stat-number">@Technicians.Count</span>
                            <span class="stat-label">Teknisi Lapangan</span>
                        </div>
                    </div>
                    <div class="hero-stat-pill">
                        <span class="stat-icon">📁</span>
                        <div>
                            <span class="stat-number">@HistoryEvents.Count</span>
                            <span class="stat-label">Selesai (Archive)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (CurrentRole == "Helpdesk")
        {
            <HelpdeskDashboard ActiveEvents="@ActiveEvents"
                               LoggedInUser="@LoggedInUser"
                               OnNotify="@((msg) => SystemNotification = msg)"
                               OnEventSaved="LoadDataAsync" />
        }
        else if (CurrentRole == "Admin")
        {
            <AdminDashboard ActiveEvents="@ActiveEvents"
                            Technicians="@Technicians"
                            Assignments="@Assignments"
                            HistoryEvents="@HistoryEvents"
                            OnOpenAssignModal="OpenAssignModal"
                            OnPreviewDocumentation="PreviewDocumentation"
                            OnCompleteEvent="CompleteEvent"
                            OnPreviewImage="PreviewImage" />
        }
        else if (CurrentRole == "Teknisi")
        {
            <TeknisiDashboard CurrentTeknisiId="@CurrentTeknisiId"
                              Assignments="@Assignments"
                              OnOpenSignature="HandleOpenSignature"
                              OnOpenUpload="HandleOpenUpload" />
        }

    </div>

    <!-- Footer for Dashboard view to make it cohesive with the landing page design -->
    <footer class="ent-footer mt-5">
        <div class="ent-footer-inner">
            <div class="row g-4">
                <div class="col-lg-6 col-md-12 mb-2 text-start">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="images/pertamina-logo.png" alt="Pertamina Logo" style="height: 28px; width: auto; object-fit: contain; filter: brightness(0) invert(1);" />
                        <span style="border-left: 1px solid rgba(255,255,255,0.3); height: 18px; margin: 0 4px;"></span>
                        <span class="ent-footer-brand">PertaEvent</span>
                    </div>
                    <p class="ent-footer-desc" style="max-width: 450px;">Sistem IT Event Support Management untuk mendukung kelancaran kegiatan korporat PT Pertamina (Persero) secara efisien dan transparan.</p>
                </div>
                <div class="col-lg-3 col-md-6 text-start">
                    <h6 class="ent-footer-head">Hubungi IT Support</h6>
                    <p class="ent-footer-contact">
                        IT Helpdesk Pertamina<br />
                        Ext. 1500-000<br />
                        itsupport@pertamina.com
                    </p>
                </div>
                <div class="col-lg-3 col-md-6 text-start">
                    <h6 class="ent-footer-head">Status Sistem</h6>
                    <p class="text-white-50 small">
                        Semua sistem operasional normal.<br/>
                        Database: SQLite (Active)<br/>
                        Mode: Demo Mode Enabled
                    </p>
                </div>
            </div>
            <hr class="ent-footer-divider" />
            <div class="ent-footer-bottom">
                <span class="ent-footer-copy">© 2026 PT Pertamina (Persero). All rights reserved.</span>
                <span class="ent-footer-sys">PertaEvent v1.0 — IT Event Support System</span>
            </div>
        </div>
    </footer>

    <!-- Modals Section -->
    <!-- 1. Admin Assign Technician Modal -->
    @if (ShowAssignModal && SelectedEventForAssign != null)
    {
        <div class="custom-modal-backdrop">
            <div class="custom-modal-content">
                <div class="modal-header bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="modal-title m-0 fw-bold" style="color: var(--pertamina-blue);">Tugaskan Teknisi Ke Acara</h5>
                    <button type="button" class="btn-close" @onclick="CloseAssignModal"></button>
                </div>
                <div class="modal-body p-4">
                    <h6 class="fw-bold mb-2">Detail Acara:</h6>
                    <div class="p-3 bg-light rounded mb-3 small border">
                        <strong>Nama:</strong> @SelectedEventForAssign.NamaAcara <br/>
                        <strong>Lokasi:</strong> @SelectedEventForAssign.Lokasi <br/>
                        <strong>Waktu:</strong> @SelectedEventForAssign.Tanggal.ToString("dd MMM yyyy") (@SelectedEventForAssign.JamMulai.ToString(@"hh\:mm") - @SelectedEventForAssign.JamSelesai.ToString(@"hh\:mm"))
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Pilih Teknisi Lapangan:</label>
                        <select class="form-select premium-input" @bind="SelectedTeknisiIdForAssign">
                            <option value="0">-- Pilih Teknisi --</option>
                            @foreach (var tek in Technicians)
                            {
                                var activeTasks = ActiveEvents.Count(e => e.PenugasanList.Any(p => p.IdTeknisi == tek.IdTeknisi));
                                <option value="@tek.IdTeknisi" disabled="@(tek.StatusKetersediaan != "Tersedia")">
                                    @tek.User?.Username (@tek.Spesialisasi) - @(tek.StatusKetersediaan == "Tersedia" ? "Tersedia" : "Sibuk") [Tugas Aktif: @activeTasks]
                                </option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3 border-top d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseAssignModal">Batal</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="HandleAssignTeknisi" disabled="@(SelectedTeknisiIdForAssign == 0)">
                        💾 Tugaskan Teknisi
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- 2. Technician Signature Modal -->
    @if (ShowSignatureModal && ActiveAssignmentForAction != null)
    {
        <div class="custom-modal-backdrop">
            <div class="custom-modal-content" style="max-width: 550px;">
                <div class="modal-header bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h4 class="modal-title m-0 fw-bold" style="color: var(--pertamina-blue);">Tanda Tangan Konfirmasi</h4>
                    <button type="button" class="btn-close" @onclick="() => ShowSignatureModal = false"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5 text-dark mb-3">
                        Silakan tanda tangan di dalam kotak biru di bawah ini untuk mengonfirmasi penugasan support <strong>@ActiveAssignmentForAction.Acara?.NamaAcara</strong>.
                    </p>

                    <div class="signature-pad-sim mb-3" @onclick="SimulateSignatureDraw">
                        @if (string.IsNullOrEmpty(SignatureDataUrl))
                        {
                            <div class="text-muted fs-5">
                                👉 <strong style="color: var(--pertamina-blue);">KLIK DI SINI UNTUK TANDA TANGAN OTOMATIS</strong> 👈
                                <div class="signature-line"></div>
                            </div>
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
                                <span class="fs-1">✍️</span>
                                <span class="fw-bold text-success fs-4">TANDA TANGAN DIGITAL TERPASANG</span>
                                <small class="text-muted">@SignatureDataUrl</small>
                                <div class="signature-line"></div>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tulis nama lengkap Anda:</label>
                        <input type="text" class="form-control text-center fs-4 fw-bold premium-input" @bind="TechnicianNameInput" placeholder="Contoh: Pak Joko" />
                    </div>
                </div>
                <div class="modal-footer bg-light p-3 border-top d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary btn-lg rounded-3 px-4" @onclick="() => ShowSignatureModal = false">Batal</button>
                    <button type="button" class="btn btn-success btn-lg fw-bold rounded-3 px-4" @onclick="HandleSubmitSignature" disabled="@(string.IsNullOrEmpty(TechnicianNameInput))">
                        🤝 KIRIM TANDA TANGAN
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- 3. Technician Upload Photo Modal -->
    @if (ShowUploadModal && ActiveAssignmentForAction != null)
    {
        <div class="custom-modal-backdrop">
            <div class="custom-modal-content" style="max-width: 550px;">
                <div class="modal-header bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h4 class="modal-title m-0 fw-bold" style="color: var(--pertamina-blue);">Unggah Bukti Foto Setup</h4>
                    <button type="button" class="btn-close" @onclick="() => ShowUploadModal = false"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5 text-dark mb-4">
                        Unggah foto hasil setup hardware (misal: sound system/layar proyektor) untuk acara <strong>@ActiveAssignmentForAction.Acara?.NamaAcara</strong>.
                    </p>

                    <div class="mb-4">
                        <button type="button" class="btn btn-lg btn-outline-primary w-100 py-3 mb-3 fw-bold rounded-3" @onclick="SimulateCameraUpload">
                            📸 SIMULASI AMBIL GAMBAR DARI KAMERA HP
                        </button>
                        
                        <div class="text-muted mb-3">— ATAU PILIH FILE DARI MEMORI HP —</div>
                        
                        <InputFile OnChange="HandleFileSelection" class="form-control form-control-lg premium-input" accept="image/*" />
                    </div>

                    @if (!string.IsNullOrEmpty(PreviewUploadUrl))
                    {
                        <div class="border rounded p-2 mb-3 bg-light">
                            <small class="text-muted d-block mb-1">Pratinjau Foto:</small>
                            <img src="@PreviewUploadUrl" class="img-fluid rounded" style="max-height: 200px;" />
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light p-3 border-top d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary btn-lg rounded-3 px-4" @onclick="() => ShowUploadModal = false">Batal</button>
                    <button type="button" class="btn btn-primary btn-lg fw-bold rounded-3 px-4" @onclick="HandleSubmitUpload" disabled="@(string.IsNullOrEmpty(PreviewUploadUrl))">
                        📤 KIRIM FOTO KE ADMIN
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- 4. Image Preview Modal -->
    @if (ShowPreviewModal)
    {
        <div class="custom-modal-backdrop" @onclick="() => ShowPreviewModal = false">
            <div class="custom-modal-content" style="max-width: 700px; border:none;" @onclick:stopPropagation>
                <div class="modal-header bg-light p-3 d-flex justify-content-between align-items-center">
                    <h5 class="modal-title m-0 fw-bold" style="color: var(--pertamina-blue);">Bukti Foto Dokumentasi</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowPreviewModal = false"></button>
                </div>
                <div class="modal-body p-2 text-center bg-dark">
                    <img src="@PreviewImageUrl" class="img-fluid rounded" style="max-height: 500px;" />
                </div>
            </div>
        </div>
    }
}

@code {
    private async Task ScrollToElement(string elementId)
    {
        await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('{elementId}')?.scrollIntoView({{ behavior: 'smooth' }})");
    }

    // Login & Session State
    private bool IsLoggedIn { get; set; } = false;
    private string InputUsername { get; set; } = string.Empty;
    private string InputPassword { get; set; } = string.Empty;
    private string LoginErrorMessage { get; set; } = string.Empty;
    private User? LoggedInUser { get; set; }
    private bool ShowLoginModal { get; set; } = false;

    private void OpenEmptyLoginModal()
    {
        InputUsername = string.Empty;
        InputPassword = string.Empty;
        LoginErrorMessage = string.Empty;
        ShowLoginModal = true;
    }

    private void PrepareQuickLogin(string username)
    {
        InputUsername = username;
        InputPassword = "123";
        LoginErrorMessage = string.Empty;
        ShowLoginModal = true;
    }

    // Current Role Simulation State
    private string CurrentRole { get; set; } = "Guest";
    private int CurrentTeknisiId { get; set; } = 1; // Pak Joko
    
    // Notification text
    private string SystemNotification { get; set; } = string.Empty;

    // Database Lists
    private List<SupportAcara> ActiveEvents { get; set; } = new();
    private List<MappingTeknisi> Technicians { get; set; } = new();
    private List<Penugasan> Assignments { get; set; } = new();
    private List<RiwayatAcara> HistoryEvents { get; set; } = new();

    // Modal Control & States
    private bool ShowAssignModal { get; set; } = false;
    private SupportAcara? SelectedEventForAssign { get; set; }
    private int SelectedTeknisiIdForAssign { get; set; } = 0;

    private bool ShowSignatureModal { get; set; } = false;
    private Penugasan? ActiveAssignmentForAction { get; set; }
    private string SignatureDataUrl { get; set; } = string.Empty;
    private string TechnicianNameInput { get; set; } = string.Empty;

    private bool ShowUploadModal { get; set; } = false;
    private string PreviewUploadUrl { get; set; } = string.Empty;

    private bool ShowPreviewModal { get; set; } = false;
    private string PreviewImageUrl { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var rawEventsQuery = DbContext.SupportAcara
            .Include(e => e.Kebutuhan)
            .Include(e => e.PenugasanList)
            .Where(e => e.StatusAcara != "Selesai");

        if (IsLoggedIn && CurrentRole == "Helpdesk" && LoggedInUser != null)
        {
            rawEventsQuery = rawEventsQuery.Where(e => e.IdUserHelpdesk == LoggedInUser.IdUser);
        }

        var rawEvents = await rawEventsQuery.ToListAsync();

        ActiveEvents = rawEvents
            .OrderBy(e => e.Tanggal)
            .ThenBy(e => e.JamMulai)
            .ToList();

        Technicians = await DbContext.MappingTeknisi
            .Include(t => t.User)
            .ToListAsync();

        Assignments = await DbContext.Penugasan
            .Include(p => p.Acara)
            .Include(p => p.Teknisi)
            .ThenInclude(t => t!.User)
            .ToListAsync();

        if (IsLoggedIn && CurrentRole == "Helpdesk" && LoggedInUser != null)
        {
            HistoryEvents = await DbContext.RiwayatAcara
                .Where(r => DbContext.SupportAcara.Any(s => s.IdAcara == r.IdAcara && s.IdUserHelpdesk == LoggedInUser.IdUser))
                .OrderByDescending(r => r.WaktuSelesai)
                .ToListAsync();
        }
        else
        {
            HistoryEvents = await DbContext.RiwayatAcara
                .OrderByDescending(r => r.WaktuSelesai)
                .ToListAsync();
        }
    }

    private async Task HandleLogin()
    {
        LoginErrorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(InputUsername) || string.IsNullOrWhiteSpace(InputPassword))
        {
            LoginErrorMessage = "Silakan masukkan username dan password.";
            return;
        }

        var user = await DbContext.Users
            .Include(u => u.UserRoles)
            .ThenInclude(ur => ur.Role)
            .FirstOrDefaultAsync(u => u.Username.ToLower() == InputUsername.ToLower() && u.StatusAktif);

        if (user != null)
        {
            var hasher = new Microsoft.AspNetCore.Identity.PasswordHasher<User>();
            var verificationResult = hasher.VerifyHashedPassword(user, user.Password, InputPassword);
            if (verificationResult == Microsoft.AspNetCore.Identity.PasswordVerificationResult.Failed)
            {
                user = null;
            }
        }

        if (user == null)
        {
            LoginErrorMessage = "Username atau password salah / akun tidak aktif!";
            return;
        }

        var primaryRoleRelation = user.UserRoles.FirstOrDefault();
        if (primaryRoleRelation?.Role == null)
        {
            LoginErrorMessage = "Akun ini tidak memiliki peran (role) yang valid!";
            return;
        }

        LoggedInUser = user;
        CurrentRole = primaryRoleRelation.Role.NamaRole;
        IsLoggedIn = true;

        if (CurrentRole == "Teknisi")
        {
            var mapping = await DbContext.MappingTeknisi.FirstOrDefaultAsync(m => m.IdUser == user.IdUser);
            CurrentTeknisiId = mapping?.IdTeknisi ?? 1;
        }

        SystemNotification = $"Selamat datang kembali, {GetUserDisplayName()}!";
        InputUsername = string.Empty;
        InputPassword = string.Empty;
        ShowLoginModal = false;
        
        // Reset action states
        ShowAssignModal = false;
        ShowSignatureModal = false;
        ShowUploadModal = false;

        await LoadDataAsync();
    }

    private async Task QuickLogin(string username)
    {
        PrepareQuickLogin(username);
        await HandleLogin();
    }

    private void HandleLogout()
    {
        IsLoggedIn = false;
        LoggedInUser = null;
        CurrentRole = "Guest";
        SystemNotification = "Anda telah berhasil keluar dari sistem.";
    }

    private string GetUserDisplayName()
    {
        if (!IsLoggedIn) return "Tamu";
        if (CurrentRole == "Admin") return "Pak Adit (Manager)";
        if (CurrentRole == "Helpdesk") return "Staff Helpdesk IT";
        if (CurrentRole == "Teknisi") return $"Pak {GetTeknisiName(CurrentTeknisiId)} (Teknisi)";
        return LoggedInUser?.Username ?? "Pengguna";
    }

    private string GetTeknisiName(int id)
    {
        return id switch
        {
            1 => "Joko",
            2 => "Budi",
            3 => "Bambang",
            _ => "Teknisi Lapangan"
        };
    }

    // Admin Assign Handlers
    private void OpenAssignModal(SupportAcara eventItem)
    {
        SelectedEventForAssign = eventItem;
        SelectedTeknisiIdForAssign = 0;
        ShowAssignModal = true;
    }

    private void CloseAssignModal()
    {
        ShowAssignModal = false;
        SelectedEventForAssign = null;
    }

    private async Task HandleAssignTeknisi()
    {
        if (SelectedEventForAssign == null || SelectedTeknisiIdForAssign == 0) return;

        try
        {
            var eventItem = await DbContext.SupportAcara.FindAsync(SelectedEventForAssign.IdAcara);
            if (eventItem != null)
            {
                eventItem.StatusAcara = "Ditugaskan"; // status becomes Kuning (assigned, await sign)
                
                var penugasan = new Penugasan
                {
                    IdAcara = eventItem.IdAcara,
                    IdTeknisi = SelectedTeknisiIdForAssign,
                    IdUserAdmin = 1, // Admin Pak Adit
                    StatusPenugasan = "Ditugaskan",
                };
                
                DbContext.Penugasan.Add(penugasan);

                // Update technician availability status to "Sibuk"
                var tek = await DbContext.MappingTeknisi.FindAsync(SelectedTeknisiIdForAssign);
                if (tek != null)
                {
                    tek.StatusKetersediaan = "Sibuk";
                }

                await DbContext.SaveChangesAsync();
                
                SystemNotification = $"Teknisi berhasil ditugaskan. Status acara berubah menjadi 'Ditugaskan/Belum Sign' (Kuning).";
                ShowAssignModal = false;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            SystemNotification = $"Gagal menugaskan teknisi: {ex.Message}";
        }
    }

    // Technician Sign Handlers
    private void HandleOpenSignature(Penugasan assignment)
    {
        ActiveAssignmentForAction = assignment;
        SignatureDataUrl = string.Empty;
        TechnicianNameInput = $"Pak {GetTeknisiName(CurrentTeknisiId)}";
        ShowSignatureModal = true;
    }

    private void SimulateSignatureDraw()
    {
        var time = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        SignatureDataUrl = $"SIGNED-BY-{TechnicianNameInput.ToUpper().Replace(" ", "_")}-AT-{time}";
    }

    private async Task HandleSubmitSignature()
    {
        if (ActiveAssignmentForAction == null) return;

        try
        {
            var penugasan = await DbContext.Penugasan
                .Include(p => p.Acara)
                .FirstOrDefaultAsync(p => p.IdPenugasan == ActiveAssignmentForAction.IdPenugasan);

            if (penugasan != null)
            {
                penugasan.StatusPenugasan = "Dikonfirmasi";
                penugasan.WaktuKonfirmasi = DateTime.Now;

                if (penugasan.Acara != null)
                {
                    penugasan.Acara.StatusAcara = "Dikonfirmasi"; // status becomes Hijau
                }

                await DbContext.SaveChangesAsync();
                SystemNotification = $"Tanda tangan berhasil disimpan! Status penugasan Anda sekarang 'Dikonfirmasi' (Hijau).";
                ShowSignatureModal = false;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            SystemNotification = $"Gagal menyimpan tanda tangan: {ex.Message}";
        }
    }

    // Technician Photo Upload Handlers
    private void HandleOpenUpload(Penugasan assignment)
    {
        ActiveAssignmentForAction = assignment;
        PreviewUploadUrl = string.Empty;
        ShowUploadModal = true;
    }

    private void SimulateCameraUpload()
    {
        PreviewUploadUrl = "https://images.unsplash.com/photo-1505232458627-539c1a83ae75?w=500&auto=format&fit=crop&q=80";
    }

    private async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                // Resize to maximum size for Base64 storage
                var resizedFile = await file.RequestImageFileAsync("image/jpeg", 500, 500);
                using var stream = resizedFile.OpenReadStream(1024 * 1024 * 5); // max 5MB
                var bytes = new byte[resizedFile.Size];
                await stream.ReadAsync(bytes);
                PreviewUploadUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
            }
        }
        catch (Exception ex)
        {
            SystemNotification = $"Gagal membaca file: {ex.Message}";
        }
    }

    private async Task HandleSubmitUpload()
    {
        if (ActiveAssignmentForAction == null || string.IsNullOrEmpty(PreviewUploadUrl)) return;

        try
        {
            var penugasan = await DbContext.Penugasan
                .Include(p => p.Acara)
                .FirstOrDefaultAsync(p => p.IdPenugasan == ActiveAssignmentForAction.IdPenugasan);

            if (penugasan != null)
            {
                penugasan.StatusPenugasan = "Dokumen Diunggah";
                penugasan.DokumentasiKegiatanFile = PreviewUploadUrl;
                penugasan.WaktuUpload = DateTime.Now;

                if (penugasan.Acara != null)
                {
                    penugasan.Acara.StatusAcara = "Dokumen Diunggah"; // status becomes Biru
                }

                await DbContext.SaveChangesAsync();
                SystemNotification = $"Foto bukti setup berhasil diunggah! Status berubah menjadi 'Dokumen Diunggah' (Biru).";
                ShowUploadModal = false;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            SystemNotification = $"Gagal menyimpan foto bukti: {ex.Message}";
        }
    }

    // Admin complete event
    private async Task CompleteEvent(SupportAcara eventItem)
    {
        try
        {
            var fullEvent = await DbContext.SupportAcara
                .Include(e => e.Kebutuhan)
                .Include(e => e.PenugasanList)
                .ThenInclude(p => p.Teknisi)
                .ThenInclude(t => t!.User)
                .FirstOrDefaultAsync(e => e.IdAcara == eventItem.IdAcara);

            if (fullEvent != null)
            {
                var penugasan = fullEvent.PenugasanList.FirstOrDefault();
                var namaTeknisi = penugasan?.Teknisi?.User?.Username ?? "Tidak Ada";

                // Add to Riwayat
                var riwayat = new RiwayatAcara
                {
                    IdAcara = fullEvent.IdAcara,
                    IdPenugasan = penugasan?.IdPenugasan ?? 0,
                    NamaAcara = fullEvent.NamaAcara,
                    NamaTeknisi = namaTeknisi,
                    TanggalAcara = fullEvent.Tanggal,
                    DokumentasiKegiatanFile = penugasan?.DokumentasiKegiatanFile,
                    WaktuSelesai = DateTime.Now
                };
                DbContext.RiwayatAcara.Add(riwayat);

                // Update technician availability back to "Tersedia"
                if (penugasan?.Teknisi != null)
                {
                    penugasan.Teknisi.StatusKetersediaan = "Tersedia";
                }

                // Remove active event (or mark as Selesai, but we filter Selesai out of ActiveEvents)
                fullEvent.StatusAcara = "Selesai";

                await DbContext.SaveChangesAsync();

                SystemNotification = $"Acara '{fullEvent.NamaAcara}' resmi dituntaskan dan dipindahkan ke Riwayat Acara (Abu-abu).";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            SystemNotification = $"Gagal menuntaskan acara: {ex.Message}";
        }
    }

    private void PreviewDocumentation(Penugasan assignment)
    {
        if (assignment != null && !string.IsNullOrEmpty(assignment.DokumentasiKegiatanFile))
        {
            PreviewImageUrl = assignment.DokumentasiKegiatanFile;
            ShowPreviewModal = true;
        }
    }

    private void PreviewImage(string? url)
    {
        if (!string.IsNullOrEmpty(url))
        {
            PreviewImageUrl = url;
            ShowPreviewModal = true;
        }
    }

    private void ClearNotification() => SystemNotification = string.Empty;

    // Reset Demo Database to default seed state
    private async Task ResetDatabase()
    {
        try
        {
            // Clear tables
            DbContext.RiwayatAcara.RemoveRange(DbContext.RiwayatAcara);
            DbContext.Penugasan.RemoveRange(DbContext.Penugasan);
            DbContext.KebutuhanAcara.RemoveRange(DbContext.KebutuhanAcara);
            DbContext.SupportAcara.RemoveRange(DbContext.SupportAcara);
            
            // Reset technicians status
            var technicians = await DbContext.MappingTeknisi.ToListAsync();
            foreach (var t in technicians)
            {
                if (t.IdTeknisi == 3) t.StatusKetersediaan = "Sibuk";
                else t.StatusKetersediaan = "Tersedia";
            }

            // Seed default active events
            DbContext.SupportAcara.AddRange(
                new SupportAcara 
