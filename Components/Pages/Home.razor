    private async Task HandleSubmitEvent()
    {
        try
        {
            if (NewEvent.IdLokasi == 0)
            {
                ShowNotificationWithTimer("Error: Silakan pilih lokasi ruangan terlebih dahulu.");
                return;
            }
            // Parse times
            NewEvent.JamMulai = NewEventStart.ToTimeSpan();
            NewEvent.JamSelesai = NewEventEnd.ToTimeSpan();
            NewEvent.Tanggal = NewEventDate;
            NewEvent.IdPembuatAcara = LoggedInUser?.IdUser ?? 2;
            NewEvent.StatusAcara = "Belum Ditugaskan";

            // Add needs
            foreach (var need in NewNeedsList)
            {
                NewEvent.Kebutuhan.Add(new KebutuhanAcara
                {
                    IdBarang = need.IdBarang,
                    Jumlah = need.Jumlah,
                    Keterangan = need.Keterangan
                });
            }

            DbContext.SupportAcara.Add(NewEvent);
            
            // Insert Audit Log
            DbContext.AuditLogs.Add(new AuditLog
            {
                Waktu = DateTime.Now,
                Username = LoggedInUser?.Username ?? "Sistem",
                Aksi = "Tambah Acara",
                Detail = $"Membuat Acara baru: '{NewEvent.NamaAcara}'"
            });

            await DbContext.SaveChangesAsync();

            ShowNotificationWithTimer($"Acara '{NewEvent.NamaAcara}' berhasil disimpan.");
            
            // Reset form
            NewEvent = new SupportAcara();
            NewEventDate = DateTime.Today;
            NewEventStart = new TimeOnly(8, 0);
            NewEventEnd = new TimeOnly(17, 0);
            NewNeedsList = new List<KebutuhanAcara>();
            if (MasterBarangList != null && MasterBarangList.Any())
            {
                NewNeedsList.Add(new KebutuhanAcara { IdBarang = MasterBarangList.First().IdBarang, Jumlah = 1, Keterangan = "Layar utama" });
            }

            await LoadDataAsync();
            ActiveMenu = "dashboard";
        }
        catch (Exception ex)
        {
            ShowNotificationWithTimer($"Gagal menyimpan acara: {ex.Message}");
        }
    }

