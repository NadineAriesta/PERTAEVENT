    <button class="btn btn-sm @(DateFilter == "Bulan ini" ? "bg-white shadow-sm fw-bold text-dark border-0" : "text-muted border-0") px-3 py-1" style="font-size: 0.8rem;" @onclick='() => SetDateFilter("Bulan ini")'>Bulan Ini</button>
