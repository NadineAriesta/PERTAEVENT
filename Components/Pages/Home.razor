@page "/"
@using EventSupportApp.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject IJSRuntime JSRuntime

<PageTitle>PertaEvent - IT Event Support Portal</PageTitle>

@if (!IsLoggedIn)
{
    <div class="public-portal">
        <!-- 1. Header -->
        <header class="corp-header py-3 bg-white">
            <div class="container-fluid" style="max-width: 1400px;">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 80" width="180" height="50">
                            <!-- Graphic Symbol -->
                            <g transform="skewX(-25) translate(25, 2)">
                                <!-- Red block (top right) -->
                                <rect x="42" y="10" width="40" height="20" rx="4" fill="#E31E24" />
                                <!-- Green block (middle right) -->
                                <rect x="42" y="40" width="40" height="20" rx="4" fill="#92C83E" />
                                <!-- Blue block (left) -->
                                <rect x="10" y="32" width="20" height="48" rx="4" fill="#005CA9" />
                            </g>
                            <!-- Text "PERTAMINA" -->
                            <text x="115" y="52" font-family="'Outfit', 'Inter', sans-serif" font-weight="900" font-size="28" fill="#022F1E" letter-spacing="-0.02rem">PERTAMINA</text>
                        </svg>
                    </div>

                    <!-- Top Navigation & Search -->
                    <div class="d-flex align-items-center gap-4">
                        <nav class="corp-nav-top d-none d-lg-flex align-items-center">
                            <a href="/" class="corp-nav-link active-red">HOME</a>
                            <a style="cursor: pointer;" class="corp-nav-link" @onclick='() => ScrollToElement("about-section")'>TENTANG SISTEM</a>
                            <a style="cursor: pointer;" class="corp-nav-link" @onclick='() => ScrollToElement("help-section")'>BANTUAN</a>
                        </nav>
                        <div class="dropdown" style="position: relative;">
                            <button type="button" class="btn btn-outline-primary rounded-3 px-3 fw-bold d-flex align-items-center gap-1" style="border: 1px solid #cce5ff; color: #005CA9; background: #f0f8ff;" @onclick="ToggleLoginDropdown">
                                Login 
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-top: 2px;"><path d="m6 9 6 6 6-6"/></svg>
                            </button>
                            @if (ShowLoginDropdown)
                            {
                                <!-- Invisible backdrop to close dropdown when clicking outside -->
                                <div style="position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 999;" @onclick="() => ShowLoginDropdown = false"></div>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 show" style="position: absolute; right: 0; top: 100%; min-width: 150px; border-radius: 8px; z-index: 1000;">
                                    <li><a class="dropdown-item py-2" style="cursor: pointer;" @onclick='() => SelectLoginRoleAndOpen("Admin")'>Admin</a></li>
                                    <li><a class="dropdown-item py-2" style="cursor: pointer;" @onclick='() => SelectLoginRoleAndOpen("Helpdesk")'>Helpdesk</a></li>
                                    <li><a class="dropdown-item py-2" style="cursor: pointer;" @onclick='() => SelectLoginRoleAndOpen("Teknisi")'>Teknisi</a></li>
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <section class="corp-hero d-flex align-items-center position-relative">
            <div class="container-fluid corp-hero-content d-flex align-items-center justify-content-center text-center w-100 py-5">
                <div>
                    <h1 class="corp-hero-title text-center" style="font-size: 4rem; line-height: 1.15; text-shadow: 0 4px 20px rgba(0,0,0,0.6);">
                        World Class<br />
                        National Energy<br />
                        Company
                    </h1>
                    <p class="text-white-50 mt-3 fs-5" style="max-width: 700px; margin: 0 auto; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
                        Portal IT Event Support Pertamina - Dukungan Sistem & Infrastruktur Handal untuk Kelancaran Kegiatan Korporat
                    </p>
                </div>
            </div>

            <!-- Bottom Slant Tabs -->
            <div class="hero-slant-bar d-none d-md-flex">
                <a href="#" class="hero-slant-tab"><span>Company Profile</span></a>
                <a href="#" class="hero-slant-tab"><span>Our Business</span></a>
                <a href="#" class="hero-slant-tab"><span>News Room</span></a>
                <a href="#" class="hero-slant-tab"><span>Investor Relations</span></a>
                <a href="#" class="hero-slant-tab"><span>Social Responsibility</span></a>
            </div>
        </section>

        <!-- 3. About Us Section -->
        <section class="corp-about" id="about-section">
            <div class="container-fluid" style="max-width: 1200px;">
                <div class="row align-items-center g-5">
                    <div class="col-md-5 corp-about-truck-container">
                        <img src="/images/fuel_truck.png" alt="Pertamina Fuel Truck" class="corp-about-truck" />
                    </div>
                    <div class="col-md-7 text-start">
                        <h2 class="corp-about-title">About Us</h2>
                        <p class="corp-about-text">
                            As a state-owned company to carry out integrated business care in oil, gas, renewable and new energy based on strong commercial principles both inside and outside the country, Pertamina strives to provide the best and a real contribution to the welfare of the nation in utilizing every potential of Indonesia.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. News Columns Section -->
        <section class="py-5 bg-white">
            <div class="container-fluid" style="max-width: 1200px;">
                <div class="row g-5 text-start">
                    <!-- Left: News Release -->
                    <div class="col-md-6">
                        <div class="corp-news-tab-blue">News Release</div>
                        <div class="corp-news-list">
                            <div class="corp-news-item">
                                <span class="corp-news-date">16 Nov 2017 - 10:00</span>
                                <a href="#" class="corp-news-title-link">Pertamina Mendukung Program Pemerintah Konversi BBM ke BBG Untuk Nelayan Kecil Tahun 2017 di Kabupaten Cilacap</a>
                            </div>
                            <div class="corp-news-item">
                                <span class="corp-news-date">21 Okt 2017 - 15:30</span>
                                <a href="#" class="corp-news-title-link">Pertamina Siap Kelola Mahakam</a>
                            </div>
                            <div class="corp-news-item">
                                <span class="corp-news-date">12 Sep 2017 - 09:00</span>
                                <a href="#" class="corp-news-title-link">PT Pertamina EP Laksanakan Pemboran Offshore Perdana di Laut Jawa</a>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Energy Update -->
                    <div class="col-md-6">
                        <div class="corp-news-tab-red">Energy Update</div>
                        <div class="corp-news-list">
                            <div class="corp-news-item">
                                <span class="corp-news-date">16 Nov 2017 - 16:30</span>
                                <a href="#" class="corp-news-title-link">Dari Arus Balik Lebaran 2017 : Pertamax - Pertalite Pilihan Favorit Pemudik Lebaran 2017</a>
                            </div>
                            <div class="corp-news-item">
                                <span class="corp-news-date">21 Okt 2017 - 10:30</span>
                                <a href="#" class="corp-news-title-link">Komisaris Utama Pertamina Sambangi TBBM Malang</a>
                            </div>
                            <div class="corp-news-item">
                                <span class="corp-news-date">12 Sep 2017 - 16:00</span>
                                <a href="#" class="corp-news-title-link">Direktur Utama Pertamina Tatap Muka dengan PEPC, PEPE, ADK, dan TFPI</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. Highlights and Business Tiles -->
        <section class="py-5" style="background-color: #F8FAFC;" id="features-section">
            <div class="container-fluid" style="max-width: 1200px;">
                <div class="tile-container text-start">
                    <!-- Left Big Highlight -->
                    <div class="tile-col-left">
                        <div class="highlight-card shadow-sm">
                            <div class="highlight-img-container" style="background-image: url('/images/engineers_highlight.png');"></div>
                            <div class="highlight-footer-bar">Highlight</div>
                        </div>
                    </div>
                    <!-- Right Small Tiles -->
                    <div class="tile-col-right">
                        <a href="#" class="business-tile-blue shadow-sm">
                            <span>Our Business</span>
                        </a>
                        <a href="#" class="business-tile-green shadow-sm">
                            <span>Investor Relations</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. Red Footer -->
        <footer class="corp-footer-red text-start" id="help-section">
            <div class="container-fluid" style="max-width: 1200px;">
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="corp-footer-title">Contact Pertamina</div>
                        <div class="corp-footer-phone">1500-000</div>
                        <div class="mt-3">
                            <a href="#" class="corp-footer-social-btn">f</a>
                            <a href="#" class="corp-footer-social-btn">t</a>
                            <a href="#" class="corp-footer-social-btn">y</a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-2 col-lg-2">
                        <div class="corp-footer-title">Our Website</div>
                        <ul class="corp-footer-list">
                            <li><a href="#">Term & Condition</a></li>
                            <li><a href="#">Privacy Policy</a></li>
                            <li><a href="#">Scam Alert</a></li>
                            <li><a href="#">Social Media</a></li>
                        </ul>
                    </div>
                    <div class="col-sm-6 col-md-2 col-lg-2">
                        <div class="corp-footer-title">Tools</div>
                        <ul class="corp-footer-list">
                            <li><a href="#">Webmail</a></li>
                            <li><a href="#">i-Plan</a></li>
                            <li><a href="#">Gas Station Registration</a></li>
                            <li><a href="#">Pertamina Clean</a></li>
                            <li><a href="#">HSSE Database</a></li>
                        </ul>
                    </div>
                    <div class="col-sm-6 col-md-2 col-lg-2">
                        <div class="corp-footer-title">Announcement</div>
                        <ul class="corp-footer-list">
                            <li><a href="#">Pertamina Info</a></li>
                            <li><a href="#">Procurement</a></li>
                            <li><a href="#">Announcement</a></li>
                            <li><a href="#">E-Procurement</a></li>
                        </ul>
                    </div>
                    <div class="col-sm-6 col-md-2 col-lg-2">
                        <div class="corp-footer-title">Network</div>
                        <ul class="corp-footer-list">
                            <li><a href="#">Subsidiaries</a></li>
                            <li><a href="#">Joint Operation</a></li>
                            <li><a href="#">Office Address</a></li>
                            <li><a href="#">Product Distribution</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>

        <!-- 7. Copyright Bottom Bar -->
        <div class="corp-bottom-bar">
            <div class="container">
                Copyright &copy; 2026 PT Pertamina. All rights reserved.
            </div>
        </div>

        <!-- Glassmorphic Login Modal -->
        @if (ShowLoginModal)
        {
            <div class="modal fade show d-block animate-fade-in" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.7); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); z-index: 9999;">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                    <div class="modal-content border-0 position-relative" style="background: rgba(15, 23, 42, 0.45); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px); border: 1px solid rgba(255, 255, 255, 0.12) !important; border-radius: 20px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);">
                        
                        <!-- Close Button -->
                        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 shadow-none" style="z-index: 10;" @onclick="() => ShowLoginModal = false" aria-label="Close"></button>

                        <div class="p-4 text-start">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="fs-4">🔑</span>
                                <h4 class="m-0 fw-bold text-white" style="font-family: 'Outfit';">Login @SelectedLoginRole</h4>
                            </div>
                                <p class="text-white-50 small mb-4">Silakan masukkan username dan password Anda.</p>

                                @if (!string.IsNullOrEmpty(LoginErrorMessage))
                                {
                                    <div class="alert alert-danger border-0 p-2 mb-3 text-center" style="background-color: rgba(220, 53, 69, 0.25); color: #F8D7DA; border-left: 4px solid #E31E24 !important; font-size: 0.85rem;">
                                        ⚠️ @LoginErrorMessage
                                    </div>
                                }

                                <form @onsubmit="HandleLogin">
                                    <div class="mb-3">
                                        <label class="form-label text-white-50">Username</label>
                                        <input type="text" class="form-control premium-input text-white" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);" @bind="InputUsername" placeholder="Username Anda" />
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label text-white-50">Password</label>
                                        <input type="password" class="form-control premium-input text-white" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);" @bind="InputPassword" placeholder="••••••••" />
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 py-2.5 fw-bold rounded-3 shadow text-uppercase" style="background: #E31E24; border: none; transition: all 0.2s;">
                                        MASUK SEBAGAI @SelectedLoginRole.ToUpper()
                                    </button>
                                </form>
                                
                                <div class="text-center mt-3">
                                    <button type="button" class="btn btn-link text-white-50 p-0 text-decoration-none" style="font-size: 0.8rem;" @onclick='() => PrepareQuickLogin(InputUsername)'>
                                        (Demo: Auto-fill Password)
                                    </button>
                                </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- ========== DASHBOARD SHELL ========== -->
    <div class="dash-shell">

    <!-- Sidebar -->
    <aside class="dash-sidebar" style="background: #09203F;">
        <div class="dash-sidebar-brand d-flex align-items-center gap-3" style="padding: 1.5rem 1.25rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 1rem;">
            <div style="background: #E31E24; color: white; font-weight: 800; font-size: 0.95rem; width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(227,30,36,0.5);">
                ES
            </div>
            <div style="line-height: 1.2;">
                <div style="color: white; font-weight: 700; font-family: 'Outfit'; font-size: 0.95rem;">Event Support</div>
                <div style="color: rgba(255,255,255,0.55); font-size: 0.7rem; margin-top: 2px;">Pertamina - Internal</div>
            </div>
        </div>

        <div class="dash-sidebar-section">
            <div class="dash-sidebar-label" style="margin-bottom: 0.5rem; letter-spacing: 0.15rem; color: rgba(255,255,255,0.4);">MENU</div>
            <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "dashboard" ? "menu-active" : "")" @onclick='() => ActiveMenu = "dashboard"'><span class="dash-sidebar-menu-icon">📊</span> Dashboard</button>
            <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "semua_acara" ? "menu-active" : "")" @onclick='() => ActiveMenu = "semua_acara"'><span class="dash-sidebar-menu-icon">📁</span> Support Acara</button>
            <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "master" ? "menu-active" : "")" @onclick='() => ActiveMenu = "master"'><span class="dash-sidebar-menu-icon">📋</span> Kebutuhan Acara</button>
            <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "mapping" ? "menu-active" : "")" @onclick='() => ActiveMenu = "mapping"'><span class="dash-sidebar-menu-icon">👥</span> Mapping Teknisi</button>
            <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "penugasan" ? "menu-active" : "")" @onclick='() => ActiveMenu = "penugasan"'><span class="dash-sidebar-menu-icon">📝</span> Penugasan Teknisi</button>
        </div>

        <div class="dash-sidebar-section" style="margin-top:auto; padding-top:1rem; border-top:1px solid rgba(255,255,255,0.08);">
            <div class="d-flex align-items-center gap-2 mb-3 px-2">
                <div style="width: 32px; height: 32px; background: #005CA9; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                    @(GetUserDisplayName().Substring(0, 1))
                </div>
                <div style="line-height: 1.2;">
                    <div style="color: white; font-weight: 500; font-size: 0.85rem; font-family: 'Outfit';">@GetUserDisplayName()</div>
                    <div style="color: rgba(255,255,255,0.5); font-size: 0.7rem;">@CurrentRole</div>
                </div>
            </div>
            <button type="button" class="dash-sidebar-menu-btn text-danger" @onclick="HandleLogout"><span class="dash-sidebar-menu-icon">🚪</span> Logout</button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="dash-main">

    @if (!string.IsNullOrEmpty(SystemNotification))
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 shadow-sm border-0" role="alert" style="border-left: 5px solid var(--pertamina-green) !important; background-color: var(--pertamina-green-light); color: var(--pertamina-green-hover); font-size: 0.88rem;">
            <strong>✨ Info:</strong> @SystemNotification
            <button type="button" class="btn-close" @onclick="ClearNotification"></button>
        </div>
    }

    <!-- Breadcrumb + Page Header -->
    <div class="dash-breadcrumb">Home / Internal Apps / <span>Event Support</span></div>
    <div class="dash-page-header">
        <div>
            <h1 class="dash-page-title">Dashboard @CurrentRole</h1>
            <p class="dash-page-subtitle">
                @if (CurrentRole == "Admin") { <span>Pantau seluruh acara, status penugasan teknisi, dan konfirmasi secara real-time.</span> }
                else if (CurrentRole == "Helpdesk") { <span>Input acara baru dan pantau status kebutuhan IT support.</span> }
                else if (CurrentRole == "Teknisi") { <span>Konfirmasi tugas lapangan via tanda tangan digital dan upload bukti setup.</span> }
            </p>
        </div>
        <div class="dash-user-pill">
            <div>
                <div class="dash-user-pill-name">@GetUserDisplayName()</div>
                <div class="dash-user-pill-role">@CurrentRole</div>
            </div>
            <div class="dash-user-pill-avatar">@(GetUserDisplayName().Substring(0, 1))</div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="dash-stats-row">
        <div class="dash-stat-card">
            <div class="dash-stat-icon bg-red">🚩</div>
            <div>
                <div class="dash-stat-value">@ActiveEvents.Count(e => e.StatusAcara == "Belum Ditugaskan")</div>
                <div class="dash-stat-label">Belum ada teknisi</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-icon bg-yellow">🤝</div>
            <div>
                <div class="dash-stat-value">@ActiveEvents.Count(e => e.StatusAcara == "Ditugaskan")</div>
                <div class="dash-stat-label">Menunggu konfirmasi</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-icon bg-green">✅</div>
            <div>
                <div class="dash-stat-value">@ActiveEvents.Count(e => e.StatusAcara == "Dikonfirmasi" || e.StatusAcara == "Dokumen Diunggah")</div>
                <div class="dash-stat-label">Terkonfirmasi (sign)</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-icon bg-blue">📁</div>
            <div>
                <div class="dash-stat-value">@HistoryEvents.Count</div>
                <div class="dash-stat-label">Selesai tugas ini</div>
            </div>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- DAFTAR ACARA (Unified Event List)              -->
    <!-- ============================================== -->
    <h3 class="dash-section-title">Daftar Acara</h3>

    <!-- Filter Bar -->
    <div class="dash-filter-bar">
        <input type="text" class="dash-filter-search" placeholder="Cari nama acara, lokasi, atau teknisi..." @bind="SearchFilter" @bind:event="oninput" />
        <button type="button" class="dash-filter-btn filter-active">Semua</button>
        <button type="button" class="dash-filter-btn">Hari ini</button>
        <button type="button" class="dash-filter-btn">Minggu ini</button>
    </div>

    <!-- Status Legend -->
    <div class="dash-status-legend">
        <span><span class="dash-status-dot dot-red"></span> Belum ditugaskan</span>
        <span><span class="dash-status-dot dot-yellow"></span> Ditugaskan, belum sign</span>
        <span><span class="dash-status-dot dot-green"></span> Dikonfirmasi (sign)</span>
        <span><span class="dash-status-dot dot-blue" style="background: var(--pertamina-blue);"></span> Dokumentasi diunggah</span>
        <span><span class="dash-status-dot dot-gray"></span> Selesai</span>
    </div>

    <!-- Helpdesk: Input Acara Form (shown only for Helpdesk) -->
    @if (CurrentRole == "Helpdesk")
    {
        <div class="premium-card mb-4">
            <div class="card-header-accent"></div>
            <div class="p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="fs-3">📝</span>
                    <h3 class="m-0" style="color: var(--pertamina-blue);">Input Acara & Kebutuhan</h3>
                </div>
                <p class="text-muted">Masukkan data acara secara manual beserta detail kebutuhan logistik IT.</p>
                
                <EditForm Model="NewEvent" OnValidSubmit="HandleSubmitEvent">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Nama Acara / Kegiatan</label>
                            <input type="text" class="form-control premium-input" @bind="NewEvent.NamaAcara" placeholder="Contoh: Rapat Pleno Dekan" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Lokasi Ruangan</label>
                            <input type="text" class="form-control premium-input" @bind="NewEvent.Lokasi" placeholder="Contoh: Gedung A Lt.2" required />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark">Tanggal</label>
                            <input type="date" class="form-control premium-input" @bind="NewEventDate" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark">Waktu Mulai</label>
                            <input type="time" class="form-control premium-input" @bind="NewEventStart" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark">Estimasi Selesai</label>
                            <input type="time" class="form-control premium-input" @bind="NewEventEnd" required />
                        </div>
                    </div>

                    <div class="border-top pt-3 mb-3">
                        <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-between" style="color: var(--pertamina-blue);">
                            <span>🛠️ Kebutuhan Support IT</span>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="AddNeedInputRow">+ Tambah</button>
                        </h5>
                        @if (NewNeedsList.Count == 0)
                        {
                            <div class="text-center py-3 text-muted border rounded bg-light">Belum ada kebutuhan. Klik + Tambah.</div>
                        }
                        else
                        {
