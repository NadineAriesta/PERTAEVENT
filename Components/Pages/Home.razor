    // Master Lokasi Management
    
    // Master Barang Management
    private bool ShowBarangModal { get; set; } = false;
    private bool IsEditBarang { get; set; } = false;
    private MasterBarang ActiveBarang { get; set; } = new();

    private void OpenAddBarangModal()
    {
        IsEditBarang = false;
        ActiveBarang = new MasterBarang { Stok = 1 };
        ShowBarangModal = true;
    }

    private void OpenEditBarangModal(MasterBarang brg)
    {
        IsEditBarang = true;
        ActiveBarang = new MasterBarang 
        { 
            IdBarang = brg.IdBarang, 
            NamaBarang = brg.NamaBarang, 
            Code = brg.Code,
            Kategori = brg.Kategori,
            Stok = brg.Stok,
            SisaBarang = brg.SisaBarang
        };
        ShowBarangModal = true;
    }

    
    private async Task DeleteBarang(MasterBarang brg)
    {
        try
        {
            var target = await DbContext.MasterBarang.FindAsync(brg.IdBarang);
            if (target != null)
            {
                DbContext.MasterBarang.Remove(target);
                DbContext.AuditLogs.Add(new AuditLog
                {
                    Waktu = DateTime.Now,
                    Username = LoggedInUser?.Username ?? "Sistem",
                    Aksi = "Hapus Master IT",
                    Detail = $"Menghapus barang '{target.NamaBarang}' dari daftar master data"
                });
                await DbContext.SaveChangesAsync();
                ShowNotificationWithTimer("Barang berhasil dihapus.");
                await LoadDataAsync();
            }
        }
        catch (Exception)
        {
            ShowNotificationWithTimer("Gagal menghapus: Barang masih digunakan pada acara aktif!");
        }
    }

    private void CloseBarangModal()
    {
        ShowBarangModal = false;
    }

    private async Task SaveBarang()
    {
        if (string.IsNullOrWhiteSpace(ActiveBarang.NamaBarang) || string.IsNullOrWhiteSpace(ActiveBarang.Code))
        {
            ShowNotificationWithTimer("Kode dan Nama Barang tidak boleh kosong.");
            return;
        }

        if (IsEditBarang)
        {
            var target = await DbContext.MasterBarang.FindAsync(ActiveBarang.IdBarang);
            if (target != null)
            {
                int borrowed = target.Stok - target.SisaBarang;
                target.Code = ActiveBarang.Code;
                target.NamaBarang = ActiveBarang.NamaBarang;
                target.Kategori = ActiveBarang.Kategori;
                target.Stok = ActiveBarang.Stok;
                target.SisaBarang = Math.Max(0, ActiveBarang.Stok - borrowed);
                DbContext.MasterBarang.Update(target);
                ShowNotificationWithTimer("Barang berhasil diperbarui.");
            }
        }
        else
        {
            ActiveBarang.SisaBarang = ActiveBarang.Stok;
            DbContext.MasterBarang.Add(ActiveBarang);
            ShowNotificationWithTimer("Barang berhasil ditambahkan.");
        }

        DbContext.AuditLogs.Add(new AuditLog
        {
            Waktu = DateTime.Now,
            Username = LoggedInUser?.Username ?? "Sistem",
            Aksi = IsEditBarang ? "Edit Master IT" : "Tambah Master IT",
            Detail = $"{(IsEditBarang ? "Memperbarui" : "Menambahkan")} data barang '{ActiveBarang.NamaBarang}'"
        });

        await DbContext.SaveChangesAsync();
        ShowBarangModal = false;
        await LoadDataAsync();
    }

