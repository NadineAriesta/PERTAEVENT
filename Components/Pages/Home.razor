        </div>

        <!-- Workflow Roadmap Guide -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="premium-card p-4">
                    <h4 class="mb-3 d-flex align-items-center gap-2" style="color: var(--pertamina-blue);">
                        <span>🔄</span> Alur Kerja & Status Penugasan IT Support
                    </h4>
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3 bg-light p-3 rounded-3 border">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                            <div>
                                <strong class="d-block text-dark small">Input Acara (Helpdesk)</strong>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.72rem;">🔴 Belum Ditugaskan</span>
                            </div>
                        </div>
                        <div class="text-muted d-none d-md-block fs-5">➡️</div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                            <div>
                                <strong class="d-block text-dark small">Tugaskan Teknisi (Admin)</strong>
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size: 0.72rem;">🟡 Menunggu Sign</span>
                            </div>
                        </div>
                        <div class="text-muted d-none d-md-block fs-5">➡️</div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">3</span>
                            <div>
                                <strong class="d-block text-dark small">Tanda Tangan (Teknisi)</strong>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.72rem;">🔵 Dikonfirmasi</span>
                            </div>
                        </div>
                        <div class="text-muted d-none d-md-block fs-5">➡️</div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">4</span>
                            <div>
                                <strong class="d-block text-dark small">Unggah Bukti Setup (Teknisi)</strong>
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.72rem;">🟢 Dokumen Diunggah</span>
                            </div>
                        </div>
                        <div class="text-muted d-none d-md-block fs-5">➡️</div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">5</span>
                            <div>
                                <strong class="d-block text-dark small">Penyelesaian (Admin)</strong>
                                <span class="badge bg-light text-secondary border" style="font-size: 0.72rem;">⚫ Selesai (Riwayat)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Active Events & Assignments Panel -->
            <div class="col-12">
                <div class="premium-card">
                    <div class="card-header-accent"></div>
                    <div class="p-4">
                        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                            <div>
                                <h3 class="m-0" style="color: var(--pertamina-blue);">Monitor Alur Penugasan & Approval</h3>
                                <p class="text-muted m-0">Menyelesaikan masalah miss-komunikasi approval tanda tangan (sign) dan bukti foto teknisi.</p>
                            </div>
                        </div>

                        @if (ActiveEvents.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <span class="fs-1 d-block mb-3">🎉</span>
                                <h5>Semua tugas telah diselesaikan atau belum ada input acara baru</h5>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                @foreach (var eventItem in ActiveEvents)
                                {
                                    var assignment = GetAssignmentForEvent(eventItem.IdAcara);
                                    
                                    <div class="col-12">
                                        <div class="event-card status-@GetStatusColorName(eventItem.StatusAcara) p-3">
                                            <div class="row align-items-center g-3">
                                                <!-- Event Info -->
                                                <div class="col-md-3">
                                                    <h5 class="mb-1 text-dark" style="font-family: 'Outfit';">@eventItem.NamaAcara</h5>
                                                    <div class="small text-muted">
                                                        <span>📍</span> @eventItem.Lokasi <br/>
                                                        <span>🕒</span> @eventItem.Tanggal.ToString("dd MMM yyyy") | @eventItem.JamMulai.ToString(@"hh\:mm") - @eventItem.JamSelesai.ToString(@"hh\:mm")
                                                    </div>
                                                </div>

                                                <!-- Needs List -->
                                                <div class="col-md-3 border-start">
                                                    <strong class="small text-secondary d-block mb-1">🛠️ Kebutuhan Support IT:</strong>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var need in eventItem.Kebutuhan)
                                                        {
                                                            <span class="badge bg-light text-dark border small">@need.JenisKebutuhan (@need.Jumlah)</span>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Assignment Details & Sign Tracker -->
                                                <div class="col-md-3 border-start">
                                                    <strong class="small text-secondary d-block mb-1">📋 Detail Penugasan & Tanda Tangan:</strong>
                                                    @if (assignment == null)
                                                    {
                                                        <span class="text-danger small fw-bold">❌ Belum ada Teknisi ditugaskan</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="small">
                                                            <div><strong>Teknisi:</strong> @assignment.Teknisi?.User?.Username (@assignment.Teknisi?.Spesialisasi)</div>
                                                            <div class="mt-1 d-flex flex-column gap-1">
                                                                <!-- Admin Sign Tracker -->
                                                                <span class="text-success fw-bold">
                                                                    ✍️ Disetujui Admin (Pak Adit)
                                                                </span>
                                                                <!-- Technician Sign Tracker -->
                                                                @if (assignment.WaktuKonfirmasi != null)
                                                                {
                                                                    <span class="text-success fw-bold">
                                                                        🤝 Dikonfirmasi Teknisi: @assignment.WaktuKonfirmasi?.ToString("dd/MM HH:mm")
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-danger">
                                                                        ⏳ Menunggu Sign Teknisi
                                                                    </span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Action Buttons / Status Timeline -->
                                                <div class="col-md-3 text-md-end border-start">
                                                    <div class="mb-2">
                                                        <span class="status-badge @GetStatusClass(eventItem.StatusAcara) d-inline-flex">
                                                            @GetStatusIndicator(eventItem.StatusAcara) @eventItem.StatusAcara
                                                        </span>
                                                    </div>

                                                    @if (eventItem.StatusAcara == "Belum Ditugaskan")
                                                    {
                                                        <button class="btn btn-danger btn-sm px-3 rounded-pill fw-bold" @onclick="() => OpenAssignModal(eventItem)">
                                                            ➕ Tugaskan Teknisi
                                                        </button>
                                                    }
                                                    else if (eventItem.StatusAcara == "Ditugaskan")
                                                    {
                                                        <button class="btn btn-outline-secondary btn-sm px-3 rounded-pill" disabled>
                                                            ⏳ Menunggu Teknisi Sign
                                                        </button>
                                                    }
                                                    else if (eventItem.StatusAcara == "Dikonfirmasi")
                                                    {
                                                        <button class="btn btn-outline-primary btn-sm px-3 rounded-pill" disabled>
                                                            ⏳ Menunggu Foto Dokumentasi
                                                        </button>
                                                    }
                                                    else if (eventItem.StatusAcara == "Dokumen Diunggah" && assignment != null)
                                                    {
                                                        <div class="d-flex flex-column gap-1 align-items-md-end">
                                                            <button class="btn btn-sm btn-outline-info mb-1 rounded-pill" @onclick="() => PreviewDocumentation(assignment)">
                                                                🔍 Lihat Bukti Foto
                                                            </button>
                                                            <button class="btn btn-success btn-sm px-3 rounded-pill fw-bold" @onclick="() => CompleteEvent(eventItem)">
                                                                ✅ Tuntaskan Acara
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Big Database Tables: Mapping Teknisi & Riwayat -->
            <div class="col-12">
                <div class="premium-card">
                    <div class="card-header-accent"></div>
                    <div class="p-4">
                        <ul class="nav nav-tabs mb-3" id="dbTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(ActiveTab == "teknisi" ? "active fw-bold" : "")" @onclick='() => ActiveTab = "teknisi"'>
                                    👥 Mapping & Ketersediaan Teknisi (Database Besar)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(ActiveTab == "riwayat" ? "active fw-bold" : "")" @onclick='() => ActiveTab = "riwayat"'>
                                    📁 Riwayat Acara Selesai (Archive)
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <!-- Mapping Teknisi Tab -->
                            @if (ActiveTab == "teknisi")
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">
                                        <thead>
                                            <tr>
                                                <th>Nama Teknisi</th>
                                                <th>Spesialisasi</th>
                                                <th>Status Ketersediaan</th>
                                                <th>Tugas Aktif</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var tek in Technicians)
                                            {
                                                var activeTaskCount = ActiveEvents.Count(e => e.PenugasanList.Any(p => p.IdTeknisi == tek.IdTeknisi));
                                                <tr>
                                                    <td>
                                                        <div class="fw-bold text-dark">@tek.User?.Username</div>
                                                        <div class="text-muted small">User ID: @tek.IdUser</div>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary">@tek.Spesialisasi</span>
                                                    </td>
                                                    <td>
                                                        @if (tek.StatusKetersediaan == "Tersedia")
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Tersedia</span>
                                                        }
                                                        else if (tek.StatusKetersediaan == "Sibuk")
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1">Sibuk (Sedang Bertugas)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Tidak Aktif</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-dark">@activeTaskCount Acara</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <!-- Riwayat Tab -->
                            @if (ActiveTab == "riwayat")
                            {
                                @if (HistoryEvents.Count == 0)
                                {
                                    <div class="text-center py-4 text-muted">
                                        Belum ada riwayat acara yang dituntaskan.
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Nama Acara</th>
                                                    <th>Teknisi</th>
                                                    <th>Tanggal Acara</th>
                                                    <th>Waktu Selesai</th>
                                                    <th>Bukti Dokumentasi</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var riwayat in HistoryEvents)
                                                {
                                                    <tr>
                                                        <td>
                                                            <strong class="text-dark">@riwayat.NamaAcara</strong>
                                                            <div class="text-muted small">Riwayat ID: @riwayat.IdRiwayat</div>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-dark">@riwayat.NamaTeknisi</span>
                                                        </td>
                                                        <td>📅 @riwayat.TanggalAcara.ToString("dd MMM yyyy")</td>
                                                        <td>🕒 @riwayat.WaktuSelesai.ToString("dd MMM yyyy HH:mm")</td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(riwayat.DokumentasiKegiatanFile))
                                                            {
                                                                <img src="@riwayat.DokumentasiKegiatanFile" class="img-thumbnail" style="max-height: 60px; cursor: pointer; border: 2px solid var(--pertamina-blue);" @onclick="() => PreviewImage(riwayat.DokumentasiKegiatanFile)" title="Klik untuk memperbesar" />
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">Tidak ada foto</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ============================================== -->
    <!-- TEKNISI VIEW (SENIOR FRIENDLY)                -->
    <!-- ============================================== -->
    @if (CurrentRole == "Teknisi")
    {
        var tekId = CurrentTeknisiId;
        var myAssignments = GetAssignmentsForTechnician(tekId);

        <div class="senior-friendly-container">
            <div class="senior-card mb-4 text-center" style="background: linear-gradient(135deg, var(--pertamina-blue-light) 0%, #E2E8F0 100%);">
                <span class="fs-1 d-block mb-2">👨‍🔧</span>
                <h1 class="senior-title m-0">Halo, Pak @GetTeknisiName(tekId)!</h1>
                <p class="senior-subtitle mb-0">Halaman ini dibuat dengan huruf besar agar gampang dibaca bapak-bapak teknisi.</p>
            </div>

            @if (myAssignments.Count == 0)
            {
                <div class="senior-card text-center border-success border-3">
                    <span class="fs-1 d-block mb-3">✅</span>
                    <h2 class="text-success mb-2" style="font-weight: 800;">TIDAK ADA TUGAS</h2>
                    <p class="senior-subtitle text-muted">Semua tugas bapak sudah selesai. Terima kasih banyak!</p>
                </div>
            }
            else
            {
                @foreach (var assign in myAssignments)
                {
                    var isSigned = assign.WaktuKonfirmasi != null;
                    var isUploaded = !string.IsNullOrEmpty(assign.DokumentasiKegiatanFile);
                    
                    <div class="senior-card mb-4 border-start border-5 @(isSigned ? (isUploaded ? "border-success" : "border-primary") : "border-warning")">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge @(isSigned ? (isUploaded ? "bg-success" : "bg-primary") : "bg-warning text-dark") fs-5 px-3 py-2 fw-bold">
                                @if (!isSigned) { <span>⏳ Belum Sign (Kuning)</span> }
                                else if (!isUploaded) { <span>🤝 Sudah Sign / Dikonfirmasi (Hijau)</span> }
                                else { <span>📷 Foto Terupload (Biru)</span> }
                            </span>
                        </div>

                        <h2 class="text-dark mb-3" style="font-size: 1.8rem; font-weight: 800;">
                            📍 @assign.Acara?.NamaAcara
                        </h2>

                        <div class="senior-detail-box">
                            <div class="senior-detail-row">
                                <span class="senior-detail-label">TEMPAT:</span>
                                <span class="senior-detail-val text-primary">🏢 @assign.Acara?.Lokasi</span>
                            </div>
                            <div class="senior-detail-row">
                                <span class="senior-detail-label">TANGGAL:</span>
                                <span class="senior-detail-val">📅 @assign.Acara?.Tanggal.ToString("dd MMMM yyyy")</span>
                            </div>
                            <div class="senior-detail-row">
                                <span class="senior-detail-label">JAM KERJA:</span>
                                <span class="senior-detail-val text-danger">🕒 @assign.Acara?.JamMulai.ToString(@"hh\:mm") - @assign.Acara?.JamSelesai.ToString(@"hh\:mm")</span>
                            </div>
                            <div class="senior-detail-row">
                                <span class="senior-detail-label">MANAJER PIC:</span>
                                <span class="senior-detail-val">✍️ Pak Adit (Admin)</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h4 class="text-dark fw-bold mb-2">🛠️ BARANG YANG HARUS DIBAWA & DISET-UP:</h4>
                            <div class="bg-light p-3 rounded border border-2">
                                @foreach (var need in assign.Acara?.Kebutuhan ?? new List<KebutuhanAcara>())
                                {
                                    <div class="fs-4 fw-bold text-dark mb-2">
                                        🔳 @need.JenisKebutuhan - <span class="text-primary">@need.Jumlah buah</span>
                                        <div class="fs-6 text-muted ms-4">Catatan: @(string.IsNullOrEmpty(need.Keterangan) ? "-" : need.Keterangan)</div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-column gap-3 mt-4">
                            @if (!isSigned)
                            {
                                <button class="senior-btn-giant senior-btn-confirm" @onclick="() => HandleOpenSignature(assign)">
                                    ✍️ TEKAN DI SINI UNTUK TANDA TANGAN (SIGN)
                                </button>
                            }
                            else if (!isUploaded)
                            {
                                <div class="alert alert-success border-2 text-center fs-5 py-2 fw-bold">
                                    ✅ Bapak sudah tanda tangan pada @assign.WaktuKonfirmasi?.ToString("HH:mm WIB")
                                </div>
                                <button class="senior-btn-giant senior-btn-upload" @onclick="() => HandleOpenUpload(assign)">
                                    📷 TEKAN DI SINI UNTUK UNGGAH FOTO BUKTI
                                </button>
                            }
                            else
                            {
                                <div class="alert alert-success border-2 text-center fs-5 py-2 fw-bold mb-0">
                                    📷 Foto bukti setup sudah dikirim ke Admin. Menunggu verifikasi Pak Adit.
                                </div>
                                <div class="text-center mt-2">
                                    <img src="@assign.DokumentasiKegiatanFile" class="img-fluid rounded border border-3" style="max-height: 250px; border-color: var(--pertamina-green) !important;" />
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }

</div>

