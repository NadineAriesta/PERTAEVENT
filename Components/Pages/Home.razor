    private string GetUserDisplayName()
    {
        if (!IsLoggedIn) return "Tamu";
        if (CurrentRole == "Admin") return "Pak Adit (Manager)";
        if (CurrentRole == "Helpdesk") return "Staff Helpdesk IT";
        if (CurrentRole == "Teknisi") return $"Pak {GetTeknisiName(CurrentTeknisiId)} (Teknisi)";
        return LoggedInUser?.Username ?? "Pengguna";
    }

