                                            {
                                                <button class="btn btn-sm btn-outline-primary fw-bold px-3" style="border-radius: 8px; font-size: 0.8rem;" @onclick="() => PreviewDocumentation(assignment)">🔍 Bukti</button>
                                                <button class="btn btn-sm btn-success fw-bold px-3" style="border-radius: 8px; font-size: 0.8rem; box-shadow: 0 2px 4px rgba(25,135,84,0.2);" @onclick="() => CompleteEvent(eventItem)">✅ Selesaikan</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }

                        <!-- Completed Events (shown inline if any) -->
                        @if (HistoryEvents.Count > 0)
                        {
                            @foreach (var hist in HistoryEvents.Take(3))
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9; background-color: #fafafa; opacity: 0.8;">
                                    <td class="py-2 ps-3 fw-bold" style="color: #64748b; font-size: 0.95rem;">@hist.NamaAcara</td>
                                    <td class="py-2 text-muted" style="font-size: 0.9rem;">@hist.TanggalAcara.ToString("dd MMM yyyy")</td>
                                    <td class="py-2 text-muted" style="font-size: 0.9rem;">-</td>
                                    <td class="py-2 text-muted" style="font-size: 0.9rem;">-</td>
                                    <td class="py-2">
                                        <span class="premium-pill-badge badge-gray">Selesai · @hist.NamaTeknisi</span>
                                    </td>
                                    <td class="py-2 text-start text-muted" style="font-size: 0.8rem; font-style: italic; padding-left: 1rem;">
                                        Telah diselesaikan
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (CurrentRole == "Teknisi")
    {
        <TeknisiDashboard 
            ActiveMenu="@ActiveMenu"
            CurrentTeknisiId="CurrentTeknisiId" 
            Assignments="Assignments" 
            ActiveEvents="ActiveEvents"
            HistoryEvents="HistoryEvents"
            Technicians="Technicians"
            OnOpenSignature="HandleOpenSignature" 
            OnOpenUpload="HandleOpenUpload" 
            OnRejectAssignment="HandleRejectAssignment"
            OnUpdateProgress="HandleUpdateProgress" />
    }

    <!-- Data Master & Pengguna Section -->
    @if (CurrentRole == "Admin" && ActiveMenu == "dashboard")
    {
        <div class="card border-0 bg-white mb-5" style="border-radius: 16px; border: 1px solid rgba(226, 232, 240, 0.8) !important; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); overflow: hidden;">
            <div class="p-4" style="border-bottom: 1px solid #f1f5f9; background: #fafafa;">
                <h5 class="m-0 fw-bold" style="color: #072C4C; font-family: 'Outfit';">Data Master & Pengguna</h5>
                <p class="m-0 text-muted mt-1" style="font-size: 0.85rem;">Kelola konfigurasi sistem dan akun</p>
            </div>
            <div class="p-4 bg-white">
                <div class="dash-master-row">
                    <div class="premium-master-card" @onclick='() => ActiveMenu = "pengguna"'>
                        <div class="premium-master-icon-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                        <div class="flex-grow-1">
                            <div class="premium-master-title">Pengguna & Role</div>
                            <div class="premium-master-desc">Kelola akun Helpdesk, Admin, Teknisi</div>
                        </div>
                        <div class="premium-master-arrow">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </div>
                    </div>
                    <div class="premium-master-card" @onclick='() => ActiveMenu = "master"'>
                        <div class="premium-master-icon-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                        </div>
                        <div class="flex-grow-1">
                            <div class="premium-master-title">Master Kebutuhan IT</div>
                            <div class="premium-master-desc">Proyektor, sound system, layar, dll</div>
                        </div>
                        <div class="premium-master-arrow">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </div>
                    </div>
                    <div class="premium-master-card" @onclick='() => ActiveMenu = "mapping"'>
                        <div class="premium-master-icon-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                        </div>
                        <div class="flex-grow-1">
                            <div class="premium-master-title">Data Teknisi</div>
                            <div class="premium-master-desc">Spesialisasi & status ketersediaan</div>
                        </div>
                        <div class="premium-master-arrow">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    </main>
    </div> <!-- end dash-shell -->

