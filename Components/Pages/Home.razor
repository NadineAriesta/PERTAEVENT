    private string SearchFilter { get; set; } = string.Empty;
    private string DateFilter { get; set; } = "Semua";
    private string PenugasanStatusFilter { get; set; } = "Semua";
    private async Task ExportExcelPenugasan()
    {
        try 
        {
            var data = AllSupportAcara.Where(ev => {
                var matchSearch = string.IsNullOrEmpty(SearchFilter) ||
                    ev.NamaAcara.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                    (GetAssignmentForEvent(ev.IdAcara)?.Teknisi?.User?.Username?.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (ev.LokasiNavigation?.NamaLokasi != null && ev.LokasiNavigation.NamaLokasi.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase)) ||
                    (ev.Kebutuhan != null && ev.Kebutuhan.Any(k => k.Barang != null && k.Barang.NamaBarang.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase)));
                if (!matchSearch) return false;
                var isClose = (ev.StatusAcara == "Selesai" || ev.StatusAcara == "Ditolak");
                if (PenugasanStatusFilter == "Open" && isClose) return false;
                if (PenugasanStatusFilter == "Close" && !isClose) return false;
                bool matchDate = true;
                if (DateFilter == "Minggu ini") matchDate = (ev.Tanggal.Date >= DateTime.Today && ev.Tanggal.Date <= DateTime.Today.AddDays(7));
                else if (DateFilter == "Bulan ini") matchDate = (ev.Tanggal.Month == DateTime.Today.Month && ev.Tanggal.Year == DateTime.Today.Year);
                return matchDate;
            }).ToList();

            var sb = new System.Text.StringBuilder();
            sb.AppendLine("<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:x='urn:schemas-microsoft-com:office:excel' xmlns='http://www.w3.org/TR/REC-html40'>");
            sb.AppendLine("<head><meta charset='utf-8'></head><body>");
            sb.AppendLine("<table border='1'>");
            sb.AppendLine("<tr><th style='background-color:#09A537;color:white;'>Nama Acara</th><th style='background-color:#09A537;color:white;'>Teknisi</th><th style='background-color:#09A537;color:white;'>Tanggal</th><th style='background-color:#09A537;color:white;'>Lokasi</th><th style='background-color:#09A537;color:white;'>Kebutuhan IT</th><th style='background-color:#09A537;color:white;'>Status</th><th style='background-color:#09A537;color:white;'>Catatan Teknisi</th><th style='background-color:#09A537;color:white;'>Dokumentasi</th></tr>");
            foreach (var ev in data)
            {
                var assignment = GetAssignmentForEvent(ev.IdAcara);
                var isClose = (ev.StatusAcara == "Selesai" || ev.StatusAcara == "Ditolak");
                var status = isClose ? "Close" : "Open";
                var needs = ev.Kebutuhan != null 
                    ? string.Join(" | ", ev.Kebutuhan.Select(k => k.Barang?.NamaBarang)) 
                    : "";
                var catatan = assignment != null && !string.IsNullOrEmpty(assignment.CatatanTeknisi) ? assignment.CatatanTeknisi : "-";
                var namaAcara = ev.NamaAcara ?? "";
                var teknisi = (assignment?.Teknisi?.User?.Username ?? "Menunggu");
                var lokasi = ev.LokasiNavigation?.NamaLokasi ?? "";
                var tanggal = ev.Tanggal.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("id-ID"));
                var doc = assignment != null && !string.IsNullOrEmpty(assignment.DokumentasiKegiatanFile) ? "Ada" : "Tidak Ada";
                sb.AppendLine($"<tr><td>{System.Net.WebUtility.HtmlEncode(namaAcara)}</td><td>{System.Net.WebUtility.HtmlEncode(teknisi)}</td><td>{System.Net.WebUtility.HtmlEncode(tanggal)}</td><td>{System.Net.WebUtility.HtmlEncode(lokasi)}</td><td>{System.Net.WebUtility.HtmlEncode(needs)}</td><td>{System.Net.WebUtility.HtmlEncode(status)}</td><td>{System.Net.WebUtility.HtmlEncode(catatan)}</td><td>{System.Net.WebUtility.HtmlEncode(doc)}</td></tr>");
            }
            sb.AppendLine("</table></body></html>");
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
            await JSRuntime.InvokeVoidAsync("eval", $"let a = document.createElement('a'); a.href = 'data:application/vnd.ms-excel;base64,{base64}'; a.download = 'Export_Penugasan.xls'; document.body.appendChild(a); a.click(); document.body.removeChild(a);");
        } 
        catch (Exception ex)
        {
            ShowNotificationWithTimer($"Gagal Export: {ex.Message}");
        }
    }

    private string _customDateFilter = "";
    private string CustomDateFilter
    {
        get => _customDateFilter;
        set
        {
            _customDateFilter = value;
            if (!string.IsNullOrEmpty(value))
            {
                DateFilter = "CustomDate";
            }
        }
    }

    private void SetDateFilter(string filter)
    {
        DateFilter = filter;
        if (filter != "CustomDate")
        {
            _customDateFilter = "";
        }
    }

    private bool IsDateMatch(DateTime eventDate)
    {
        if (DateFilter == "Minggu ini")
        {
            var diff = (7 + (DateTime.Today.DayOfWeek - DayOfWeek.Monday)) % 7;
            var startOfWeek = DateTime.Today.AddDays(-1 * diff).Date;
            var endOfWeek = startOfWeek.AddDays(7);
            return eventDate.Date >= startOfWeek && eventDate.Date < endOfWeek;
        }
        if (DateFilter == "Bulan ini")
        {
            return eventDate.Month == DateTime.Today.Month && eventDate.Year == DateTime.Today.Year;
        }
        if (DateFilter == "CustomDate" && !string.IsNullOrEmpty(CustomDateFilter))
        {
            if (DateTime.TryParse(CustomDateFilter, out DateTime parsed))
            {
                return eventDate.Date == parsed.Date;
            }
        }
        return true;
    }
    
