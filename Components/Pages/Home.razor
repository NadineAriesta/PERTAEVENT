    private int CalculateProgress(Penugasan p)
    {
        if (p.StatusPenugasan == "Ditolak") return 0;
        if (p.StatusPenugasan == "Ditugaskan" || string.IsNullOrEmpty(p.StatusPenugasan) || p.StatusPenugasan == "Menunggu Konfirmasi") return 0;
        var kebutuhan = (p.Acara?.Kebutuhan ?? new List<KebutuhanAcara>()).ToList();
        if (kebutuhan.Count == 0) return p.StatusPenugasan == "Selesai" ? 100 : 50;

        double stepWeight = 100.0 / (kebutuhan.Count + 1);
        double progress = stepWeight; 

        foreach (var k in kebutuhan)
        {
            if (CheckedKebutuhan.Contains($"{p.IdPenugasan}_{k.IdKebutuhan}")) progress += stepWeight * 0.5;
            if (k.IsKembali) progress += stepWeight * 0.5;
        }

        int finalProgress = (int)Math.Round(progress);
        if (finalProgress > 99 && kebutuhan.Any(k => !k.IsKembali)) return 99;
        return finalProgress > 100 ? 100 : finalProgress;
    }

    private string GetStatusPenugasan(Penugasan p)
    {
        if (p.StatusPenugasan == "Ditolak") return "Ditolak";
        if (p.StatusPenugasan == "Ditugaskan" || string.IsNullOrEmpty(p.StatusPenugasan) || p.StatusPenugasan == "Menunggu Konfirmasi") 
            return "Menunggu Konfirmasi";
        bool isAllReturned = p.Acara?.Kebutuhan != null && p.Acara.Kebutuhan.Any() && p.Acara.Kebutuhan.All(k => k.IsKembali);
        if (p.StatusPenugasan == "Selesai" || CalculateProgress(p) == 100 || isAllReturned) 
            return "Selesai";
        return "Berlangsung";
    }

    private async Task ToggleKebutuhan(string key, Penugasan p, KebutuhanAcara keb)
    {
        bool wasAmbil = keb.IsAmbil;
        if (CheckedKebutuhan.Contains(key))
        {
            CheckedKebutuhan.Remove(key);
            keb.IsAmbil = false;
            keb.IsKembali = false;
        }
        else
        {
            CheckedKebutuhan.Add(key);
            keb.IsAmbil = true;
        }
        p.Progress = CalculateProgress(p);
        p.StatusPenugasan = (p.Progress == 100) ? "Selesai" : GetStatusPenugasan(p);
        if (p.Progress == 100 && p.Acara != null) p.Acara.StatusAcara = "Selesai";
        
        var barang = await DbContext.MasterBarang.FindAsync(keb.IdBarang);
        if (barang != null) {
            if (wasAmbil && !keb.IsAmbil) barang.SisaBarang += keb.Jumlah;
            else if (!wasAmbil && keb.IsAmbil) barang.SisaBarang = Math.Max(0, barang.SisaBarang - keb.Jumlah);
        }
        DbContext.Entry(keb).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        DbContext.Entry(p).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        if (p.Acara != null) DbContext.Entry(p.Acara).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        
        DbContext.AuditLogs.Add(new AuditLog
        {
            Waktu = DateTime.Now, Username = LoggedInUser?.Username ?? "Sistem",
            Aksi = "Update Checklist Kebutuhan by Admin/Helpdesk",
            Detail = $"Penugasan {p.Acara?.NamaAcara}: Mengubah status barang {keb.Barang?.NamaBarang} menjadi {(keb.IsAmbil ? "Diambil" : "Batal Diambil")}"
        });
        
        await DbContext.SaveChangesAsync();
        await LoadDataAsync();
    }

    private async Task TogglePengembalianBarang(KebutuhanAcara keb, Penugasan p)
    {
        keb.IsKembali = !keb.IsKembali;
        p.Progress = CalculateProgress(p);
        p.StatusPenugasan = (p.Progress == 100) ? "Selesai" : GetStatusPenugasan(p);
        if (p.Progress == 100 && p.Acara != null) p.Acara.StatusAcara = "Selesai";
        
        var barang = await DbContext.MasterBarang.FindAsync(keb.IdBarang);
        if (barang != null) {
            if (keb.IsKembali) barang.SisaBarang += keb.Jumlah;
            else barang.SisaBarang = Math.Max(0, barang.SisaBarang - keb.Jumlah);
        }
        DbContext.Entry(keb).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        DbContext.Entry(p).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        if (p.Acara != null) DbContext.Entry(p.Acara).State = Microsoft.EntityFrameworkCore.EntityState.Modified;
        
        DbContext.AuditLogs.Add(new AuditLog
        {
            Waktu = DateTime.Now, Username = LoggedInUser?.Username ?? "Sistem",
            Aksi = "Pengembalian Kebutuhan by Admin/Helpdesk",
