                            <button type="button" class="btn border-0 @(DateFilter == "Semua" ? "fw-bold shadow-sm" : "text-muted") px-3 py-1" style="background-color: @(DateFilter == "Semua" ? "white" : "transparent"); color: @(DateFilter == "Semua" ? "#0f172a" : "inherit"); border-radius: 8px; font-size: 0.85rem;" @onclick='() => SetDateFilter("Semua")'>Semua</button>
                            <button type="button" class="btn border-0 @(DateFilter == "Hari ini" ? "fw-bold shadow-sm" : "text-muted") px-3 py-1" style="background-color: @(DateFilter == "Hari ini" ? "white" : "transparent"); color: @(DateFilter == "Hari ini" ? "#0f172a" : "inherit"); border-radius: 8px; font-size: 0.85rem;" @onclick='() => SetDateFilter("Hari ini")'>Hari ini</button>
                            <button type="button" class="btn border-0 @(DateFilter == "Minggu ini" ? "fw-bold shadow-sm" : "text-muted") px-3 py-1" style="background-color: @(DateFilter == "Minggu ini" ? "white" : "transparent"); color: @(DateFilter == "Minggu ini" ? "#0f172a" : "inherit"); border-radius: 8px; font-size: 0.85rem;" @onclick='() => SetDateFilter("Minggu ini")'>Minggu ini</button>
