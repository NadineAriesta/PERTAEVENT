                                <th class="border-0 py-2" style="width: 16%; ">DIAJUKAN OLEH</th>
                                <th class="border-0 py-2" style="width: 12%; ">STATUS</th>
                                <th class="border-0 py-2 text-start" style="width: 16%; border-top-right-radius: 8px; border-bottom-right-radius: 8px; padding-left: 2rem;">AKSI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in AllSupportAcara)
                            {
                                var matchFilter = string.IsNullOrEmpty(SearchFilter) || 
                                    ev.NamaAcara.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                                    ev.Lokasi.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase);

                                if (!matchFilter) continue;
                                
                                <tr style="border-bottom: 1px solid #f1f5f9; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#f8fafc'" onmouseout="this.style.backgroundColor='transparent'">
