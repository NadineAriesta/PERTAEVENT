        <input type="date" max="@(DateTime.Now.Year)-12-31" class="position-absolute" style="opacity: 0; cursor: pointer; width: 100%; height: 100%; left: 0; top: 0; z-index: 2;" value="@CustomDateFilter" @onchange='(e) => { CustomDateFilter = e.Value?.ToString() ?? ""; if(!string.IsNullOrEmpty(CustomDateFilter)) DateFilter = "Custom"; else if (DateFilter == "Custom") DateFilter = "Semua"; }' />
    </div>
</div>
                        <div class="position-relative" style="width: 250px;">
                            <span class="position-absolute text-muted" style="left: 1rem; top: 50%; transform: translateY(-50%);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
                            <input type="text" class="form-control" placeholder="Cari acara..." style="border-radius: 10px; border: 1px solid #cbd5e1; padding: 0.65rem 1rem 0.65rem 2.5rem; background: #fff; font-size: 0.9rem;" @bind="SearchFilter" @bind:event="oninput" />
                        </div>
                    </div>
                </div>

                <div class="table-responsive" style="min-height: 200px;">
                    <table class="table align-middle m-0" style="width: 100%; table-layout: fixed; min-width: 850px;">
                        <thead>
                            <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; border-bottom: 2px solid #e2e8f0; background: #f8fafc;">
                                <th class="border-0 py-2 ps-3" style="width: 28%; ">NAMA ACARA</th>
                                <th class="border-0 py-2" style="width: 18%; ">JADWAL</th>
                                <th class="border-0 py-2" style="width: 16%; ">DIAJUKAN OLEH</th>
                                <th class="border-0 py-2" style="width: 22%; ">STATUS</th>
                                <th class="border-0 py-2 text-center pe-4" style="width: 16%; ">AKSI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredEvents.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <span class="fs-2 d-block mb-2">📅</span>
                                        <div class="fw-semibold">Tidak ada acara aktif untuk filter ini</div>
                                        <div class="small">Silakan pilih filter tanggal lainnya atau cari kata kunci lain.</div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var eventItem in filteredEvents)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#f8fafc'" onmouseout="this.style.backgroundColor='transparent'">
                                        <td class="py-2 ps-3">
                                            <div class="fw-bold" style="color: #0f172a; font-size: 0.95rem;">@eventItem.NamaAcara</div>
                                            <div class="text-muted" style="font-size: 0.85rem;">@eventItem.LokasiNavigation?.NamaLokasi</div>
                                        </td>
                                        <td class="py-2">
                                            <div style="color: #64748b; font-size: 0.9rem;">@eventItem.Tanggal.ToString("dd MMM yyyy")</div>
                                            <div style="color: #64748b; font-size: 0.9rem;">@eventItem.JamMulai.ToString(@"hh\:mm")-@eventItem.JamSelesai.ToString(@"hh\:mm")</div>
                                        </td>
                                        <td class="py-2">
                                            <div style="color: #64748b; font-size: 0.9rem;">
                                                @(eventItem.PembuatAcara?.Username == LoggedInUser?.Username ? "Anda" : (eventItem.PembuatAcara?.Username ?? "Admin"))
                                            </div>
                                        </td>
                                        <td class="py-2">
                                            @if (eventItem.StatusAcara == "Belum Ditugaskan") { 
                                                <span class="status-badge red">
                                                    Belum Ditugaskan
                                                </span> 
                                            }
                                            else if (eventItem.StatusAcara == "Ditugaskan") { 
                                                <span class="status-badge yellow">
                                                    Ditugaskan
                                                </span> 
                                            }
                                            else if (eventItem.StatusAcara == "Dikonfirmasi") { 
                                                <span class="status-badge green">
                                                    Dikonfirmasi
                                                </span> 
                                            }
                                            else if (eventItem.StatusAcara == "Dokumen Diunggah") { 
                                                <span class="status-badge blue">
                                                    Dokumen diunggah
                                                </span> 
                                            }
                                            else { 
                                                <span class="status-badge gray">
                                                    <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;margin-right:2px;"></span> Selesai
                                                </span> 
                                            }
                                        </td>
                                        <td class="py-2 text-center pe-4">
                                            <button class="btn btn-sm px-3 py-2 fw-bold" style="border-radius: 8px; color: #005CA9; background: #EBF3FC; border: none; transition: all 0.2s;" onmouseover="this.style.background='#005CA9'; this.style.color='#fff';" onmouseout="this.style.background='#EBF3FC'; this.style.color='#005CA9';" @onclick='() => OpenEditModal(eventItem)'>Edit kebutuhan</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3" style="border-top: 1px solid #e2e8f0; background: #f8fafc;">
                    <div style="color: #64748b; font-size: 0.85rem; font-weight: 500;">Menampilkan @filteredEvents.Count dari @ActiveEvents.Count acara</div>
                    <div style="background-color: #072C4C; color: white; width: 32px; height: 32px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 600; box-shadow: 0 2px 4px rgba(7,44,76,0.2);">1</div>
                </div>
            </div>
        }
        else if (ActiveMenu == "semua_acara")
        {


            <div class="card border-0 bg-white mb-4" style="border-radius: 16px; border: 1px solid rgba(226, 232, 240, 0.8) !important; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); overflow: hidden;">
                <div class="d-flex flex-wrap justify-content-between align-items-center p-4 gap-3" style="border-bottom: 1px solid #f1f5f9; background: #fafafa;">
                    <div>
                        <h5 class="m-0 fw-bold" style="color: #072C4C; font-family: 'Outfit';">Support Acara</h5>
                        <p class="m-0 text-muted mt-1" style="font-size: 0.85rem;">Daftar seluruh permintaan dukungan IT acara</p>
