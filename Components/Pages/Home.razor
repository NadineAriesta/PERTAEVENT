    private async Task HandleSubmitEditEvent()
    {
        try
        {
            if (EditEvent.IdLokasi == 0)
            {
                ShowNotificationWithTimer("Error: Silakan pilih lokasi ruangan terlebih dahulu.");
                return;
            }
            var existingEvent = await DbContext.SupportAcara
               .Include(e => e.Kebutuhan)
               .FirstOrDefaultAsync(e => e.IdAcara == EditEvent.IdAcara);

            if (existingEvent != null)
            {
                var changes = new List<string>();
                
                if (existingEvent.NamaAcara != EditEvent.NamaAcara)
                    changes.Add($"Nama dari '{existingEvent.NamaAcara}' ke '{EditEvent.NamaAcara}'");
                if (existingEvent.IdLokasi != EditEvent.IdLokasi)
                {
                    changes.Add($"Lokasi diubah");
                }
                if (existingEvent.Tanggal != EditEventDate)
                    changes.Add($"Tanggal dari {existingEvent.Tanggal:dd MMM} ke {EditEventDate:dd MMM}");
                var newStart = EditEventStart.ToTimeSpan();
                if (existingEvent.JamMulai != newStart)
                    changes.Add($"Jam Mulai dari {existingEvent.JamMulai:hh\\:mm} ke {newStart:hh\\:mm}");

                string changeDetail = changes.Count > 0 
                    ? $"Memperbarui {existingEvent.NamaAcara}: " + string.Join("; ", changes)
                    : $"Memperbarui data kebutuhan IT untuk acara {existingEvent.NamaAcara}";

                existingEvent.NamaAcara = EditEvent.NamaAcara;
                existingEvent.IdLokasi = EditEvent.IdLokasi;
                existingEvent.Tanggal = EditEventDate;
                existingEvent.JamMulai = EditEventStart.ToTimeSpan();
                existingEvent.JamSelesai = EditEventEnd.ToTimeSpan();

                // Update needs: remove old ones not in the list, update existing, add new ones
                DbContext.KebutuhanAcara.RemoveRange(existingEvent.Kebutuhan);
                
                foreach (var need in EditNeedsList)
                {
                    existingEvent.Kebutuhan.Add(new KebutuhanAcara
                    {
                        IdBarang = need.IdBarang,
                        Jumlah = need.Jumlah,
                        Keterangan = need.Keterangan
                    });
                }

                // Add Notification to technicians assigned
                var penugasan = await DbContext.Penugasan.Where(p => p.IdAcara == EditEvent.IdAcara).Include(p => p.Teknisi).ToListAsync();
                foreach (var p in penugasan)
                {
                    if (p.Teknisi != null)
                    {
                        DbContext.Notifications.Add(new Notification
                        {
                            IdUser = p.Teknisi.IdUser,
                            Message = $"Perubahan jadwal/kebutuhan untuk Event {existingEvent.NamaAcara}.",
                            Status = "Unread"
                        });
                    }
                }

                // Insert Audit Log
                DbContext.AuditLogs.Add(new AuditLog
                {
                    Waktu = DateTime.Now,
                    Username = LoggedInUser?.Username ?? "Sistem",
                    Aksi = "Edit Acara",
                    Detail = changeDetail
                });

                await DbContext.SaveChangesAsync();
                ShowNotificationWithTimer($"Acara '{existingEvent.NamaAcara}' berhasil diperbarui.");
            }

            ShowEditModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ShowNotificationWithTimer($"Gagal memperbarui acara: {ex.Message}");
        }
    }

