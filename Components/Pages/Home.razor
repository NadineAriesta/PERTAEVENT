<!-- MODALS SECTION                                 -->
<!-- ============================================== -->

<!-- 0. Edit Acara Modal -->
@if (ShowEditModal && EditEvent != null)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.12); max-width: 760px; width: 90%; background-color: #ffffff;">
            <div class="modal-header p-4 border-bottom-0 d-flex justify-content-between align-items-center" style="background-color: #ffffff; padding-bottom: 0.5rem !important;">
                <h4 class="modal-title m-0 fw-bold" style="color: #072C4C; font-family: 'Outfit'; font-size: 1.25rem;">@(EditEvent.StatusAcara == "Selesai" ? "Detail Acara" : "Edit Acara & Kebutuhan")</h4>
                <button type="button" class="btn-close shadow-none" style="opacity: 0.6;" @onclick="CloseEditModal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-3 py-2" style="max-height: 70vh; overflow-y: auto;">
                <EditForm Model="EditEvent" OnValidSubmit="HandleSubmitEditEvent">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark" style="font-size: 0.85rem;">Nama Acara / Kegiatan</label>
                            <input type="text" class="form-control form-input-premium" @bind="EditEvent.NamaAcara" disabled="@(EditEvent.StatusAcara == "Selesai")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark" style="font-size: 0.85rem;">Lokasi Ruangan</label>
                            <input type="text" class="form-control form-input-premium" @bind="EditEvent.Lokasi" disabled="@(EditEvent.StatusAcara == "Selesai")" required />
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark" style="font-size: 0.85rem;">Tanggal</label>
                            <input type="date" class="form-control form-input-premium" @bind="EditEventDate" disabled="@(EditEvent.StatusAcara == "Selesai")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark" style="font-size: 0.85rem;">Waktu Mulai</label>
                            <input type="time" class="form-control form-input-premium" @bind="EditEventStart" disabled="@(EditEvent.StatusAcara == "Selesai")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark" style="font-size: 0.85rem;">Estimasi Selesai</label>
                            <input type="time" class="form-control form-input-premium" @bind="EditEventEnd" disabled="@(EditEvent.StatusAcara == "Selesai")" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-3" style="border-top: 1px solid #e2e8f0; padding-top: 1.5rem; margin-top: 1.5rem;">
                            <h5 class="fw-bold m-0" style="color: #072C4C; font-family: 'Outfit'; font-size: 1rem;">Kebutuhan Support IT</h5>
                            @if (EditEvent.StatusAcara != "Selesai")
                            {
                                <button type="button" class="btn btn-premium-red-sm" style="border-radius: 8px;" @onclick="AddEditNeedInputRow">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                    Tambah
                                </button>
                            }
                        </div>
                        
                        <div class="needs-list-container">
                            @for (int i = 0; i < EditNeedsList.Count; i++)
                            {
                                var index = i;
                                var need = EditNeedsList[i];
                                <div class="row g-2 mb-2 align-items-center">
                                    <div class="col-5">
                                        <select class="form-select form-input-premium" @bind="need.JenisKebutuhan" disabled="@(EditEvent.StatusAcara == "Selesai")">
                                            <option value="Proyektor">Proyektor</option>
                                            <option value="Sound System">Sound System</option>
                                            <option value="Layar LED">Layar LED</option>
                                            <option value="Mic Wireless">Mic Wireless</option>
                                            <option value="Laptop/PC">Laptop/PC</option>
                                            <option value="Lainnya">Lainnya...</option>
                                        </select>
                                    </div>
                                    <div class="col-2">
                                        <input type="number" class="form-control form-input-premium" @bind="need.Jumlah" min="1" placeholder="Qty" disabled="@(EditEvent.StatusAcara == "Selesai")" />
                                    </div>
                                    <div class="col-4">
                                        <input type="text" class="form-control form-input-premium" @bind="need.Keterangan" placeholder="Keterangan / Spesifikasi" disabled="@(EditEvent.StatusAcara == "Selesai")" />
                                    </div>
                                    @if (EditEvent.StatusAcara != "Selesai")
                                    {
                                        <div class="col-1 text-center">
                                            <button type="button" class="btn-delete-premium" @onclick="() => RemoveEditNeedInputRow(index)">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                                </svg>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            
                            @if (EditNeedsList.Count == 0)
                            {
                                <div class="text-center py-2 text-muted border rounded" style="background-color: #f8fafc; border-style: dashed !important; border-color: #cbd5e1 !important; font-size: 0.9rem;">
                                    Belum ada kebutuhan IT yang ditambahkan.
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-light px-3 py-2 fw-bold rounded-pill" style="border: 1px solid #cbd5e1; color: #475569; font-size: 0.88rem;" @onclick="CloseEditModal">Batal</button>
                        @if (EditEvent.StatusAcara != "Selesai")
                        {
                            <button type="submit" class="btn-premium-red px-3 py-2 fw-bold rounded-pill" style="min-width: 160px; font-size: 0.88rem;">
                                Simpan Perubahan
                            </button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- 1. Admin Assign Technician Modal -->
@if (ShowAssignModal && SelectedEventForAssign != null)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.12); max-width: 500px; background-color: #ffffff;">
            <div class="modal-header p-4 border-bottom-0 d-flex justify-content-between align-items-center" style="background-color: #ffffff; padding-bottom: 0.5rem !important;">
                <h4 class="modal-title m-0 fw-bold" style="color: #072C4C; font-family: 'Outfit'; font-size: 1.25rem;">Penugasan Teknisi</h4>
                <button type="button" class="btn-close shadow-none" style="opacity: 0.6;" @onclick="CloseAssignModal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-3 py-2">
                <h6 class="fw-bold mb-2 text-dark" style="font-size: 0.88rem;">Detail Acara:</h6>
                <div class="p-3 mb-3 small" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; line-height: 1.5; color: #475569;">
                    <strong>Nama Acara:</strong> @SelectedEventForAssign.NamaAcara <br/>
                    <strong>Lokasi:</strong> @SelectedEventForAssign.Lokasi <br/>
                    <strong>Waktu:</strong> @SelectedEventForAssign.Tanggal.ToString("dd MMM yyyy") (@SelectedEventForAssign.JamMulai.ToString(@"hh\:mm") - @SelectedEventForAssign.JamSelesai.ToString(@"hh\:mm"))
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-dark" style="font-size: 0.85rem; margin-bottom: 0.5rem;">Pilih Teknisi Lapangan</label>
                    <select class="form-select form-input-premium" @bind="SelectedTeknisiIdForAssign">
                        <option value="0">-- Pilih Teknisi --</option>
                        @foreach (var tek in Technicians)
                        {
                            var activeTasks = ActiveEvents.Count(e => e.PenugasanList.Any(p => p.IdTeknisi == tek.IdTeknisi));
                            <option value="@tek.IdTeknisi" disabled="@(tek.StatusKetersediaan != "Tersedia")">
                                @tek.User?.Username (@tek.Spesialisasi) - @(tek.StatusKetersediaan == "Tersedia" ? "Tersedia" : "Sibuk") [Tugas Aktif: @activeTasks]
                            </option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer p-4 border-top-0 d-flex justify-content-end gap-3" style="background-color: #ffffff; padding-top: 0.5rem !important;">
                <button type="button" class="btn btn-light px-3 py-2 fw-bold rounded-pill" style="border: 1px solid #cbd5e1; color: #475569; font-size: 0.88rem;" @onclick="CloseAssignModal">Batal</button>
                <button type="button" class="btn-premium-red px-3 py-2 fw-bold rounded-pill" style="min-width: 160px; font-size: 0.88rem;" @onclick="HandleAssignTeknisi" disabled="@(SelectedTeknisiIdForAssign == 0)">
                    Tugaskan Teknisi
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Profil Teknisi Modal -->
@if (ShowEditTeknisiModal && EditTeknisi != null)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.12); max-width: 480px; background-color: #ffffff;">
            <div class="modal-header p-4 border-bottom-0 d-flex justify-content-between align-items-center" style="background-color: #ffffff; padding-bottom: 0.5rem !important;">
                <h4 class="modal-title m-0 fw-bold" style="color: #072C4C; font-family: 'Outfit'; font-size: 1.25rem;">Edit Profil Teknisi</h4>
                <button type="button" class="btn-close shadow-none" style="opacity: 0.6;" @onclick="CloseEditTeknisiModal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-3 py-2">
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark" style="font-size: 0.85rem; margin-bottom: 0.5rem;">Nama Teknisi</label>
                    <input type="text" class="form-control form-input-premium" value="@EditTeknisi.User?.Username" style="background-color: #f1f5f9 !important; color: #64748b !important; cursor: not-allowed;" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark" style="font-size: 0.85rem; margin-bottom: 0.5rem;">Spesialisasi</label>
                    <input type="text" class="form-control form-input-premium" @bind="EditTeknisi.Spesialisasi" placeholder="Contoh: Jaringan, Multimedia, Kelistrikan" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark" style="font-size: 0.85rem; margin-bottom: 0.5rem;">Status Ketersediaan</label>
                    <select class="form-select form-input-premium" @bind="EditTeknisi.StatusKetersediaan">
                        <option value="Tersedia">Tersedia (Siap)</option>
                        <option value="Sibuk">Sedang Bertugas (Sibuk)</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer p-4 border-top-0 d-flex justify-content-end gap-3" style="background-color: #ffffff; padding-top: 0.5rem !important;">
                <button type="button" class="btn btn-light px-3 py-2 fw-bold rounded-pill" style="border: 1px solid #cbd5e1; color: #475569; font-size: 0.88rem;" @onclick="CloseEditTeknisiModal">Batal</button>
                <button type="button" class="btn-premium-red px-3 py-2 fw-bold rounded-pill" style="min-width: 160px; font-size: 0.88rem;" @onclick="HandleSubmitEditTeknisi">
                    Simpan Perubahan
                </button>
            </div>
        </div>
    </div>
}

<!-- 2. Technician Signature Modal -->
@if (ShowSignatureModal && ActiveAssignmentForAction != null)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.12); max-width: 520px; background-color: #ffffff;">
            <div class="modal-header p-4 border-bottom-0 d-flex justify-content-between align-items-center" style="background-color: #ffffff; padding-bottom: 0.5rem !important;">
                <h4 class="modal-title m-0 fw-bold" style="color: #072C4C; font-family: 'Outfit'; font-size: 1.25rem;">Tanda Tangan Konfirmasi</h4>
                <button type="button" class="btn-close shadow-none" style="opacity: 0.6;" @onclick="() => ShowSignatureModal = false" aria-label="Close"></button>
            </div>
            <div class="modal-body px-3 py-2 text-center">
                <p class="text-dark mb-4" style="font-size: 0.95rem; line-height: 1.5;">
                    Silakan tanda tangan di dalam kotak di bawah ini untuk mengonfirmasi penugasan support <strong>@ActiveAssignmentForAction.Acara?.NamaAcara</strong>.
                </p>

                <div class="signature-pad-sim mb-4" style="border-radius: 10px; border: 2px dashed #005CA9; background-color: #f0f7ff; cursor: pointer; padding: 2.5rem 1rem; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#e0efff'" onmouseout="this.style.backgroundColor='#f0f7ff'" @onclick="SimulateSignatureDraw">
                    @if (string.IsNullOrEmpty(SignatureDataUrl))
                    {
                        <div class="text-muted" style="font-size: 0.9rem;">
                            <div style="font-weight: 700; color: #005CA9; margin-bottom: 4px;">KLIK DI SINI UNTUK TANDA TANGAN</div>
                            <div style="font-size: 0.8rem;">(Sistem akan menghasilkan tanda tangan digital otomatis)</div>
                        </div>
                    }
                    else
                    {
                        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
                            <span class="fw-bold text-success" style="font-size: 1rem;">✓ TANDA TANGAN DIGITAL TERPASANG</span>
                            <small class="text-muted" style="font-size: 0.75rem; margin-top: 4px;">Hash: @SignatureDataUrl</small>
                        </div>
                    }
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label fw-bold text-dark" style="font-size: 0.85rem; margin-bottom: 0.5rem;">Tulis nama lengkap Anda:</label>
                    <input type="text" class="form-control text-center form-input-premium fw-bold" style="font-size: 1.1rem; padding: 0.75rem;" @bind="TechnicianNameInput" placeholder="Contoh: Pak Joko" />
                </div>
            </div>
            <div class="modal-footer p-4 border-top-0 d-flex justify-content-end gap-3" style="background-color: #ffffff; padding-top: 0.5rem !important;">
                <button type="button" class="btn btn-light px-3 py-2 fw-bold rounded-pill" style="border: 1px solid #cbd5e1; color: #475569; font-size: 0.88rem;" @onclick="() => ShowSignatureModal = false">Batal</button>
                <button type="button" class="btn-premium-red px-3 py-2 fw-bold rounded-pill" style="min-width: 160px; font-size: 0.88rem;" @onclick="HandleSubmitSignature" disabled="@(string.IsNullOrEmpty(TechnicianNameInput))">
                    Kirim Tanda Tangan
                </button>
            </div>
        </div>
    </div>
}

<!-- 3. Technician Upload Photo Modal -->
@if (ShowUploadModal && ActiveAssignmentForAction != null)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.12); max-width: 520px; background-color: #ffffff;">
            <div class="modal-header p-4 border-bottom-0 d-flex justify-content-between align-items-center" style="background-color: #ffffff; padding-bottom: 0.5rem !important;">
                <h4 class="modal-title m-0 fw-bold" style="color: #000000; font-family: 'Outfit'; font-size: 1.25rem;">Unggah Dokumentasi Setup</h4>
                <button type="button" class="btn-close shadow-none" style="opacity: 0.6;" @onclick="() => ShowUploadModal = false" aria-label="Close"></button>
            </div>
            <div class="modal-body px-3 py-2 text-center">
                <p class="text-dark mb-4" style="font-size: 0.95rem; line-height: 1.5;">
                    Silahkan unggah dokumentasi <strong>@ActiveAssignmentForAction.Acara?.NamaAcara</strong>
                </p>

                <div class="mb-4">
                    <button type="button" class="btn btn-outline-primary w-100 py-2 mb-3 fw-bold" style="border-radius: 10px; border-style: dashed; font-size: 0.9rem;" @onclick="SimulateCameraUpload">
                        Ambil Gambar dari Kamera Kamera HP (Simulasi)
                    </button>
                    
                    <div class="text-muted mb-3" style="font-size: 0.75rem; letter-spacing: 0.05em; font-weight: 700;">ATAU PILIH FILE DARI MEMORI HP</div>
                    
                    <InputFile OnChange="HandleFileSelection" class="form-control form-input-premium" accept="image/*" />
