@page "/"
@using EventSupportApp.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject IJSRuntime JSRuntime

<PageTitle>PertaEvent - IT Event Support Portal</PageTitle>

@if (!IsLoggedIn)
{
    <div class="public-portal">
        <!-- 1. Header -->
        <header class="corp-header py-3 bg-white">
            <div class="container-fluid" style="max-width: 1400px;">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 80" width="180" height="50">
                            <!-- Graphic Symbol -->
                            <g transform="skewX(-25) translate(25, 2)">
                                <!-- Red block (top right) -->
                                <rect x="42" y="10" width="40" height="20" rx="4" fill="#E31E24" />
                                <!-- Green block (middle right) -->
                                <rect x="42" y="40" width="40" height="20" rx="4" fill="#92C83E" />
                                <!-- Blue block (left) -->
                                <rect x="10" y="32" width="20" height="48" rx="4" fill="#005CA9" />
                            </g>
                            <!-- Text "PERTAMINA" -->
                            <text x="115" y="52" font-family="'Outfit', 'Inter', sans-serif" font-weight="900" font-size="28" fill="#022F1E" letter-spacing="-0.02rem">PERTAMINA</text>
                        </svg>
                    </div>

                    <!-- Top Navigation & Search -->
                    <div class="d-flex align-items-center gap-4">
                        <nav class="corp-nav-top d-none d-lg-flex align-items-center">
                            <a href="/" class="corp-nav-link active-red">HOME</a>
                            <a style="cursor: pointer;" class="corp-nav-link" @onclick='() => ScrollToElement("about-section")'>TENTANG SISTEM</a>
                            <a style="cursor: pointer;" class="corp-nav-link" @onclick='() => ScrollToElement("help-section")'>BANTUAN</a>
                        </nav>
                        <div class="corp-login-dropdown">
                            <button type="button" class="corp-login-toggle" @onclick="OpenEmptyLoginModal">
                                Login
                            </button>
                            <div class="corp-login-menu">
                                <button type="button" class="corp-login-item" @onclick='() => PrepareQuickLogin("admin")'>Admin</button>
                                <button type="button" class="corp-login-item" @onclick='() => PrepareQuickLogin("helpdesk")'>Helpdesk</button>
                                <button type="button" class="corp-login-item" @onclick='() => PrepareQuickLogin("pak_joko")'>Teknisi</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <section class="corp-hero d-flex align-items-center position-relative">
            <div class="container-fluid corp-hero-content d-flex align-items-center justify-content-center text-center w-100 py-5">
                <div>
                    <h1 class="corp-hero-title text-center" style="font-size: 4rem; line-height: 1.15; text-shadow: 0 4px 20px rgba(0,0,0,0.6);">
                        World Class<br />
                        National Energy<br />
                        Company
                    </h1>
                    <p class="text-white-50 mt-3 fs-5" style="max-width: 700px; margin: 0 auto; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
                        Portal IT Event Support Pertamina - Dukungan Sistem & Infrastruktur Handal untuk Kelancaran Kegiatan Korporat
                    </p>
                </div>
            </div>

            <!-- Bottom Slant Tabs -->
            <div class="hero-slant-bar d-none d-md-flex">
                <a href="#" class="hero-slant-tab"><span>Company Profile</span></a>
                <a href="#" class="hero-slant-tab"><span>Our Business</span></a>
                <a href="#" class="hero-slant-tab"><span>News Room</span></a>
                <a href="#" class="hero-slant-tab"><span>Investor Relations</span></a>
                <a href="#" class="hero-slant-tab"><span>Social Responsibility</span></a>
            </div>
        </section>

        <!-- 3. About Us Section -->
        <section class="corp-about" id="about-section">
            <div class="container-fluid" style="max-width: 1200px;">
                <div class="row align-items-center g-5">
                    <div class="col-md-5 corp-about-truck-container">
                        <img src="/images/fuel_truck.png" alt="Pertamina Fuel Truck" class="corp-about-truck" />
                    </div>
                    <div class="col-md-7 text-start">
                        <h2 class="corp-about-title">About Us</h2>
                        <p class="corp-about-text">
                            As a state-owned company to carry out integrated business care in oil, gas, renewable and new energy based on strong commercial principles both inside and outside the country, Pertamina strives to provide the best and a real contribution to the welfare of the nation in utilizing every potential of Indonesia.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. News Columns Section -->
        <section class="py-5 bg-white">
            <div class="container-fluid" style="max-width: 1200px;">
                <div class="row g-5 text-start">
                    <!-- Left: News Release -->
                    <div class="col-md-6">
                        <div class="corp-news-tab-blue">News Release</div>
                        <div class="corp-news-list">
                            <div class="corp-news-item">
                                <span class="corp-news-date">16 Nov 2017 - 10:00</span>
                                <a href="#" class="corp-news-title-link">Pertamina Mendukung Program Pemerintah Konversi BBM ke BBG Untuk Nelayan Kecil Tahun 2017 di Kabupaten Cilacap</a>
                            </div>
                            <div class="corp-news-item">
                                <span class="corp-news-date">21 Okt 2017 - 15:30</span>
                                <a href="#" class="corp-news-title-link">Pertamina Siap Kelola Mahakam</a>
                            </div>
                            <div class="corp-news-item">
                                <span class="corp-news-date">12 Sep 2017 - 09:00</span>
                                <a href="#" class="corp-news-title-link">PT Pertamina EP Laksanakan Pemboran Offshore Perdana di Laut Jawa</a>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Energy Update -->
                    <div class="col-md-6">
                        <div class="corp-news-tab-red">Energy Update</div>
                        <div class="corp-news-list">
                            <div class="corp-news-item">
                                <span class="corp-news-date">16 Nov 2017 - 16:30</span>
                                <a href="#" class="corp-news-title-link">Dari Arus Balik Lebaran 2017 : Pertamax - Pertalite Pilihan Favorit Pemudik Lebaran 2017</a>
                            </div>
                            <div class="corp-news-item">
                                <span class="corp-news-date">21 Okt 2017 - 10:30</span>
                                <a href="#" class="corp-news-title-link">Komisaris Utama Pertamina Sambangi TBBM Malang</a>
                            </div>
                            <div class="corp-news-item">
                                <span class="corp-news-date">12 Sep 2017 - 16:00</span>
                                <a href="#" class="corp-news-title-link">Direktur Utama Pertamina Tatap Muka dengan PEPC, PEPE, ADK, dan TFPI</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. Highlights and Business Tiles -->
        <section class="py-5" style="background-color: #F8FAFC;" id="features-section">
            <div class="container-fluid" style="max-width: 1200px;">
                <div class="tile-container text-start">
                    <!-- Left Big Highlight -->
                    <div class="tile-col-left">
                        <div class="highlight-card shadow-sm">
                            <div class="highlight-img-container" style="background-image: url('/images/engineers_highlight.png');"></div>
                            <div class="highlight-footer-bar">Highlight</div>
                        </div>
                    </div>
                    <!-- Right Small Tiles -->
                    <div class="tile-col-right">
                        <a href="#" class="business-tile-blue shadow-sm">
                            <span>Our Business</span>
                        </a>
                        <a href="#" class="business-tile-green shadow-sm">
                            <span>Investor Relations</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. Red Footer -->
        <footer class="corp-footer-red text-start" id="help-section">
            <div class="container-fluid" style="max-width: 1200px;">
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="corp-footer-title">Contact Pertamina</div>
                        <div class="corp-footer-phone">1500-000</div>
                        <div class="mt-3">
                            <a href="#" class="corp-footer-social-btn">f</a>
                            <a href="#" class="corp-footer-social-btn">t</a>
                            <a href="#" class="corp-footer-social-btn">y</a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-2 col-lg-2">
                        <div class="corp-footer-title">Our Website</div>
                        <ul class="corp-footer-list">
                            <li><a href="#">Term & Condition</a></li>
                            <li><a href="#">Privacy Policy</a></li>
                            <li><a href="#">Scam Alert</a></li>
                            <li><a href="#">Social Media</a></li>
                        </ul>
                    </div>
                    <div class="col-sm-6 col-md-2 col-lg-2">
                        <div class="corp-footer-title">Tools</div>
                        <ul class="corp-footer-list">
                            <li><a href="#">Webmail</a></li>
                            <li><a href="#">i-Plan</a></li>
                            <li><a href="#">Gas Station Registration</a></li>
                            <li><a href="#">Pertamina Clean</a></li>
                            <li><a href="#">HSSE Database</a></li>
                        </ul>
                    </div>
                    <div class="col-sm-6 col-md-2 col-lg-2">
                        <div class="corp-footer-title">Announcement</div>
                        <ul class="corp-footer-list">
                            <li><a href="#">Pertamina Info</a></li>
                            <li><a href="#">Procurement</a></li>
                            <li><a href="#">Announcement</a></li>
                            <li><a href="#">E-Procurement</a></li>
                        </ul>
                    </div>
                    <div class="col-sm-6 col-md-2 col-lg-2">
                        <div class="corp-footer-title">Network</div>
                        <ul class="corp-footer-list">
                            <li><a href="#">Subsidiaries</a></li>
                            <li><a href="#">Joint Operation</a></li>
                            <li><a href="#">Office Address</a></li>
                            <li><a href="#">Product Distribution</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>

        <!-- 7. Copyright Bottom Bar -->
        <div class="corp-bottom-bar">
            <div class="container">
                Copyright &copy; 2026 PT Pertamina. All rights reserved.
            </div>
        </div>

        <!-- Glassmorphic Login Modal -->
        @if (ShowLoginModal)
        {
            <div class="modal fade show d-block animate-fade-in" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.7); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); z-index: 9999;">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                    <div class="modal-content border-0 position-relative" style="background: rgba(15, 23, 42, 0.45); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px); border: 1px solid rgba(255, 255, 255, 0.12) !important; border-radius: 20px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);">
                        
                        <!-- Close Button -->
                        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 shadow-none" style="z-index: 10;" @onclick="() => ShowLoginModal = false" aria-label="Close"></button>

                        <div class="p-4 text-start">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="fs-4">🔑</span>
                                <h4 class="m-0 fw-bold text-white" style="font-family: 'Outfit';">IT Support Portal</h4>
                            </div>
                            <p class="text-white-50 small mb-4">Masuk untuk mengelola support acara PT Pertamina.</p>

                            @if (!string.IsNullOrEmpty(LoginErrorMessage))
                            {
                                <div class="alert alert-danger border-0 p-2 mb-3 text-center" style="background-color: rgba(220, 53, 69, 0.25); color: #F8D7DA; border-left: 4px solid #E31E24 !important; font-size: 0.85rem;">
                                    ⚠️ @LoginErrorMessage
                                </div>
                            }

                            <form @submit:preventDefault="HandleLogin">
                                <div class="mb-3">
                                    <label class="form-label text-white-50">Username</label>
                                    <input type="text" class="form-control premium-input text-white" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);" @bind="InputUsername" placeholder="Username Anda" />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label text-white-50">Password</label>
                                    <input type="password" class="form-control premium-input text-white" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);" @bind="InputPassword" placeholder="••••••••" />
                                </div>
                                <button type="submit" class="btn btn-primary w-100 py-2.5 fw-bold rounded-3 shadow text-uppercase" style="background: #E31E24; border: none; transition: all 0.2s;">
                                    MASUK PORTAL
                                </button>
                            </form>

                            <!-- Quick Logins inside widget -->
                            <div class="border-top border-secondary pt-3 mt-4" style="border-color: rgba(255, 255, 255, 0.12) !important;">
                                <span class="d-block text-uppercase fw-bold text-white-50 mb-2" style="font-size: 0.7rem; letter-spacing: 0.05rem;">💡 Demo Login Cepat</span>
                                <div class="d-flex flex-wrap gap-1.5">
                                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2.5 rounded-pill text-white" style="font-size: 0.72rem; border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.05);" @onclick='() => PrepareQuickLogin("admin")'>👑 Admin</button>
                                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2.5 rounded-pill text-white" style="font-size: 0.72rem; border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.05);" @onclick='() => PrepareQuickLogin("helpdesk")'>📝 Helpdesk</button>
                                    <button type="button" class="btn btn-sm btn-outline-light py-1 px-2.5 rounded-pill text-white" style="font-size: 0.72rem; border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.05);" @onclick='() => PrepareQuickLogin("pak_joko")'>👨‍🔧 Teknisi</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Header App -->
    <header class="app-header d-flex align-items-center justify-content-between">
        <div class="brand-title">
            <!-- SVG Pertamina Logo -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 80" width="36" height="30" class="me-1">
                <g transform="skewX(-25) translate(15, 2)">
                    <rect x="42" y="10" width="40" height="20" rx="4" fill="#E31E24" />
                    <rect x="42" y="40" width="40" height="20" rx="4" fill="#92C83E" />
                    <rect x="10" y="32" width="20" height="48" rx="4" fill="#005CA9" />
                </g>
            </svg>
            <div class="brand-text">
                <div><span class="text-blue">Perta</span><span class="text-red">Event</span></div>
                <span class="brand-subtitle">IT Support Portal</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="text-end d-none d-md-block">
                <span class="d-block fw-bold text-dark" style="font-family: 'Outfit';">@GetUserDisplayName()</span>
                <span class="badge bg-secondary" style="font-size: 0.7rem; font-weight: 700;">Peran: @CurrentRole</span>
            </div>
            <button class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" @onclick="ResetDatabase" title="Reset semua data ke kondisi awal demo">
                🔄 Reset Demo Data
            </button>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold" @onclick="HandleLogout">
                🚪 Keluar
            </button>
        </div>
    </header>

<div class="container-fluid py-4" style="max-width: 1400px;">
    
    @if (!string.IsNullOrEmpty(SystemNotification))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm border-0" role="alert" style="border-left: 5px solid var(--pertamina-green) !important; background-color: var(--pertamina-green-light); color: var(--pertamina-green-hover);">
            <strong>✨ Info Sistem:</strong> @SystemNotification
            <button type="button" class="btn-close" @onclick="ClearNotification"></button>
        </div>
    }

    <!-- Hero Banner -->
    <div class="hero-banner p-4 p-md-5 rounded-4 mb-4 shadow-sm">
        <div class="hero-overlay"></div>
        <div class="position-relative z-index-1">
            <div class="badge bg-danger mb-2 px-3 py-1.5 text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05rem;">PT Pertamina (Persero)</div>
            <h1 class="hero-title">IT Event Support Management Portal</h1>
            <p class="hero-lead mb-4">
                Sistem monitoring penugasan dan persetujuan IT Support untuk memastikan kelancaran setiap agenda corporate event Pertamina secara profesional, transparan, dan realtime.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <div class="hero-stat-pill">
                    <span class="stat-icon">📅</span>
                    <div>
                        <span class="stat-number">@ActiveEvents.Count</span>
                        <span class="stat-label">Acara Aktif</span>
                    </div>
                </div>
                <div class="hero-stat-pill">
                    <span class="stat-icon">👥</span>
                    <div>
                        <span class="stat-number">@Technicians.Count</span>
                        <span class="stat-label">Teknisi Lapangan</span>
                    </div>
                </div>
                <div class="hero-stat-pill">
                    <span class="stat-icon">📁</span>
                    <div>
                        <span class="stat-number">@HistoryEvents.Count</span>
                        <span class="stat-label">Selesai (Archive)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- HELPDESK VIEW                                  -->
    <!-- ============================================== -->
    @if (CurrentRole == "Helpdesk")
    {
        <div class="row g-4">
            <!-- Input Form Column -->
            <div class="col-lg-5">
                <div class="premium-card">
                    <div class="card-header-accent"></div>
                    <div class="p-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="fs-3">📝</span>
                            <h3 class="m-0" style="color: var(--pertamina-blue);">Input Acara & Kebutuhan</h3>
                        </div>
                        <p class="text-muted">Masukkan data acara secara manual beserta detail kebutuhan logistik IT.</p>
                        
                        <EditForm Model="NewEvent" OnValidSubmit="HandleSubmitEvent">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark">Nama Acara / Kegiatan</label>
                                <input type="text" class="form-control premium-input" @bind="NewEvent.NamaAcara" placeholder="Contoh: Rapat Pleno Dekan, Kuliah Umum" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark">Lokasi Ruangan</label>
                                <input type="text" class="form-control premium-input" @bind="NewEvent.Lokasi" placeholder="Contoh: Gedung A Lantai 2, Aula Rektorat" required />
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-dark">Tanggal</label>
                                    <input type="date" class="form-control premium-input" @bind="NewEventDate" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-dark">Waktu Mulai</label>
                                    <input type="time" class="form-control premium-input" @bind="NewEventStart" required />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-dark">Estimasi Selesai</label>
                                <input type="time" class="form-control premium-input" @bind="NewEventEnd" required />
                            </div>

                            <div class="border-top pt-3 mb-4">
                                <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-between" style="color: var(--pertamina-blue);">
                                    <span>🛠️ Kebutuhan Support IT</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="AddNeedInputRow">+ Tambah</button>
                                </h5>

                                @if (NewNeedsList.Count == 0)
                                {
                                    <div class="text-center py-3 text-muted border rounded bg-light">
                                        Belum ada kebutuhan ditambahkan. Klik tombol di atas untuk menambah kebutuhan.
                                    </div>
                                }
                                else
                                {
                                    @for (int i = 0; i < NewNeedsList.Count; i++)
                                    {
                                        var index = i;
                                        <div class="row g-2 mb-2 align-items-center">
                                            <div class="col-5">
                                                <select class="form-select premium-input py-2" @bind="NewNeedsList[index].JenisKebutuhan">
                                                    <option value="Proyektor">Proyektor</option>
                                                    <option value="Sound System">Sound System</option>
                                                    <option value="Layar / Screen">Layar / Screen</option>
                                                    <option value="Multimedia Laptop">Multimedia Laptop</option>
                                                    <option value="Kabel Roll & Kelistrikan">Kabel & Listrik</option>
                                                    <option value="Lainnya">Lainnya</option>
                                                </select>
                                            </div>
                                            <div class="col-3">
                                                <input type="number" class="form-control premium-input py-2" @bind="NewNeedsList[index].Jumlah" min="1" placeholder="Qty" />
                                            </div>
                                            <div class="col-3">
                                                <input type="text" class="form-control premium-input py-2" @bind="NewNeedsList[index].Keterangan" placeholder="Ket" />
                                            </div>
                                            <div class="col-1 text-end">
                                                <button type="button" class="btn btn-link text-danger p-0" @onclick="() => RemoveNeedInputRow(index)">❌</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3" style="font-family: 'Outfit'; font-size: 1.05rem;">
                                💾 Simpan Acara Baru
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>

            <!-- List Column -->
            <div class="col-lg-7">
                <div class="premium-card h-100">
                    <div class="card-header-accent"></div>
                    <div class="p-4">
                        <h3 class="mb-4" style="color: var(--pertamina-blue);">Daftar Inputan Acara Aktif</h3>
                        
                        @if (ActiveEvents.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <span class="fs-1 d-block mb-3">📭</span>
                                <h5>Belum ada acara terdaftar</h5>
                                <p>Silakan input data acara di panel sebelah kiri.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Acara</th>
                                            <th>Waktu & Lokasi</th>
                                            <th>Kebutuhan IT</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var eventItem in ActiveEvents)
                                        {
                                            <tr>
                                                <td>
                                                    <strong class="text-dark">@eventItem.NamaAcara</strong>
                                                    <div class="text-muted small">ID: @eventItem.IdAcara</div>
                                                </td>
                                                <td>
                                                    <div>📅 @eventItem.Tanggal.ToString("dd MMM yyyy")</div>
                                                    <div class="small text-muted">🕒 @eventItem.JamMulai.ToString(@"hh\:mm") - @eventItem.JamSelesai.ToString(@"hh\:mm")</div>
                                                    <div class="small fw-semibold text-primary">📍 @eventItem.Lokasi</div>
                                                </td>
                                                <td>
                                                    <ul class="list-unstyled m-0 p-0 small">
                                                        @foreach (var need in eventItem.Kebutuhan)
                                                        {
                                                            <li><span class="text-primary">🔹</span> @need.JenisKebutuhan (@need.Jumlah pcs) <span class="text-muted">@need.Keterangan</span></li>
                                                        }
                                                    </ul>
                                                </td>
                                                <td>
                                                    <span class="status-badge @GetStatusClass(eventItem.StatusAcara)">
                                                        @GetStatusIndicator(eventItem.StatusAcara) @eventItem.StatusAcara
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ============================================== -->
    <!-- ADMIN / MANAGER VIEW                           -->
