                                        else if (ev.StatusAcara == "Dikonfirmasi") { <span class="premium-pill-badge badge-green">Dikonfirmasi</span> }
                                        else if (ev.StatusAcara == "Dokumen Diunggah") { <span class="premium-pill-badge badge-blue">Dokumen Diunggah</span> }
