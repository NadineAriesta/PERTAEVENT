    <!-- Teknisi: Senior-Friendly Task Cards -->
    @if (CurrentRole == "Teknisi")
    {
        var tekId = CurrentTeknisiId;
        var myAssignments = GetAssignmentsForTechnician(tekId);

        <div class="senior-friendly-container" style="max-width:100%;">
            @if (myAssignments.Count == 0)
            {
                <div class="senior-card text-center border-success border-3 mb-4">
                    <span class="fs-1 d-block mb-3">✅</span>
                    <h2 class="text-success mb-2" style="font-weight: 800;">TIDAK ADA TUGAS</h2>
                    <p class="senior-subtitle text-muted">Semua tugas bapak sudah selesai. Terima kasih banyak!</p>
                </div>
            }
            else
            {
                @foreach (var assign in myAssignments)
                {
                    var isSigned = assign.WaktuKonfirmasi != null;
                    var isUploaded = !string.IsNullOrEmpty(assign.DokumentasiKegiatanFile);
                    <div class="senior-card mb-4 border-start border-5 p-4 rounded bg-white shadow-sm @(isSigned ? (isUploaded ? "border-primary" : "border-success") : "border-warning")" style="border-left-width: 8px !important;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge @(isSigned ? (isUploaded ? "bg-primary" : "bg-success") : "bg-warning text-dark") fs-4 px-4 py-2.5 fw-bold">
                                @if (!isSigned) { <span>⏳ Ditugaskan - Belum Sign (Kuning)</span> }
                                else if (!isUploaded) { <span>🤝 Dikonfirmasi - Sudah Sign (Hijau)</span> }
                                else { <span>📷 Dokumen Diunggah (Biru)</span> }
                            </span>
                        </div>
                        <h2 class="text-dark mb-3" style="font-size: 1.8rem; font-weight: 800;">📍 @assign.Acara?.NamaAcara</h2>
                        <div class="senior-detail-box">
                            <div class="senior-detail-row"><span class="senior-detail-label">TEMPAT:</span><span class="senior-detail-val text-primary">🏢 @assign.Acara?.Lokasi</span></div>
                            <div class="senior-detail-row"><span class="senior-detail-label">TANGGAL:</span><span class="senior-detail-val">📅 @assign.Acara?.Tanggal.ToString("dd MMMM yyyy")</span></div>
                            <div class="senior-detail-row"><span class="senior-detail-label">JAM KERJA:</span><span class="senior-detail-val text-danger">🕒 @assign.Acara?.JamMulai.ToString(@"hh\:mm") - @assign.Acara?.JamSelesai.ToString(@"hh\:mm")</span></div>
                        </div>
                        <div class="d-flex flex-column gap-3 mt-4">
                            @if (!isSigned)
                            {
                                <button class="btn btn-warning w-100 py-3.5 fs-2 fw-bold text-dark rounded-3 shadow" @onclick="() => HandleOpenSignature(assign)">
                                    ✍️ TEKAN DI SINI UNTUK TANDA TANGAN (SIGN)
                                </button>
                            }
                            else if (!isUploaded)
                            {
                                <div class="alert alert-success border-2 text-center fs-5 py-2 fw-bold">✅ Sudah tanda tangan pada @assign.WaktuKonfirmasi?.ToString("HH:mm WIB")</div>
                                <button class="btn btn-primary w-100 py-3.5 fs-2 fw-bold text-white rounded-3 shadow" @onclick="() => HandleOpenUpload(assign)">
                                    📷 TEKAN DI SINI UNTUK UNGGAH FOTO BUKTI
                                </button>
                            }
                            else
                            {
                                <div class="alert alert-success border-2 text-center fs-5 py-2 fw-bold mb-0">
                                    📷 Foto bukti setup sudah dikirim ke Admin. Menunggu verifikasi Pak Adit.
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
