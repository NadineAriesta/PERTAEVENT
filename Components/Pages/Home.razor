                            <input type="text" class="form-control" placeholder="Cari nama atau lokasi..." style="border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.65rem 1rem 0.65rem 2.5rem; background: #fff; font-size: 0.9rem;" @bind="SearchFilter" @bind:event="oninput" />
                        </div>
                        <button type="button" class="btn btn-premium-red" @onclick='() => ActiveMenu = "form_acara"'>+ Ajukan Acara</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle" style="width: 100%;">
                        <thead style="background-color: #F8FAFC;">
                            <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em;">
                                <th class="border-0 py-2 ps-3" style="width: 24%; border-top-left-radius: 8px; border-bottom-left-radius: 8px; ">NAMA ACARA</th>
                                <th class="border-0 py-2" style="width: 16%; ">TANGGAL &amp; JAM</th>
