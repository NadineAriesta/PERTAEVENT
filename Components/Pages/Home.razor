        EditEventDate = eventItem.Tanggal;
        EditEventStart = TimeOnly.FromTimeSpan(eventItem.JamMulai);
        EditEventEnd = TimeOnly.FromTimeSpan(eventItem.JamSelesai);
        
        // Copy needs to avoid direct editing of references before saving
        EditNeedsList = eventItem.Kebutuhan.Select(k => new KebutuhanAcara 
        { 
            IdKebutuhan = k.IdKebutuhan,
            IdAcara = k.IdAcara,
