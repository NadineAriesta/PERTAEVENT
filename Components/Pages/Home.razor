    private async Task DeleteUser(User user)
    {
        try
        {
            var dbUser = await DbContext.Users
                .FirstOrDefaultAsync(u => u.IdUser == user.IdUser);
                
            if (dbUser != null)
            {
                // Prevent deletion of sys admin or currently logged in user
                if (LoggedInUser != null && dbUser.IdUser == LoggedInUser.IdUser)
                {
                    ShowNotificationWithTimer("Tidak dapat menghapus akun Anda sendiri!");
                    return;
                }

                // Check FK constraints
                bool isHelpdeskInUse = await DbContext.SupportAcara.AnyAsync(s => s.IdPembuatAcara == dbUser.IdUser);
                if (isHelpdeskInUse)
                {
                    ShowNotificationWithTimer("Gagal: Pengguna ini sudah membuat/terhubung dengan Acara (Helpdesk).");
                    return;
                }
                
                bool isAdminInUse = await DbContext.Penugasan.AnyAsync(p => p.IdPenugasTeknisi == dbUser.IdUser);
                var tek = await DbContext.MappingTeknisi.FirstOrDefaultAsync(m => m.IdUser == dbUser.IdUser);
                bool isTekInUse = tek != null && await DbContext.Penugasan.AnyAsync(p => p.IdTeknisi == tek.IdTeknisi);

                if (isAdminInUse || isTekInUse)
                {
                    ShowNotificationWithTimer("Gagal: Pengguna ini memiliki sejarah penugasan teknisi (tidak bisa dihapus karena riwayat).");
                    return;
                }

                // Safe to delete
                if (tek != null) DbContext.MappingTeknisi.Remove(tek);
                DbContext.Users.Remove(dbUser);
                
                await DbContext.SaveChangesAsync();
                ShowNotificationWithTimer($"Pengguna '{dbUser.Username}' berhasil dihapus dari sistem.");
                
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            ShowNotificationWithTimer($"Gagal menghapus pengguna: {ex.Message}");
        }
    }

    private async Task HandleSaveUser()
    {
        if (string.IsNullOrWhiteSpace(EditingUser.Username))
        {
            ShowNotificationWithTimer("Username tidak boleh kosong!");
            return;
        }

        try
        {
            if (EditingUser.IdUser == 0)
            {
                if (string.IsNullOrWhiteSpace(UserModalPassword))
                {
                    ShowNotificationWithTimer("Password tidak boleh kosong untuk pengguna baru!");
                    return;
                }

                var duplicate = await DbContext.Users.AnyAsync(u => u.Username.ToLower() == EditingUser.Username.ToLower());
                if (duplicate)
                {
                    ShowNotificationWithTimer($"Username '{EditingUser.Username}' sudah terdaftar!");
                    return;
                }

                EditingUser.Password = UserModalPassword;
                EditingUser.IdRole = EditingUserRoleId;
                DbContext.Users.Add(EditingUser);
                await DbContext.SaveChangesAsync();

                if (EditingUserRoleId == 3)
                {
                    var tek = new MappingTeknisi
                    {
                        IdUser = EditingUser.IdUser,
                        Spesialisasi = string.IsNullOrWhiteSpace(EditingUserSpesialisasi) ? "General Support" : EditingUserSpesialisasi,
                        StatusKetersediaan = "Tersedia"
                    };
                    DbContext.MappingTeknisi.Add(tek);
                }

                await DbContext.SaveChangesAsync();
                ShowNotificationWithTimer($"Pengguna '{EditingUser.Username}' berhasil ditambahkan!");
            }
            else
            {
                var dbUser = await DbContext.Users
                   .FirstOrDefaultAsync(u => u.IdUser == EditingUser.IdUser);
                if (dbUser != null)
                {
                    dbUser.Username = EditingUser.Username;
                    if (!string.IsNullOrWhiteSpace(UserModalPassword))
                    {
                        dbUser.Password = UserModalPassword;
                    }
                    dbUser.StatusAktif = EditingUser.StatusAktif;
                    dbUser.IdRole = EditingUserRoleId;

                    var existingTek = await DbContext.MappingTeknisi.FirstOrDefaultAsync(t => t.IdUser == dbUser.IdUser);
                    if (EditingUserRoleId == 3)
                    {
                        if (existingTek == null)
                        {
                            var tek = new MappingTeknisi
                            {
                                IdUser = dbUser.IdUser,
                                Spesialisasi = string.IsNullOrWhiteSpace(EditingUserSpesialisasi) ? "General Support" : EditingUserSpesialisasi,
                                StatusKetersediaan = "Tersedia"
                            };
                            DbContext.MappingTeknisi.Add(tek);
                        }
                        else
                        {
                            existingTek.Spesialisasi = string.IsNullOrWhiteSpace(EditingUserSpesialisasi) ? "General Support" : EditingUserSpesialisasi;
                        }
                    }
                    else
                    {
                        if (existingTek != null)
                        {
                            DbContext.MappingTeknisi.Remove(existingTek);
                        }
                    }

                    await DbContext.SaveChangesAsync();
                    ShowNotificationWithTimer($"Pengguna '{EditingUser.Username}' berhasil diperbarui!");
                }
            }

            ShowUserModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ShowNotificationWithTimer($"Gagal menyimpan pengguna: {ex.Message}");
        }
    }

