                                var assignment = GetAssignmentForEvent(ev.IdAcara);
                                var matchSearch = string.IsNullOrEmpty(SearchFilter) ||
                                    ev.NamaAcara.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                                    (assignment?.Teknisi?.User?.Username?.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                    (ev.LokasiNavigation?.NamaLokasi != null && ev.LokasiNavigation.NamaLokasi.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase)) ||
                                    (ev.Kebutuhan != null && ev.Kebutuhan.Any(k => k.Barang != null && k.Barang.NamaBarang.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase)));
                                
                                if (!matchSearch) continue;
                                
                                var isClose = (ev.StatusAcara == "Selesai" || ev.StatusAcara == "Ditolak");
                                var statusBadge = isClose ? "bg-success" : "bg-primary";
                                var statusText = isClose ? "Close" : "Open";
                                
                                if (PenugasanStatusFilter == "Open" && isClose) continue;
                                if (PenugasanStatusFilter == "Close" && !isClose) continue;
                                
                                bool matchDate = true;
                                if (DateFilter == "Minggu ini") matchDate = (ev.Tanggal.Date >= DateTime.Today && ev.Tanggal.Date <= DateTime.Today.AddDays(7));
                                else if (DateFilter == "Bulan ini") matchDate = (ev.Tanggal.Month == DateTime.Today.Month && ev.Tanggal.Year == DateTime.Today.Year);
                                if (!matchDate) continue;

                                var needs = ev.Kebutuhan != null && ev.Kebutuhan.Any() 
                                            ? string.Join(", ", ev.Kebutuhan.Select(k => k.Barang?.NamaBarang))
                                            : "-";
                                
