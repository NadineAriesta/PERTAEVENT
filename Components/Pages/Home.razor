                        <div class="d-flex bg-light p-1 rounded-3 border flex-nowrap flex-shrink-0 align-items-center">
    <button class="btn btn-sm @(DateFilter == "Semua" ? "bg-white shadow-sm fw-bold text-dark border-0" : "text-muted border-0") px-3 py-1" style="font-size: 0.8rem;" @onclick='() => SetDateFilter("Semua")'>Semua Waktu</button>
