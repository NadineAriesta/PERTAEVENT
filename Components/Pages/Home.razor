    private void ClearNotification() => SystemNotification = string.Empty;

    private async void ShowNotificationWithTimer(string message)
    {
        SystemNotification = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(5000);
        if (SystemNotification == message)
        {
            SystemNotification = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

