                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="font-size: 0.9rem; color: #334155;">Nama Barang <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-input-premium" @bind="ActiveBarang.NamaBarang" placeholder="Cth: Proyektor 5000 Lumens" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="font-size: 0.9rem; color: #334155;">Jumlah Stok Total <span class="text-danger">*</span></label>
                            <input type="number" class="form-control form-input-premium" @bind="ActiveBarang.Stok" min="1" />
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid #f1f5f9; background: #fafafa; padding: 1rem 1.5rem;">
                        <button type="button" class="btn btn-light px-4 fw-medium" style="border-radius: 8px;" @onclick="CloseBarangModal">Batal</button>
                        <button type="button" class="btn btn-premium-red px-4 fw-bold" style="border-radius: 8px;" @onclick="SaveBarang">Simpan</button>
                    </div>
                </div>
            </div>
        </div>
    }

</main>
