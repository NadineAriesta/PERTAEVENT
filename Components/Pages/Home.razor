    @if (CurrentRole == "Admin" && ActiveMenu == "dashboard")
    {
        <!-- Table with Integrated Filter Bar -->
        <div class="card border-0 bg-white mb-5" style="border-radius: 16px; border: 1px solid rgba(226, 232, 240, 0.8) !important; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); overflow: hidden;">
            @{
                var filteredAdminEvents = ActiveEvents.Where(e => {
