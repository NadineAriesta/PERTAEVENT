                @{
                    var filteredEvents = ActiveEvents.Where(e => {
                        if (!IsDateMatch(e.Tanggal)) return false;
                        var matchFilter = string.IsNullOrEmpty(SearchFilter) || 
                            (e.NamaAcara?.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (e.LokasiNavigation?.NamaLokasi?.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ?? false);
                        return matchFilter;
                    }).ToList();
                }
                <div class="d-flex flex-wrap justify-content-between align-items-center p-4 gap-3" style="border-bottom: 1px solid #f1f5f9; background: #fafafa;">
                    <div>
                        <h5 class="m-0 fw-bold" style="color: #072C4C; font-family: 'Outfit';">Daftar Acara</h5>
                        <p class="m-0 text-muted mt-1" style="font-size: 0.85rem;">Pantau status pengajuan acara</p>
                    </div>
                    <div class="d-flex gap-3 flex-wrap flex-md-nowrap align-items-center">
                        <div class="d-flex bg-light p-1 rounded-3 border flex-nowrap flex-shrink-0 align-items-center">
    <button class="btn btn-sm @(DateFilter == "Semua" ? "bg-white shadow-sm fw-bold text-dark border-0" : "text-muted border-0") px-3 py-1" style="font-size: 0.8rem;" @onclick='() => SetDateFilter("Semua")'>Semua Waktu</button>
    <button class="btn btn-sm @(DateFilter == "Minggu ini" ? "bg-white shadow-sm fw-bold text-dark border-0" : "text-muted border-0") px-3 py-1" style="font-size: 0.8rem;" @onclick='() => SetDateFilter("Minggu ini")'>Minggu Ini</button>
    <button class="btn btn-sm @(DateFilter == "Bulan ini" ? "bg-white shadow-sm fw-bold text-dark border-0" : "text-muted border-0") px-3 py-1" style="font-size: 0.8rem;" @onclick='() => SetDateFilter("Bulan ini")'>Bulan Ini</button>
    <div class="border-start border-secondary opacity-25 mx-1" style="height: 18px;"></div>
    <div class="position-relative d-flex align-items-center justify-content-center mx-1 @(!string.IsNullOrEmpty(CustomDateFilter) ? "bg-white shadow-sm border" : "")" style="width: 28px; height: 28px; border-radius: 6px;" title="Pilih Tanggal Spesifik">
