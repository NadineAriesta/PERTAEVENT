@page "/"
@using EventSupportApp.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject IJSRuntime JSRuntime

<PageTitle>PertaEvent - IT Event Support Portal</PageTitle>

@if (!IsLoggedIn)
{
    <LandingPage OnQuickLogin="QuickLogin" OnPrefillLogin="PrefillLoginModal" OnScrollToElement="ScrollToElement" OnOpenLoginModal="OpenEmptyLoginModal" />

        <!-- Clean Corporate Login Modal -->
        @if (ShowLoginModal)
        {
            <div class="modal fade show d-block animate-fade-in" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 9999;">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                    <div class="modal-content border-0 position-relative" style="background: #ffffff; border-radius: 12px; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
                        
                        <!-- Close Button -->
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-3 shadow-none" style="z-index: 10;" @onclick="() => ShowLoginModal = false" aria-label="Close"></button>

                        <div class="p-5 text-center">
                            <!-- Pertamina Logo -->
                            <div class="mb-4 d-flex justify-content-center align-items-center">
                                <img src="images/pertamina-logo.png" alt="Pertamina Logo" style="height: 50px; width: auto; object-fit: contain;" />
                            </div>

                            @if (!string.IsNullOrEmpty(SelectedLoginRole))
                            {
                                <p class="text-muted mb-1" style="font-size: 0.95rem;">Gunakan akun untuk login sebagai <strong class="text-dark">@SelectedLoginRole</strong></p>
                                <div class="mb-4">
                                    <button type="button" class="btn btn-link p-0 text-decoration-none" style="font-size: 0.85rem; color: #005CA9;" @onclick="OpenEmptyLoginModal">&larr; Ganti Peran</button>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-4" style="font-size: 0.95rem;">Masukkan username dan password Anda</p>
                            }

                            @if (!string.IsNullOrEmpty(LoginErrorMessage))
                            {
                                <div class="alert alert-danger border-0 p-2 mb-3 text-center rounded-3" style="background-color: #f8d7da; color: #842029; font-size: 0.85rem;">
                                    @LoginErrorMessage
                                </div>
                            }

                            <form @onsubmit="HandleLogin">
                                <!-- Username Field -->
                                <div class="input-group mb-3 custom-input-group">
                                    <span class="input-group-text bg-white text-muted border-end-0 px-3" style="border-radius: 6px 0 0 6px; border-color: #ced4da;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    </span>
                                    <input type="text" class="form-control border-start-0 ps-0 shadow-none" style="border-radius: 0 6px 6px 0; border-color: #ced4da;" @bind="InputUsername" placeholder="Username" required />
                                </div>

                                <!-- Password Field -->
                                <div class="input-group mb-4 custom-input-group">
                                    <span class="input-group-text bg-white text-muted border-end-0 px-3" style="border-radius: 6px 0 0 6px; border-color: #ced4da;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                    </span>
                                    <input type="password" class="form-control border-start-0 ps-0 shadow-none" style="border-radius: 0 6px 6px 0; border-color: #ced4da;" @bind="InputPassword" placeholder="Password" required />
                                </div>

                                <button type="submit" class="btn w-100 py-2 fw-bold text-white login-btn" style="background-color: #10b981; border-radius: 6px; font-size: 1rem;">Login</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
}
else
{
    <!-- ========== DASHBOARD SHELL ========== -->
    <div class="dash-shell">

    <!-- Sidebar -->
    <aside class="dash-sidebar" style="background: #072C4C;">
        <div class="dash-sidebar-brand d-flex align-items-center gap-3" style="padding: 1.5rem 1.25rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 1rem;">
            <div style="background: white; width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1); overflow: hidden; padding: 4px;">
                <img src="/images/pertamina-logo.png" alt="Pertamina" style="width: 100%; height: 100%; object-fit: contain;" />
            </div>
            <div style="line-height: 1.2;">
                <div style="color: white; font-weight: 700; font-family: 'Outfit'; font-size: 0.95rem;">PertaEvent</div>
                <div style="color: rgba(255,255,255,0.55); font-size: 0.7rem; margin-top: 2px;">Pertamina - Internal</div>
            </div>
        </div>

        <div class="dash-sidebar-section">
            <div class="dash-sidebar-label" style="margin-bottom: 0.5rem; letter-spacing: 0.15rem; color: rgba(255,255,255,0.4);">MENU</div>
            <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "dashboard" ? "menu-active" : "")" @onclick='() => ActiveMenu = "dashboard"'><span class="dash-sidebar-menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg></span> Dashboard</button>
            @if (CurrentRole != "Teknisi")
            {
                <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "semua_acara" ? "menu-active" : "")" @onclick='() => ActiveMenu = "semua_acara"'><span class="dash-sidebar-menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg></span> Support Acara</button>
            }
            <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "master" ? "menu-active" : "")" @onclick='() => ActiveMenu = "master"'><span class="dash-sidebar-menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg></span> Kebutuhan Acara</button>
            @if (CurrentRole != "Teknisi")
            {
                <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "mapping" ? "menu-active" : "")" @onclick='() => ActiveMenu = "mapping"'><span class="dash-sidebar-menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span> Mapping Teknisi</button>
            }
            <button type="button" class="dash-sidebar-menu-btn @(ActiveMenu == "penugasan" ? "menu-active" : "")" @onclick='() => ActiveMenu = "penugasan"'><span class="dash-sidebar-menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg></span> Penugasan Teknisi</button>
        </div>
        
        <div class="dash-sidebar-section" style="margin-top:auto; padding-top:1rem; border-top:1px solid rgba(255,255,255,0.08);">
            <button type="button" class="dash-sidebar-menu-btn text-danger" @onclick="HandleLogout"><span class="dash-sidebar-menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg></span> Logout</button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="dash-main">

    <!-- Universal Top Banner (Seamlessly Connected) -->
    <div style="background-color: #072C4C; padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center; margin: 0 -2rem 2rem -2rem; position: sticky; top: 0; z-index: 1040;">
        <div class="d-flex flex-column justify-content-center">
            <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.1); padding: 4px 12px; border-radius: 20px; color: rgba(255,255,255,0.85); font-size: 0.75rem; margin-bottom: 8px; letter-spacing: 0.5px; width: fit-content; border: 1px solid rgba(255,255,255,0.15);">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                @DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))
            </div>
            <h2 style="color: white; font-weight: 700; margin: 0; font-size: 1.5rem; font-family: 'Outfit';">Dashboard @CurrentRole</h2>
        </div>
        <div style="display: flex; align-items: center; gap: 1rem; text-align: right;">
            <div>
                <div style="color: white; font-weight: 600; font-size: 0.9rem;">@GetUserDisplayName()</div>
                <div style="color: rgba(255,255,255,0.6); font-size: 0.75rem;">@CurrentRole</div>
            </div>
            @if (CurrentRole != "Teknisi")
            {
                <div style="background-color: #E31E24; color: white; width: 42px; height: 42px; border-radius: 6px; display: flex; justify-content: center; align-items: center; font-weight: bold; font-size: 1.1rem; cursor: pointer;" @onclick="HandleLogout" title="Logout">
                    @(GetUserDisplayName().Substring(0, 1))
                </div>
            }
            else
            {
                <div style="color: white; font-weight: bold; cursor: pointer; text-decoration: underline;" @onclick="HandleLogout">
                    Logout
                </div>
            }
        </div>
    </div>

    @if (CurrentRole != "Teknisi")
    {
        @if (IsLoggedIn && UserNotifications.Any(n => n.Status == "Unread"))
        {
            <div class="alert alert-warning mb-4 shadow-sm border-0" style="border-left: 4px solid #f59e0b; background-color: #fef3c7; color: #92400e; font-size: 0.9rem;">
                <strong>Notifikasi:</strong> Anda memiliki @UserNotifications.Count(n => n.Status == "Unread") pesan baru yang belum dibaca.
            </div>
        }

        @if (!string.IsNullOrEmpty(SystemNotification))
        {
            <div class="alert mb-4 shadow-sm" role="alert" style="border: none; border-left: 4px solid #16a34a; background-color: #f0fdf4; color: #166534; font-size: 0.9rem; padding: 0.75rem 1.25rem; border-radius: 8px;">
                @SystemNotification
            </div>
        }
    }

    @if (ActiveMenu == "dashboard" && CurrentRole == "Admin")
    {
        <!-- Stats Cards -->
        <div class="dash-stats-row">
            <div class="dash-stat-card">
                <div class="dash-stat-icon bg-red"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg></div>
                <div>
                    <div class="dash-stat-value">@ActiveEvents.Count(e => e.StatusAcara == "Belum Ditugaskan")</div>
                    <div class="dash-stat-label">Belum ada teknisi</div>
                </div>
            </div>
            <div class="dash-stat-card">
                <div class="dash-stat-icon bg-yellow"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
                <div>
                    <div class="dash-stat-value">@ActiveEvents.Count(e => e.StatusAcara == "Ditugaskan")</div>
                    <div class="dash-stat-label">Menunggu konfirmasi</div>
                </div>
            </div>
            <div class="dash-stat-card">
                <div class="dash-stat-icon bg-green"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
                <div>
                    <div class="dash-stat-value">@ActiveEvents.Count(e => e.StatusAcara == "Dikonfirmasi" || e.StatusAcara == "Dokumen Diunggah")</div>
                    <div class="dash-stat-label">Terkonfirmasi (sign)</div>
                </div>
            </div>
            <div class="dash-stat-card">
                <div class="dash-stat-icon bg-blue"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg></div>
                <div>
                    <div class="dash-stat-value">@HistoryEvents.Count</div>
                    <div class="dash-stat-label">Selesai tugas ini</div>
                </div>
            </div>
        </div>
    }

    <!-- ============================================== -->
    <!-- DYNAMIC VIEWS                                  -->
    <!-- ============================================== -->
    @if (CurrentRole == "Helpdesk" || CurrentRole == "Admin")
    {
        @if (ActiveMenu == "dashboard" && CurrentRole == "Helpdesk")
        {
            <div class="mb-4 text-muted shadow-sm" style="font-size: 0.9rem; background: #F8FAFC; padding: 12px 15px; border-left: 4px solid #005CA9; border-radius: 8px;">
                Sebagai helpdesk, kamu hanya dapat melihat dan mengelola <span style="color: #072C4C; font-weight: bold;">acara yang kamu ajukan sendiri</span>.
            </div>

            <!-- Stats Row for Helpdesk -->
            <div class="dash-stats-row mb-4">
                <div class="dash-stat-card">
                    <div class="dash-stat-icon" style="background-color: #f1f5f9; color: #475569;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></div>
                    <div>
                        <div class="dash-stat-value" style="color: #0f172a;">@ActiveEvents.Count</div>
                        <div class="dash-stat-label">Total Acara</div>
                    </div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon bg-red"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg></div>
                    <div>
                        <div class="dash-stat-value">@ActiveEvents.Count(e => e.StatusAcara == "Belum Ditugaskan")</div>
                        <div class="dash-stat-label">Belum Ditugaskan</div>
                    </div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon bg-blue"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
                    <div>
                        <div class="dash-stat-value">@ActiveEvents.Count(e => e.StatusAcara == "Dikonfirmasi" || e.StatusAcara == "Dokumen Diunggah")</div>
                        <div class="dash-stat-label">Dikonfirmasi (Sign)</div>
                    </div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon bg-green"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
                    <div>
                        <div class="dash-stat-value">@HistoryEvents.Count(h => h.WaktuSelesai.Month == DateTime.Now.Month && h.WaktuSelesai.Year == DateTime.Now.Year)</div>
                        <div class="dash-stat-label">Selesai (Bulan ini)</div>
                    </div>
                </div>
            </div>

            <!-- Filter Bar -->
            <div class="d-flex align-items-center mb-4 gap-3">
                <input type="text" class="form-control shadow-sm" placeholder="Cari acara saya..." style="max-width: 300px; border-radius: 20px; border: 1px solid #e2e8f0; padding: 0.6rem 1.2rem;" @bind="SearchFilter" @bind:event="oninput" />
                <div class="d-flex shadow-sm" style="border: 1px solid #e2e8f0; border-radius: 20px; overflow: hidden;">
                    <button type="button" class="btn border-0 @(DateFilter == "Semua" ? "fw-bold" : "text-muted") px-4 py-2" style="background-color: @(DateFilter == "Semua" ? "#072C4C" : "white"); color: @(DateFilter == "Semua" ? "white" : "inherit"); border-radius: 0;" @onclick='() => SetDateFilter("Semua")'>Semua acara</button>
                    <button type="button" class="btn border-0 @(DateFilter == "Hari ini" ? "fw-bold" : "text-muted") px-4 py-2" style="background-color: @(DateFilter == "Hari ini" ? "#072C4C" : "white"); color: @(DateFilter == "Hari ini" ? "white" : "inherit"); border-radius: 0; border-left: 1px solid #e2e8f0;" @onclick='() => SetDateFilter("Hari ini")'>Hari ini</button>
                    <button type="button" class="btn border-0 @(DateFilter == "Minggu ini" ? "fw-bold" : "text-muted") px-4 py-2" style="background-color: @(DateFilter == "Minggu ini" ? "#072C4C" : "white"); color: @(DateFilter == "Minggu ini" ? "white" : "inherit"); border-radius: 0; border-left: 1px solid #e2e8f0;" @onclick='() => SetDateFilter("Minggu ini")'>Minggu ini</button>
                </div>
                <button type="button" class="btn fw-bold px-4 py-2 ms-auto shadow-sm rounded-pill" style="background-color: #E31E24; color: white; white-space: nowrap;" @onclick='() => ActiveMenu = "form_acara"'>Ajukan acara baru</button>
            </div>

            <div class="d-flex gap-4 mb-3" style="font-size: 0.85rem; color: #64748b;">
                <span class="d-flex align-items-center"><span style="width:6px;height:6px;background:#E31E24;display:inline-block;margin-right:6px;"></span> Belum ditugaskan</span>
                <span class="d-flex align-items-center"><span style="width:6px;height:6px;background:#eab308;display:inline-block;margin-right:6px;"></span> Ditugaskan, belum sign</span>
                <span class="d-flex align-items-center"><span style="width:6px;height:6px;background:#005CA9;display:inline-block;margin-right:6px;"></span> Dikonfirmasi (sign)</span>
                <span class="d-flex align-items-center"><span style="width:6px;height:6px;background:#475569;display:inline-block;margin-right:6px;"></span> Dokumen diunggah</span>
                <span class="d-flex align-items-center"><span style="width:6px;height:6px;background:#10b981;display:inline-block;margin-right:6px;"></span> Selesai</span>
            </div>

            <!-- Table -->
            <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
                <div class="table-responsive">
                    <table class="table align-middle m-0" style="table-layout: fixed; width: 100%;">
                        <thead>
                            <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; border-bottom: 2px solid #e2e8f0; background: #f8fafc;">
                                <th class="border-0 py-3 ps-4" style="width: 28%; white-space: nowrap;">NAMA ACARA</th>
                                <th class="border-0 py-3" style="width: 18%; white-space: nowrap;">JADWAL</th>
                                <th class="border-0 py-3" style="width: 16%; white-space: nowrap;">DIAJUKAN OLEH</th>
                                <th class="border-0 py-3" style="width: 22%; white-space: nowrap;">STATUS</th>
                                <th class="border-0 py-3 text-center pe-4" style="width: 16%; white-space: nowrap;">AKSI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eventItem in ActiveEvents)
                            {
                                if (!IsDateMatch(eventItem.Tanggal)) continue;

                                var matchFilter = string.IsNullOrEmpty(SearchFilter) || 
                                    eventItem.NamaAcara.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                                    eventItem.Lokasi.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase);

                                if (!matchFilter) continue;

                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td class="py-4 ps-4">
                                        <div class="fw-bold" style="color: #0f172a; font-size: 0.95rem;">@eventItem.NamaAcara</div>
                                        <div class="text-muted" style="font-size: 0.85rem;">@eventItem.Lokasi</div>
                                    </td>
                                    <td class="py-4">
                                        <div style="color: #64748b; font-size: 0.9rem;">@eventItem.Tanggal.ToString("dd MMM yyyy")</div>
                                        <div style="color: #64748b; font-size: 0.9rem;">@eventItem.JamMulai.ToString(@"hh\:mm")-@eventItem.JamSelesai.ToString(@"hh\:mm")</div>
                                    </td>
                                    <td class="py-4">
                                        <div style="color: #64748b; font-size: 0.9rem;">Anda</div>
                                    </td>
                                    <td class="py-4">
                                        @if (eventItem.StatusAcara == "Belum Ditugaskan") { 
                                            <span style="display:inline-flex; align-items:center; background-color: #fee2e2; color: #dc2626; padding: 0.3rem 0.8rem; font-size: 0.8rem; font-weight: 600; border: 1px solid #fca5a5; border-radius: 20px;">
                                                Belum ditugaskan
                                            </span> 
                                        }
                                        else if (eventItem.StatusAcara == "Ditugaskan") { 
                                            <span style="display:inline-flex; align-items:center; background-color: #fef9c3; color: #ca8a04; padding: 0.3rem 0.8rem; font-size: 0.8rem; font-weight: 600; border: 1px solid #fde047; border-radius: 20px;">
                                                Ditugaskan, belum sign
                                            </span> 
                                        }
                                        else if (eventItem.StatusAcara == "Dikonfirmasi") { 
                                            <span style="display:inline-flex; align-items:center; background-color: #e0f2fe; color: #0284c7; padding: 0.3rem 0.8rem; font-size: 0.8rem; font-weight: 600; border: 1px solid #7dd3fc; border-radius: 20px;">
                                                Dikonfirmasi (sign)
                                            </span> 
                                        }
                                        else if (eventItem.StatusAcara == "Dokumen Diunggah") { 
                                            <span style="display:inline-flex; align-items:center; background-color: #f1f5f9; color: #475569; padding: 0.3rem 0.8rem; font-size: 0.8rem; font-weight: 600; border: 1px solid #cbd5e1; border-radius: 20px;">
                                                Dokumen diunggah
                                            </span> 
                                        }
                                        else { 
                                            <span style="display:inline-flex; align-items:center; background-color: #dcfce7; color: #16a34a; padding: 0.3rem 0.8rem; font-size: 0.8rem; font-weight: 600; border: 1px solid #86efac; border-radius: 20px;">
                                                <span style="width:6px;height:6px;border-radius:50%;background:#16a34a;display:inline-block;margin-right:6px;"></span> Selesai
                                            </span> 
                                        }
                                    </td>
                                    <td class="py-4 text-center pe-4">
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-4 fw-bold" @onclick='() => OpenEditModal(eventItem)'>Edit kebutuhan</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3" style="border-top: 1px solid #e2e8f0; background: #f8fafc;">
                    <div style="color: #64748b; font-size: 0.85rem; font-weight: 500;">Menampilkan @ActiveEvents.Count dari @ActiveEvents.Count acara</div>
                    <div style="background-color: #072C4C; color: white; width: 32px; height: 32px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 600; box-shadow: 0 2px 4px rgba(7,44,76,0.2);">1</div>
                </div>
            </div>
        }
        else if (ActiveMenu == "semua_acara")
        {
            <div class="d-flex align-items-center gap-2 mb-4">
                <div style="width: 6px; height: 24px; background: var(--pertamina-red); border-radius: 4px;"></div>
                <h4 class="m-0 fw-bold" style="color: #072C4C; font-family: 'Outfit';">Support Acara</h4>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex gap-3 mb-4">
                    <input type="text" class="form-control bg-light border-0" placeholder="Cari nama acara atau lokasi..." style="border-radius: 8px;" @bind="SearchFilter" @bind:event="oninput" />
                    <button class="btn btn-danger fw-bold px-4 rounded-3" style="white-space: nowrap;" @onclick='() => ActiveMenu = "form_acara"'>+ Ajukan Acara Baru</button>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle" style="table-layout: fixed; width: 100%;">
                        <thead style="background-color: #F8FAFC;">
                            <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em;">
                                <th class="border-0 py-3 ps-4" style="width: 26%; border-top-left-radius: 8px; border-bottom-left-radius: 8px; white-space: nowrap;">NAMA ACARA</th>
                                <th class="border-0 py-3" style="width: 16%; white-space: nowrap;">TANGGAL &amp; JAM</th>
                                <th class="border-0 py-3" style="width: 18%; white-space: nowrap;">LOKASI</th>
                                <th class="border-0 py-3" style="width: 16%; white-space: nowrap;">DIAJUKAN OLEH</th>
                                <th class="border-0 py-3" style="width: 18%; white-space: nowrap;">STATUS</th>
                                <th class="border-0 py-3 text-end pe-4" style="width: 6%; border-top-right-radius: 8px; border-bottom-right-radius: 8px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in AllSupportAcara)
                            {
                                var matchFilter = string.IsNullOrEmpty(SearchFilter) || 
                                    ev.NamaAcara.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                                    ev.Lokasi.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase);

                                if (!matchFilter) continue;
                                
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td class="fw-bold py-4 ps-4" style="color: #072C4C; font-size: 0.95rem;">@ev.NamaAcara</td>
                                    <td class="text-muted py-4" style="font-size: 0.9rem;">@ev.Tanggal.ToString("dd MMM yyyy") · @ev.JamMulai.ToString(@"hh\.mm")-@ev.JamSelesai.ToString(@"hh\.mm")</td>
                                    <td class="text-muted py-4" style="font-size: 0.9rem;">@ev.Lokasi</td>
                                    <td class="text-muted py-4" style="font-size: 0.9rem;">@(ev.Helpdesk?.Username ?? "Helpdesk")</td>
                                    <td class="py-4">
                                        @if (ev.StatusAcara == "Belum Ditugaskan") { <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2" style="font-weight: 700;">Belum Ditugaskan</span> }
                                        else if (ev.StatusAcara == "Ditugaskan") { <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2" style="font-weight: 700;">Ditugaskan</span> }
                                        else if (ev.StatusAcara == "Dikonfirmasi") { <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2" style="font-weight: 700;">Dikonfirmasi</span> }
                                        else if (ev.StatusAcara == "Dokumen Diunggah") { <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2" style="font-weight: 700;">Dok. Diunggah</span> }
                                        else { <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2" style="font-weight: 700;">Selesai</span> }
                                    </td>
                                    <td class="text-end py-4 pe-4">
                                        <button class="btn btn-sm fw-bold rounded-pill px-4" style="border: 1px solid #e2e8f0; color: #072C4C; background: white; font-size: 0.85rem;" @onclick='() => OpenEditModal(ev)'>@(ev.StatusAcara == "Selesai" ? "Lihat" : "Edit")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (ActiveMenu == "form_acara")
        {
            <div class="premium-card mb-4">
                <div class="card-header-accent"></div>
                <div class="p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="text-primary"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg></span>
                        <h3 class="m-0" style="color: var(--pertamina-blue);">Input Acara & Kebutuhan</h3>
                    </div>
                    <p class="text-muted">Masukkan data acara secara manual beserta detail kebutuhan logistik IT.</p>
                    
                    <EditForm Model="NewEvent" OnValidSubmit="HandleSubmitEvent">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Nama Acara / Kegiatan</label>
                                <input type="text" class="form-control premium-input" @bind="NewEvent.NamaAcara" placeholder="Contoh: Rapat Pleno Dekan" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Lokasi Ruangan</label>
                                <input type="text" class="form-control premium-input" @bind="NewEvent.Lokasi" placeholder="Contoh: Gedung A Lt.2" required />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark">Tanggal</label>
                                <input type="date" class="form-control premium-input" @bind="NewEventDate" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark">Waktu Mulai</label>
                                <input type="time" class="form-control premium-input" @bind="NewEventStart" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark">Estimasi Selesai</label>
                                <input type="time" class="form-control premium-input" @bind="NewEventEnd" required />
                            </div>
                        </div>

                        <div class="border-top pt-3 mb-3">
                            <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-between" style="color: var(--pertamina-blue);">
                                <span class="d-flex align-items-center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg> Kebutuhan Support IT</span>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="AddNeedInputRow">+ Tambah</button>
                            </h5>
                            @if (NewNeedsList.Count == 0)
                            {
                                <div class="text-center py-3 text-muted border rounded bg-light">Belum ada kebutuhan. Klik + Tambah.</div>
                            }
                            else
                            {
                                @for (int i = 0; i < NewNeedsList.Count; i++)
                                {
                                    var index = i;
                                    <div class="row g-2 mb-2 align-items-center">
                                        <div class="col-5">
                                            <select class="form-select premium-input py-2" @bind="NewNeedsList[index].JenisKebutuhan">
                                                <option value="Proyektor">Proyektor</option>
                                                <option value="Sound System">Sound System</option>
                                                <option value="Layar / Screen">Layar / Screen</option>
                                                <option value="Multimedia Laptop">Multimedia Laptop</option>
                                                <option value="Kabel Roll &amp; Kelistrikan">Kabel &amp; Listrik</option>
                                                <option value="Lainnya">Lainnya</option>
                                            </select>
                                        </div>
                                        <div class="col-3">
                                            <input type="number" class="form-control premium-input py-2" @bind="NewNeedsList[index].Jumlah" min="1" placeholder="Qty" />
                                        </div>
                                        <div class="col-3">
                                            <input type="text" class="form-control premium-input py-2" @bind="NewNeedsList[index].Keterangan" placeholder="Ket" />
                                        </div>
                                        <div class="col-1 text-end">
                                            <button type="button" class="btn btn-link text-danger p-0" @onclick="() => RemoveNeedInputRow(index)">❌</button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary w-25 py-3 fw-bold rounded-3" @onclick='() => ActiveMenu = "semua_acara"'>
                                Batal
                            </button>
                            <button type="submit" class="btn btn-danger w-75 py-3 fw-bold rounded-3" style="font-family: 'Outfit'; font-size: 1.05rem;">
                                💾 Ajukan Acara Baru
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
        else if (ActiveMenu == "master")
        {
            <div class="d-flex align-items-center gap-2 mb-4">
                <div style="width: 6px; height: 24px; background: var(--pertamina-red); border-radius: 4px;"></div>
                <h4 class="m-0 fw-bold text-dark">Kebutuhan Acara</h4>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <div class="d-flex gap-3 mb-4">
                    <input type="text" class="form-control bg-light border-0" placeholder="Cari berdasarkan nama acara..." style="border-radius: 8px;" @bind="SearchFilter" @bind:event="oninput" />
                    <button class="btn btn-danger fw-bold px-4 rounded-3" style="white-space: nowrap;">+ Tambah Kebutuhan</button>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var ev in ActiveEvents)
                    {
                        var matchFilter = string.IsNullOrEmpty(SearchFilter) || 
                            ev.NamaAcara.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase);

                        if (!matchFilter) continue;

                        <div class="border rounded-3 p-4">
                            <h6 class="fw-bold mb-3 text-dark fs-5">@ev.NamaAcara</h6>
                            <div class="d-flex gap-2 flex-wrap">
                                @foreach (var keb in ev.Kebutuhan)
                                {
                                    <span class="badge bg-light text-dark border px-3 py-2 fw-normal fs-6" style="border-radius: 6px;">@keb.JenisKebutuhan &times;@keb.Jumlah</span>
                                }
                                @if (ev.Kebutuhan.Count == 0)
                                {
                                    <span class="badge bg-light text-muted border px-3 py-2 fw-normal fs-6" style="border-radius: 6px;">Layar &times;1</span>
                                    <span class="badge bg-light text-muted border px-3 py-2 fw-normal fs-6" style="border-radius: 6px;">Multimedia &times;2</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (ActiveMenu == "mapping")
        {
            <div class="d-flex align-items-center gap-2 mb-4">
                <div style="width: 6px; height: 24px; background: var(--pertamina-red); border-radius: 4px;"></div>
                <h4 class="m-0 fw-bold text-dark">Mapping Teknisi</h4>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <div class="mb-4">
                    <input type="text" class="form-control bg-light border-0" placeholder="Cari nama teknisi atau spesialisasi..." style="border-radius: 8px;" />
                </div>

                <div class="table-responsive">
                    <table class="table align-middle m-0" style="table-layout: fixed; width: 100%;">
                        <thead>
                            <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; border-bottom: 2px solid #e2e8f0; background: #f8fafc;">
                                <th class="border-0 py-3 ps-4" style="width: 25%; border-top-left-radius: 8px; border-bottom-left-radius: 8px; white-space: nowrap;">NAMA TEKNISI</th>
                                <th class="border-0 py-3" style="width: 30%; white-space: nowrap;">SPESIALISASI</th>
                                <th class="border-0 py-3" style="width: 15%; white-space: nowrap;">TUGAS AKTIF</th>
                                <th class="border-0 py-3" style="width: 20%; white-space: nowrap;">STATUS</th>
                                <th class="border-0 py-3 text-center pe-4" style="width: 10%; border-top-right-radius: 8px; border-bottom-right-radius: 8px; white-space: nowrap;">AKSI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tek in Technicians)
                            {
                                var activeTasks = GetAssignmentsForTechnician(tek.IdTeknisi).Count;
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td class="fw-bold py-4 ps-4 text-dark" style="font-size: 0.95rem;">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm" style="width: 38px; height: 38px; background: linear-gradient(135deg, #005CA9, #063d6b); font-size: 0.9rem;">
                                                @((tek.User?.Username ?? "T")[0].ToString().ToUpper())
                                            </div>
                                            <span>@tek.User?.Username</span>
                                        </div>
                                    </td>
                                    <td class="text-muted py-4" style="font-size: 0.9rem;">@tek.Spesialisasi</td>
                                    <td class="text-muted py-4" style="font-size: 0.9rem;">
                                        @if(activeTasks > 0)
                                        {
                                            <span class="fw-bold" style="color: #0284c7;">@activeTasks Acara</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="py-4">
                                        @if (tek.StatusKetersediaan == "Tersedia")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-bold" style="font-size: 0.8rem;">Tersedia (Siap)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2 fw-bold" style="font-size: 0.8rem;">Sedang Bertugas</span>
                                        }
                                    </td>
                                    <td class="text-center py-4 pe-4">
                                        <button class="btn btn-sm rounded-pill px-3 fw-bold" style="border: 1px solid #e2e8f0; color: #072C4C; background: white; font-size: 0.85rem;" title="Edit Spesialisasi">Edit</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (ActiveMenu == "penugasan")
        {
            <div class="d-flex align-items-center gap-2 mb-4">
                <div style="width: 6px; height: 24px; background: var(--pertamina-red); border-radius: 4px;"></div>
                <h4 class="m-0 fw-bold text-dark">Penugasan Teknisi</h4>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <div class="dash-status-legend mb-4">
                    <span><span class="dash-status-dot dot-red"></span> Belum ditugaskan</span>
                    <span><span class="dash-status-dot dot-yellow"></span> Ditugaskan, belum sign</span>
                    <span><span class="dash-status-dot dot-green"></span> Dikonfirmasi (sign)</span>
                    <span><span class="dash-status-dot dot-blue" style="background: var(--pertamina-blue);"></span> Dok. diunggah</span>
                    <span><span class="dash-status-dot dot-gray"></span> Selesai</span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle" style="table-layout: fixed; width: 100%;">
                        <thead>
                            <tr class="text-muted small">
                                <th class="border-0 pb-3" style="width: 35%;">ACARA</th>
                                <th class="border-0 pb-3" style="width: 25%;">TEKNISI</th>
                                <th class="border-0 pb-3" style="width: 20%;">STATUS</th>
                                <th class="border-0 pb-3" style="width: 20%;">WAKTU KONFIRMASI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in AllSupportAcara)
                            {
                                var assignment = GetAssignmentForEvent(ev.IdAcara);
                                <tr>
                                    <td class="fw-bold py-3 text-dark">@ev.NamaAcara</td>
                                    <td class="text-muted py-3">@(assignment?.Teknisi?.User?.Username ?? "—")</td>
                                    <td class="py-3">
                                        @if (ev.StatusAcara == "Belum Ditugaskan") { <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-bold">Belum Ditugaskan</span> }
                                        else if (ev.StatusAcara == "Ditugaskan") { <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2 fw-bold">Belum Sign</span> }
                                        else if (ev.StatusAcara == "Dikonfirmasi") { <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-bold">Dikonfirmasi</span> }
                                        else if (ev.StatusAcara == "Dokumen Diunggah") { <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-bold">Dok. Diunggah</span> }
                                        else { <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-bold">Selesai</span> }
                                    </td>
                                    <td class="text-muted py-3">
                                        @if (ev.StatusAcara == "Belum Ditugaskan" || ev.StatusAcara == "Ditugaskan") { <span>—</span> }
                                        else if (ev.StatusAcara == "Selesai") { <span>Ditandai otomatis</span> }
                                        else { <span>@(assignment?.WaktuKonfirmasi?.ToString("dd Jul, HH.mm") ?? "12 Jul, 10.20")</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    <!-- ============================================== -->
    <!-- ADMIN VIEWS (Fallback to Unified List)         -->
    <!-- ============================================== -->
    @if (CurrentRole == "Admin" && ActiveMenu == "dashboard")
    {
        <h3 class="dash-section-title">Daftar Acara</h3>

        <!-- Filter Bar -->
        <div class="dash-filter-bar">
            <input type="text" class="dash-filter-search" placeholder="Cari nama acara, lokasi, atau teknisi..." @bind="SearchFilter" @bind:event="oninput" />
            <button type="button" class="dash-filter-btn @(DateFilter == "Semua" ? "filter-active" : "")" @onclick='() => SetDateFilter("Semua")'>Semua</button>
            <button type="button" class="dash-filter-btn @(DateFilter == "Hari ini" ? "filter-active" : "")" @onclick='() => SetDateFilter("Hari ini")'>Hari ini</button>
            <button type="button" class="dash-filter-btn @(DateFilter == "Minggu ini" ? "filter-active" : "")" @onclick='() => SetDateFilter("Minggu ini")'>Minggu ini</button>
        </div>

        <!-- Status Legend -->
        <div class="dash-status-legend">
            <span><span class="dash-status-dot dot-red"></span> Belum ditugaskan</span>
            <span><span class="dash-status-dot dot-yellow"></span> Ditugaskan, belum sign</span>
            <span><span class="dash-status-dot dot-green"></span> Dikonfirmasi (sign)</span>
            <span><span class="dash-status-dot dot-blue" style="background: var(--pertamina-blue);"></span> Dokumentasi diunggah</span>
            <span><span class="dash-status-dot dot-gray"></span> Selesai</span>
        </div>

        @if (ActiveEvents.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <span class="fs-1 d-block mb-3">📭</span>
                <h5>Belum ada acara terdaftar</h5>
                <p>Silakan input data acara baru atau tunggu helpdesk menambahkan acara.</p>
            </div>
        }
        else
        {
            @foreach (var eventItem in ActiveEvents)
            {
                if (!IsDateMatch(eventItem.Tanggal)) continue;

                var assignment = GetAssignmentForEvent(eventItem.IdAcara);
                var matchFilter = string.IsNullOrEmpty(SearchFilter) || 
                    eventItem.NamaAcara.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                    eventItem.Lokasi.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase);

                if (!matchFilter) continue;

                <div class="dash-event-item">
                    <div class="dash-event-info">
                        <div class="dash-event-name">@eventItem.NamaAcara</div>
                        <div class="dash-event-meta">
                            <span class="dash-event-meta-item">📅 @eventItem.Tanggal.ToString("dd MMM yyyy") · @eventItem.JamMulai.ToString(@"hh\:mm")-@eventItem.JamSelesai.ToString(@"hh\:mm")</span>
                            <span class="dash-event-meta-item">📍 @eventItem.Lokasi</span>
                        </div>
                        <div class="dash-event-tags">
                            @foreach (var need in eventItem.Kebutuhan)
                            {
                                <span class="dash-event-tag">@need.JenisKebutuhan</span>
                            }
                        </div>
                    </div>
                    <div class="dash-event-actions">
                        @if (eventItem.StatusAcara == "Belum Ditugaskan")
                        {
                            <span class="dash-btn-status st-pending">Belum Ditugaskan</span>
                            <button class="dash-btn-action btn-assign" @onclick="() => OpenAssignModal(eventItem)">+ Tugaskan Teknisi</button>
                        }
                        else if (eventItem.StatusAcara == "Ditugaskan")
                        {
                            <span class="dash-btn-status st-waiting">Ditugaskan</span>
                        }
                        else if (eventItem.StatusAcara == "Dikonfirmasi")
                        {
                            <span class="dash-btn-status st-confirmed">Dikonfirmasi</span>
                        }
                        else if (eventItem.StatusAcara == "Dokumen Diunggah" && assignment != null)
                        {
                            <span class="dash-btn-status st-uploaded">Dok. Diunggah</span>
                            <button class="dash-btn-action btn-detail" @onclick="() => PreviewDocumentation(assignment)">🔍 Lihat Foto</button>
                            <button class="dash-btn-action btn-assign" @onclick="() => CompleteEvent(eventItem)">✅ Selesaikan</button>
                        }
                    </div>
                </div>
            }
        }

        <!-- Completed Events (shown inline if any) -->
        @if (HistoryEvents.Count > 0)
        {
            @foreach (var hist in HistoryEvents.Take(3))
            {
                <div class="dash-event-item" style="opacity:0.7;">
                    <div class="dash-event-info">
                        <div class="dash-event-name">@hist.NamaAcara</div>
                        <div class="dash-event-meta">
                            <span class="dash-event-meta-item">📅 @hist.TanggalAcara.ToString("dd MMM yyyy")</span>
                            <span class="dash-event-meta-item">👤 @hist.NamaTeknisi</span>
                        </div>
                    </div>
                    <div class="dash-event-actions">
                        <span class="dash-btn-status st-done">Selesai</span>
                        <span class="dash-btn-action btn-history" style="cursor:default;">Lihat Riwayat</span>
                    </div>
                </div>
            }
        }
    }
    else if (CurrentRole == "Teknisi")
    {
        <TeknisiDashboard 
