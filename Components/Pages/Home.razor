                                <label class="form-label fw-bold text-dark" style="font-size: 0.85rem;">Tanggal</label>
                                <input type="date" max="@(DateTime.Now.Year)-12-31" class="form-control form-input-premium" @bind="NewEventDate" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark" style="font-size: 0.85rem;">Waktu Mulai</label>
                                <input type="time" class="form-control form-input-premium" @bind="NewEventStart" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark" style="font-size: 0.85rem;">Estimasi Selesai</label>
