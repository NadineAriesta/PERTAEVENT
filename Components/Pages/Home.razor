    private async Task HandleSubmitEvent()
    {
        try
        {
            // Parse times
            NewEvent.JamMulai = NewEventStart.ToTimeSpan();
            NewEvent.JamSelesai = NewEventEnd.ToTimeSpan();
            NewEvent.Tanggal = NewEventDate;
            NewEvent.IdUserHelpdesk = LoggedInUser?.IdUser ?? 2;
            NewEvent.StatusAcara = "Belum Ditugaskan";

            // Add needs
            foreach (var need in NewNeedsList)
            {
                NewEvent.Kebutuhan.Add(new KebutuhanAcara
                {
                    JenisKebutuhan = need.JenisKebutuhan,
                    Jumlah = need.Jumlah,
                    Keterangan = need.Keterangan
                });
            }

            DbContext.SupportAcara.Add(NewEvent);
            await DbContext.SaveChangesAsync();

            ShowNotificationWithTimer($"Acara '{NewEvent.NamaAcara}' berhasil disimpan.");
            
            // Reset form
            NewEvent = new SupportAcara();
            NewEventDate = DateTime.Today;
            NewEventStart = new TimeOnly(8, 0);
            NewEventEnd = new TimeOnly(17, 0);
            NewNeedsList = new List<KebutuhanAcara>
            {
                new KebutuhanAcara { JenisKebutuhan = "Proyektor", Jumlah = 1, Keterangan = "Layar utama" },
                new KebutuhanAcara { JenisKebutuhan = "Sound System", Jumlah = 1, Keterangan = "Wireless mic 2 buah" }
