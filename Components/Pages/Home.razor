            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0" style="border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); overflow: hidden;">
                    <div class="modal-header" style="background: #fafafa; border-bottom: 1px solid #f1f5f9; padding: 1.25rem 1.5rem;">
