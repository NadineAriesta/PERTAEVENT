                </div>

                <div class="table-responsive">
                    <table class="table align-middle" style="width: 100%;">
                        <thead style="background-color: #F8FAFC;">
                            <tr class="text-muted" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em;">
                                <th class="border-0 py-2 ps-3" style="width: 24%; border-top-left-radius: 8px; border-bottom-left-radius: 8px; ">NAMA ACARA</th>
                                <th class="border-0 py-2" style="width: 16%; ">TANGGAL &amp; JAM</th>
                                <th class="border-0 py-2" style="width: 16%; ">LOKASI</th>
                                <th class="border-0 py-2" style="width: 16%; ">DIAJUKAN OLEH</th>
                                <th class="border-0 py-2" style="width: 12%; ">STATUS</th>
                                <th class="border-0 py-2 text-start" style="width: 16%; border-top-right-radius: 8px; border-bottom-right-radius: 8px; padding-left: 2rem;">AKSI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in AllSupportAcara)
                            {
                                var matchFilter = string.IsNullOrEmpty(SearchFilter) || 
                                    ev.NamaAcara.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                                    (ev.LokasiNavigation?.NamaLokasi?.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ?? false);

                                if (!matchFilter) continue;
                                
                                <tr style="border-bottom: 1px solid #f1f5f9; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#f8fafc'" onmouseout="this.style.backgroundColor='transparent'">
                                    <td class="fw-bold py-2 ps-3" style="color: #072C4C; font-size: 0.95rem;">@ev.NamaAcara</td>
                                    <td class="text-muted py-2" style="font-size: 0.9rem;">@ev.Tanggal.ToString("dd MMM yyyy") &middot; @ev.JamMulai.ToString(@"hh\:mm")-@ev.JamSelesai.ToString(@"hh\:mm")</td>
                                    <td class="text-muted py-2" style="font-size: 0.9rem;">@ev.LokasiNavigation?.NamaLokasi</td>
